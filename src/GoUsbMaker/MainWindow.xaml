<Window x:Class="GoConsoleOS.GoUsbMaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GoUSB Maker — Install GoConsoleOS"
        Width="1000" Height="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBackgroundDark}"
        Foreground="{StaticResource BrushTextPrimary}"
        FontFamily="Segoe UI, Helvetica Neue, Arial, sans-serif">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="GOUSB MAKER" FontSize="30" FontWeight="Bold"
                       Foreground="{StaticResource BrushTextPrimary}" />
            <Border CornerRadius="4" Background="{StaticResource BrushBackgroundCard}" Padding="8,3"
                    VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock x:Name="VersionText" Text="" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource BrushAccentSecondary}" />
            </Border>
        </StackPanel>
        <TextBlock Grid.Row="1" x:Name="MakerStatus" Text="Turn any USB drive into a portable GoConsoleOS console"
                   FontSize="14" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,20" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}"
                    Padding="20" Margin="0,0,12,0">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="CONNECTED USB DRIVES" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" />
                        <Border CornerRadius="6" Background="{StaticResource BrushBackgroundCard}" Padding="12,6"
                                Cursor="Hand" MouseLeftButtonDown="RefreshDrives_Click" HorizontalAlignment="Right">
                            <TextBlock Text="REFRESH" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" />
                        </Border>
                    </Grid>
                    <CheckBox x:Name="ShowInternalToggle" Content="Show internal disks (danger — wipes the drive)"
                              Foreground="{StaticResource BrushTextSecondary}" FontSize="11"
                              Checked="ShowInternal_Changed" Unchecked="ShowInternal_Changed" Margin="0,0,0,10" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="460">
                        <ItemsControl x:Name="DriveList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10"
                                            Background="{StaticResource BrushBackgroundCard}"
                                            Padding="14,12" Margin="0,0,0,10" Cursor="Hand"
                                            MouseLeftButtonDown="SelectDrive" Tag="{Binding}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#4CAF50" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Letter}" FontSize="18" FontWeight="Bold"
                                                           Foreground="{StaticResource BrushAccentPrimary}"
                                                           Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="Bold"
                                                           Foreground="{StaticResource BrushTextPrimary}"
                                                           VerticalAlignment="Center" />
                                                <Border CornerRadius="4" Background="#2A2A44" Padding="6,2"
                                                        Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Type}" FontSize="10" FontWeight="Bold"
                                                               Foreground="{Binding TypeBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Detail}" FontSize="12"
                                                       Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding State}" FontSize="12" FontWeight="Bold"
                                                       Foreground="{Binding StateBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}" Padding="20">
                <StackPanel>
                    <TextBlock Text="INSTALL" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,12" />
                    <TextBlock Text="Installs the GoConsoleOS files sitting next to this tool onto the selected USB drive. The drive is renamed GoConsoleOS, gets a boot config, and launches automatically on plug-in."
                               FontSize="13" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,0,0,16" />

                    <Border CornerRadius="8" Background="{StaticResource BrushBackgroundCard}" Padding="14,10" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="SOURCE" FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                            <TextBlock x:Name="SourceText" Text="" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="8" Background="{StaticResource BrushBackgroundCard}" Padding="14,10" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="SELECTED DRIVE" FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                            <TextBlock x:Name="SelectedDriveText" Text="None — choose a USB drive from the list" FontSize="15"
                                       Foreground="{StaticResource BrushTextPrimary}" FontWeight="Bold" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="InstallBtn" Content="CREATE GAMING CONSOLE" FontSize="14" FontWeight="Bold"
                            Background="{StaticResource BrushAccentPrimary}" Foreground="#0D0D14"
                            BorderThickness="0" Padding="20,10" HorizontalAlignment="Left"
                            Cursor="Hand" Click="InstallClick" IsEnabled="False" />

                    <ProgressBar x:Name="InstallProgress" Height="4" Margin="0,14,0,0" Maximum="100" Value="0"
                                 Foreground="{StaticResource BrushAccentPrimary}"
                                 Background="{StaticResource BrushBackgroundCard}" BorderThickness="0"
                                 Visibility="Collapsed" />
                    <TextBlock x:Name="InstallStatus" FontSize="12" Foreground="{StaticResource BrushTextMuted}"
                               TextWrapping="Wrap" Margin="0,8,0,0" />

                    <TextBlock Text="WARNING: All existing data on the target drive will be erased."
                               FontSize="11" Foreground="{StaticResource BrushError}" Margin="0,16,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
