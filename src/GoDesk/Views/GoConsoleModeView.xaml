<UserControl x:Class="GoDesk.Views.GoConsoleModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24">
        <StackPanel MaxWidth="900">
            <TextBlock Text="GoConsole Mode" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Error}"/>
            <TextBlock Text="Launch GoConsoleOS in full-screen console mode" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,20"/>

            <!-- Launch Button -->
            <Border CornerRadius="16" Background="{StaticResource BgCard}" Padding="32" Margin="0,0,0,24">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="GoConsoleOS" FontSize="32" FontWeight="Bold" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Full-screen USB Gaming Console" FontSize="14" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,16"/>
                    <Border CornerRadius="10" Padding="24,12" Background="{StaticResource Accent}" Cursor="Hand" HorizontalAlignment="Center" MouseLeftButtonDown="LaunchGoConsole">
                        <TextBlock Text="LAUNCH GOCOMSOLE" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Features -->
            <TextBlock Text="FEATURES" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>
            <WrapPanel Margin="0,0,0,24">
                <Border CornerRadius="12" Width="200" Height="80" Background="{StaticResource BgCard}" Margin="0,0,8,8" Padding="14">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Dashboard" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="Quick access to games and apps" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="12" Width="200" Height="80" Background="{StaticResource BgCard}" Margin="0,0,8,8" Padding="14">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="10 Games" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Success}"/>
                        <TextBlock Text="Built-in HTML5 game library" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="12" Width="200" Height="80" Background="{StaticResource BgCard}" Margin="0,0,8,8" Padding="14">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Discord" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Warning}"/>
                        <TextBlock Text="Voice chat and bot integration" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="12" Width="200" Height="80" Background="{StaticResource BgCard}" Margin="0,0,8,8" Padding="14">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Voice AI" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Error}"/>
                        <TextBlock Text="GoAI voice assistant built-in" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="12" Width="200" Height="80" Background="{StaticResource BgCard}" Margin="0,0,8,8" Padding="14">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Controller" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                        <TextBlock Text="Full Xbox controller support" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="12" Width="200" Height="80" Background="{StaticResource BgCard}" Margin="0,0,8,8" Padding="14">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Lock Screen" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Success}"/>
                        <TextBlock Text="Secure Windows 11-style login" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Quick Settings -->
            <TextBlock Text="QUICK SETTINGS" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>
            <Border CornerRadius="12" Background="{StaticResource BgCard}" Padding="20">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Discord Integration" FontSize="13" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        <CheckBox x:Name="DiscordCheck" IsChecked="True" HorizontalAlignment="Right" Foreground="{StaticResource Accent}"/>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="Voice Chat" FontSize="13" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        <CheckBox x:Name="VoiceCheck" IsChecked="True" HorizontalAlignment="Right" Foreground="{StaticResource Accent}"/>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="GoAI Assistant" FontSize="13" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        <CheckBox x:Name="AiCheck" IsChecked="True" HorizontalAlignment="Right" Foreground="{StaticResource Accent}"/>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="Controller Input" FontSize="13" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        <CheckBox x:Name="ControllerCheck" IsChecked="True" HorizontalAlignment="Right" Foreground="{StaticResource Accent}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
