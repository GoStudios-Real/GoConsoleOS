<Window x:Class="GoDesk.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:GoDesk.Views"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GoDesk"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="52" />
        </Grid.RowDefinitions>

        <!-- Desktop Area -->
        <Grid Grid.Row="0" Background="{StaticResource BgDark}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource BgMedium}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Logo -->
                    <StackPanel Grid.Row="0" Margin="20,20,20,16">
                        <TextBlock Text="GoDesk" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                        <TextBlock Text="GoStudios Desktop" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Nav Items -->
                    <StackPanel Grid.Row="1" Margin="12,0">
                        <Border x:Name="NavHome" CornerRadius="10" Padding="14,10" Margin="0,2" Cursor="Hand" MouseLeftButtonDown="NavHome_Click" Background="{StaticResource BgLight}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="H" FontSize="16" Foreground="{StaticResource Accent}" Width="28" FontWeight="Bold"/>
                                <TextBlock Text="Home" FontSize="14" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="NavApps" CornerRadius="10" Padding="14,10" Margin="0,2" Cursor="Hand" MouseLeftButtonDown="NavApps_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="A" FontSize="16" Foreground="{StaticResource TextSecondary}" Width="28" FontWeight="Bold"/>
                                <TextBlock Text="Apps" FontSize="14" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="NavGames" CornerRadius="10" Padding="14,10" Margin="0,2" Cursor="Hand" MouseLeftButtonDown="NavGames_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="G" FontSize="16" Foreground="{StaticResource TextSecondary}" Width="28" FontWeight="Bold"/>
                                <TextBlock Text="Games" FontSize="14" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="NavGameBar" CornerRadius="10" Padding="14,10" Margin="0,2" Cursor="Hand" MouseLeftButtonDown="NavGameBar_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="B" FontSize="16" Foreground="{StaticResource TextSecondary}" Width="28" FontWeight="Bold"/>
                                <TextBlock Text="Game Bar" FontSize="14" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="NavGoConsole" CornerRadius="10" Padding="14,10" Margin="0,2" Cursor="Hand" MouseLeftButtonDown="NavGoConsole_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="C" FontSize="16" Foreground="{StaticResource TextSecondary}" Width="28" FontWeight="Bold"/>
                                <TextBlock Text="GoConsole Mode" FontSize="14" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- System Info -->
                    <StackPanel Grid.Row="2" Margin="20,0,20,16">
                        <Border CornerRadius="10" Padding="12" Background="{StaticResource BgLight}">
                            <StackPanel>
                                <TextBlock x:Name="SystemTime" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock x:Name="SystemDate" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content -->
            <ContentControl x:Name="MainContent" Grid.Column="1">
                <local:HomeView />
            </ContentControl>
        </Grid>

        <!-- Taskbar -->
        <Border Grid.Row="1" Background="{StaticResource BgMedium}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Start Button -->
                <Border Grid.Column="0" CornerRadius="8" Padding="14,8" Background="{StaticResource Accent}" Cursor="Hand" MouseLeftButtonDown="StartButton_Click">
                    <TextBlock Text="GoDesk" FontSize="13" FontWeight="Bold" Foreground="White"/>
                </Border>

                <!-- Pinned Apps -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                    <Border CornerRadius="8" Padding="10,6" Margin="0,0,4,0" Cursor="Hand" MouseLeftButtonDown="TaskbarHome_Click" Background="{StaticResource BgLight}">
                        <TextBlock Text="Home" FontSize="12" Foreground="{StaticResource TextPrimary}"/>
                    </Border>
                    <Border CornerRadius="8" Padding="10,6" Margin="0,0,4,0" Cursor="Hand" MouseLeftButtonDown="TaskbarApps_Click" Background="Transparent">
                        <TextBlock Text="Apps" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                    </Border>
                    <Border CornerRadius="8" Padding="10,6" Margin="0,0,4,0" Cursor="Hand" MouseLeftButtonDown="TaskbarGames_Click" Background="Transparent">
                        <TextBlock Text="Games" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                    </Border>
                    <Border CornerRadius="8" Padding="10,6" Margin="0,0,4,0" Cursor="Hand" MouseLeftButtonDown="TaskbarGameBar_Click" Background="Transparent">
                        <TextBlock Text="Game Bar" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                    </Border>
                    <Border CornerRadius="8" Padding="10,6" Cursor="Hand" MouseLeftButtonDown="TaskbarGoConsole_Click" Background="Transparent">
                        <TextBlock Text="GoConsole" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                    </Border>
                </StackPanel>

                <!-- System Tray -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TrayTime" FontSize="12" Foreground="{StaticResource TextPrimary}" Margin="12,0,0,0"/>
                    <Border CornerRadius="6" Padding="8,4" Margin="8,0,0,0" Cursor="Hand" MouseLeftButtonDown="ExitButton_Click" Background="{StaticResource Error}">
                        <TextBlock Text="X" FontSize="12" FontWeight="Bold" Foreground="White"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

