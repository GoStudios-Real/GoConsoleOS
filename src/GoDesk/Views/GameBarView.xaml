<UserControl x:Class="GoDesk.Views.GameBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24">
        <StackPanel MaxWidth="900">
            <TextBlock Text="Game Bar" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Warning}"/>
            <TextBlock Text="Performance overlay and quick actions" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,20"/>

            <!-- Performance Stats -->
            <Border CornerRadius="12" Background="{StaticResource BgCard}" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="CPU" FontSize="12" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="CpuUsage" Text="--%" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="RAM" FontSize="12" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="RamUsage" Text="--%" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Success}" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="DISK" FontSize="12" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="DiskUsage" Text="--%" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Warning}" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                        <TextBlock Text="FPS" FontSize="12" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="FpsDisplay" Text="60" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Error}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Quick Actions -->
            <TextBlock Text="QUICK ACTIONS" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>
            <WrapPanel Margin="0,0,0,16">
                <Border CornerRadius="10" Padding="14,10" Margin="0,0,8,8" Background="{StaticResource BgCard}" Cursor="Hand" MouseLeftButtonDown="ToggleWifi">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="WiFi" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="10" Padding="14,10" Margin="0,0,8,8" Background="{StaticResource BgCard}" Cursor="Hand" MouseLeftButtonDown="ToggleBluetooth">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Bluetooth" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="10" Padding="14,10" Margin="0,0,8,8" Background="{StaticResource BgCard}" Cursor="Hand" MouseLeftButtonDown="ToggleDND">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="DND" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="10" Padding="14,10" Margin="0,0,8,8" Background="{StaticResource BgCard}" Cursor="Hand" MouseLeftButtonDown="TakeScreenshot">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Screenshot" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="10" Padding="14,10" Margin="0,0,8,8" Background="{StaticResource BgCard}" Cursor="Hand" MouseLeftButtonDown="ToggleRecording">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Record" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="10" Padding="14,10" Margin="0,0,8,8" Background="{StaticResource BgCard}" Cursor="Hand" MouseLeftButtonDown="OpenTaskManager">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Task Manager" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Volume -->
            <TextBlock Text="VOLUME" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>
            <Border CornerRadius="12" Background="{StaticResource BgCard}" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Vol" FontSize="13" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Grid.Column="0"/>
                    <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="80" VerticalAlignment="Center" Margin="8,0"/>
                    <TextBlock x:Name="VolumeText" Text="80%" FontSize="13" Foreground="{StaticResource TextSecondary}" Grid.Column="2" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Brightness -->
            <TextBlock Text="BRIGHTNESS" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>
            <Border CornerRadius="12" Background="{StaticResource BgCard}" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Light" FontSize="13" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Grid.Column="0"/>
                    <Slider x:Name="BrightnessSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="100" VerticalAlignment="Center" Margin="8,0"/>
                    <TextBlock x:Name="BrightnessText" Text="100%" FontSize="13" Foreground="{StaticResource TextSecondary}" Grid.Column="2" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Network Info -->
            <TextBlock Text="NETWORK" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>
            <Border CornerRadius="12" Background="{StaticResource BgCard}" Padding="20">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Status:" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock x:Name="NetworkStatus" Text="Connected" FontSize="12" Foreground="{StaticResource Success}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <TextBlock Text="Type:" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock x:Name="NetworkType" Text="WiFi" FontSize="12" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <TextBlock Text="IP:" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock x:Name="NetworkIP" Text="192.168.1.x" FontSize="12" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
