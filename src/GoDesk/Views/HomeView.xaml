<UserControl x:Class="GoDesk.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24">
        <StackPanel MaxWidth="900">
            <TextBlock Text="Welcome to GoDesk" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
            <TextBlock Text="GoStudios Desktop Environment" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,20"/>
            <TextBlock Text="QUICK ACTIONS" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>
            <WrapPanel Margin="0,0,0,24">
                <Border CornerRadius="12" Width="140" Height="90" Background="{StaticResource BgCard}" Margin="0,0,8,8" Cursor="Hand">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Apps" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                        <TextBlock Text="All Applications" FontSize="11" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="12" Width="140" Height="90" Background="{StaticResource BgCard}" Margin="0,0,8,8" Cursor="Hand">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Games" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Success}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Game Library" FontSize="11" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="12" Width="140" Height="90" Background="{StaticResource BgCard}" Margin="0,0,8,8" Cursor="Hand">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Game Bar" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Warning}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Performance Overlay" FontSize="11" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="12" Width="140" Height="90" Background="{StaticResource BgCard}" Margin="0,0,8,8" Cursor="Hand">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Console" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Error}" HorizontalAlignment="Center"/>
                        <TextBlock Text="GoConsole Mode" FontSize="11" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
            <TextBlock Text="SYSTEM INFO" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>
            <Border CornerRadius="12" Background="{StaticResource BgCard}" Padding="20" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="GoDesk v2.3 - GoStudios Corporation" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="USB-Powered Gaming Desktop Environment" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                    <TextBlock Text="Features: App Launcher, Game Library, Game Bar, GoConsole Mode, Voice Assistant" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
