<UserControl x:Class="GoDesk.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24">
        <StackPanel MaxWidth="900">
            <TextBlock Text="Game Library" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
            <TextBlock Text="10 built-in games - click to launch" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,20"/>
            <TextBlock Text="BUILT-IN GAMES" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>
            <WrapPanel Margin="0,0,0,24">
                <Border CornerRadius="12" Width="140" Height="120" Background="{StaticResource BgCard}" Margin="0,0,8,8" Cursor="Hand" MouseLeftButtonDown="PlayPong">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Pong" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Classic" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        <Border CornerRadius="6" Background="{StaticResource BgLight}" Padding="8,2" Margin="0,6,0,0">
                            <TextBlock Text="PLAY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>
                <Border CornerRadius="12" Width="140" Height="120" Background="{StaticResource BgCard}" Margin="0,0,8,8" Cursor="Hand" MouseLeftButtonDown="PlaySnake">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Snake" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Success}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Retro" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        <Border CornerRadius="6" Background="{StaticResource BgLight}" Padding="8,2" Margin="0,6,0,0">
                            <TextBlock Text="PLAY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Success}" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>
                <Border CornerRadius="12" Width="140" Height="120" Background="{StaticResource BgCard}" Margin="0,0,8,8" Cursor="Hand" MouseLeftButtonDown="PlayTetris">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Tetris" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Warning}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Puzzle" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        <Border CornerRadius="6" Background="{StaticResource BgLight}" Padding="8,2" Margin="0,6,0,0">
                            <TextBlock Text="PLAY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Warning}" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>
                <Border CornerRadius="12" Width="140" Height="120" Background="{StaticResource BgCard}" Margin="0,0,8,8" Cursor="Hand" MouseLeftButtonDown="PlayBreakout">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Breakout" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Error}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Arkanoid" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        <Border CornerRadius="6" Background="{StaticResource BgLight}" Padding="8,2" Margin="0,6,0,0">
                            <TextBlock Text="PLAY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Error}" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>
                <Border CornerRadius="12" Width="140" Height="120" Background="{StaticResource BgCard}" Margin="0,0,8,8" Cursor="Hand" MouseLeftButtonDown="PlayMemory">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Memory" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Card Match" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        <Border CornerRadius="6" Background="{StaticResource BgLight}" Padding="8,2" Margin="0,6,0,0">
                            <TextBlock Text="PLAY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>
                <Border CornerRadius="12" Width="140" Height="120" Background="{StaticResource BgCard}" Margin="0,0,8,8" Cursor="Hand" MouseLeftButtonDown="PlayFlappyBird">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Flappy" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Success}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Bird Clone" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        <Border CornerRadius="6" Background="{StaticResource BgLight}" Padding="8,2" Margin="0,6,0,0">
                            <TextBlock Text="PLAY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Success}" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>
                <Border CornerRadius="12" Width="140" Height="120" Background="{StaticResource BgCard}" Margin="0,0,8,8" Cursor="Hand" MouseLeftButtonDown="PlayMinesweeper">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Mines" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Warning}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Sweeper" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        <Border CornerRadius="6" Background="{StaticResource BgLight}" Padding="8,2" Margin="0,6,0,0">
                            <TextBlock Text="PLAY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Warning}" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>
                <Border CornerRadius="12" Width="140" Height="120" Background="{StaticResource BgCard}" Margin="0,0,8,8" Cursor="Hand" MouseLeftButtonDown="PlaySudoku">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Sudoku" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Logic" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        <Border CornerRadius="6" Background="{StaticResource BgLight}" Padding="8,2" Margin="0,6,0,0">
                            <TextBlock Text="PLAY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>
                <Border CornerRadius="12" Width="140" Height="120" Background="{StaticResource BgCard}" Margin="0,0,8,8" Cursor="Hand" MouseLeftButtonDown="Play2048">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="2048" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Error}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Number Puzzle" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        <Border CornerRadius="6" Background="{StaticResource BgLight}" Padding="8,2" Margin="0,6,0,0">
                            <TextBlock Text="PLAY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Error}" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>
                <Border CornerRadius="12" Width="140" Height="120" Background="{StaticResource BgCard}" Margin="0,0,8,8" Cursor="Hand" MouseLeftButtonDown="PlayWhackAMole">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Whack" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Success}" HorizontalAlignment="Center"/>
                        <TextBlock Text="A Mole" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        <Border CornerRadius="6" Background="{StaticResource BgLight}" Padding="8,2" Margin="0,6,0,0">
                            <TextBlock Text="PLAY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Success}" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
