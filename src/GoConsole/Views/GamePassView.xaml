<UserControl x:Class="GoConsoleOS.GoConsole.Views.GamePassView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="GO CONSOLE GAME PASS" FontSize="28" FontWeight="Bold"
                       Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" />
            <Border CornerRadius="6" Background="{StaticResource BrushBackgroundCard}" Padding="10,4"
                    VerticalAlignment="Center" Margin="14,0,0,0">
                <TextBlock x:Name="PassStatus" Text="Loading..." FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource BrushTextSecondary}" />
            </Border>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- current subscription -->
            <Border Grid.Column="0" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}" Padding="16" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="YOUR SUBSCRIPTION" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource BrushAccentSecondary}" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ActiveTierEmoji" Text="🎮" FontSize="30" VerticalAlignment="Center" />
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock x:Name="ActiveTierName" Text="Game Pass Free" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock x:Name="ActiveTierDetails" Text="Browse the catalog and pick a plan to get started."
                                       FontSize="12" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" MaxWidth="420" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Border CornerRadius="6" Background="{StaticResource BrushBackgroundCard}" Padding="10,5">
                            <TextBlock x:Name="ActiveTierBadge" Text="FREE PLAN" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextSecondary}" />
                        </Border>
                        <TextBlock x:Name="ActiveTierExpiry" Text="" FontSize="12"
                                   Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- redeem + duration -->
            <Border Grid.Column="1" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}" Padding="16">
                <StackPanel>
                    <TextBlock Text="REDEEM A GIFT CARD" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource BrushAccentSecondary}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Border CornerRadius="8" Background="{StaticResource BrushBackgroundCard}" BorderThickness="0" Padding="0"
                                Height="38" VerticalAlignment="Center">
                            <TextBox x:Name="GiftCodeBox" Width="230" FontSize="13" Padding="10,8"
                                     Background="{StaticResource BrushBackgroundCard}"
                                     Foreground="{StaticResource BrushTextPrimary}" BorderThickness="0"
                                     VerticalContentAlignment="Center" KeyDown="GiftCodeBox_KeyDown" />
                        </Border>
                        <Border CornerRadius="8" Background="{StaticResource BrushAccentPrimary}" Padding="14,9"
                                Cursor="Hand" Margin="8,0,0,0" VerticalAlignment="Center" MouseLeftButtonDown="RedeemGift_Click">
                            <TextBlock Text="REDEEM" FontSize="12" FontWeight="Bold" Foreground="#0D0D14" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="RedeemStatus" Text="Enter a code like GC-XXXX-XXXX-XXXX" FontSize="11"
                               Foreground="{StaticResource BrushTextMuted}" Margin="0,8,0,0" TextWrapping="Wrap" />

                    <TextBlock Text="OR SUBSCRIBE DIRECTLY" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource BrushAccentSecondary}" Margin="0,16,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Border CornerRadius="8" Background="{StaticResource BrushBackgroundCard}" Padding="0"
                                Height="38" VerticalAlignment="Center">
                            <TextBox x:Name="AmountBox" Width="52" Text="1" FontSize="13" Padding="10,8"
                                     Background="{StaticResource BrushBackgroundCard}"
                                     Foreground="{StaticResource BrushTextPrimary}" BorderThickness="0"
                                     VerticalContentAlignment="Center" />
                        </Border>
                        <Border CornerRadius="8" Background="{StaticResource BrushBackgroundCard}" Padding="0"
                                Height="38" VerticalAlignment="Center" Margin="8,0,0,0">
                            <ComboBox x:Name="UnitBox" Width="130" FontSize="12"
                                      Background="{StaticResource BrushBackgroundCard}"
                                      Foreground="{StaticResource BrushTextPrimary}" BorderThickness="0"
                                      VerticalContentAlignment="Center">
                                <ComboBoxItem Content="Days" IsSelected="True" />
                                <ComboBoxItem Content="Months" />
                                <ComboBoxItem Content="Years" />
                            </ComboBox>
                        </Border>
                        <Border CornerRadius="8" Background="{StaticResource BrushAccentPrimary}" Padding="14,9"
                                Cursor="Hand" Margin="8,0,0,0" VerticalAlignment="Center" MouseLeftButtonDown="SubscribeNow_Click">
                            <TextBlock Text="SUBSCRIBE" FontSize="12" FontWeight="Bold" Foreground="#0D0D14" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- tier cards -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="CHOOSE A PLAN" FontSize="13" FontWeight="Bold"
                       Foreground="{StaticResource BrushAccentPrimary}" Margin="0,0,0,10" />

            <ScrollViewer Grid.Row="1" Style="{StaticResource InvisibleScrollViewer}">
                <ItemsControl x:Name="PlanList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="12" Background="{StaticResource BrushBackgroundLight}"
                                    BorderBrush="{StaticResource BrushBackgroundCard}" BorderThickness="1"
                                    Padding="14" Margin="0,0,12,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Emoji}" FontSize="26" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold"
                                                   Foreground="{StaticResource BrushTextPrimary}"
                                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding PerksText}" FontSize="11"
                                               Foreground="{StaticResource BrushTextMuted}"
                                               TextWrapping="Wrap" Margin="0,10,0,0" MinHeight="44" />
                                    <Button Content="CHOOSE" FontSize="11" FontWeight="Bold"
                                            Background="{StaticResource BrushAccentPrimary}"
                                            Foreground="#0D0D14" BorderThickness="0"
                                            Padding="0,6" Margin="0,12,0,0" Cursor="Hand"
                                            Tag="{Binding Id}" Click="ChoosePlan" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>