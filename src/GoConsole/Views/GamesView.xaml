<UserControl x:Class="GoConsoleOS.GoConsole.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="Transparent">
    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Game Browser Sidebar -->
        <Border Grid.Column="0" CornerRadius="0" Background="{StaticResource BrushBackgroundDark}"
                Padding="16,40,12,16">
            <StackPanel>
                <TextBlock Text="BUILT-IN GAMES" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource BrushAccentPrimary}" Margin="0,0,0,4" />
                <TextBlock Text="Built-in browser games" FontSize="11"
                           Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,16" />

                <ItemsControl x:Name="GameList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Background="{StaticResource BrushBackgroundLight}"
                                    Padding="10,8" Margin="0,0,0,4" Cursor="Hand"
                                    MouseLeftButtonDown="SelectGame" Tag="{Binding Id}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Emoji}" FontSize="18" Margin="0,0,8,0"
                                               VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold"
                                                   Foreground="{StaticResource BrushTextPrimary}" />
                                        <TextBlock Text="{Binding Description}" FontSize="10"
                                                   Foreground="{StaticResource BrushTextSecondary}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Game Canvas -->
        <Border Grid.Column="1" CornerRadius="0" Background="#0D0D14" Padding="0">
            <Grid>
                <wv2:WebView2 x:Name="GameWebView" />
                <Border x:Name="WelcomeOverlay" Background="#0D0D14">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🎮" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,16" />
                        <TextBlock Text="SELECT A GAME" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource BrushAccentPrimary}" HorizontalAlignment="Center" />
                        <TextBlock Text="Choose a game from the sidebar to start playing"
                                   FontSize="14" Foreground="{StaticResource BrushTextSecondary}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                        <TextBlock Text="Use keyboard &amp; mouse to play — games run in your browser engine"
                                   FontSize="11" Foreground="{StaticResource BrushTextMuted}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
