<UserControl x:Class="GoConsoleOS.GoConsole.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cc="clr-namespace:GoConsoleOS.GoConsole.Controls"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Hero Banner Area -->
        <Border Grid.Row="0" Height="380" Margin="0" CornerRadius="0">
            <Grid>
                <Image x:Name="HeroImage" Stretch="UniformToFill" />
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#0D0D14" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid Margin="60,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <Border Width="72" Height="6" CornerRadius="3"
                                    Background="{StaticResource BrushGradientAccent}"
                                    HorizontalAlignment="Left" Margin="0,0,0,12" />
                            <TextBlock x:Name="HeroTitle" Text="WELCOME TO GOCONSOLEOS"
                                       FontSize="48" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock x:Name="HeroSubtitle" Text="Console Mode for Windows 11"
                                       FontSize="20" Foreground="{StaticResource BrushAccentPrimary}"
                                       Margin="0,8,0,0" />
                            <TextBlock x:Name="HeroGreeting" Text="Your games, your way. Start playing."
                                       FontSize="16" Foreground="{StaticResource BrushTextSecondary}"
                                       Margin="0,4,0,0" />
                            <Button x:Name="QuickResumeBtn" Content="QUICK RESUME" Width="240" Height="48"
                                    Margin="0,20,0,0" Style="{StaticResource AccentButtonStyle}"
                                    Click="QuickResume_Click" FontSize="16" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="200" Height="200" CornerRadius="16"
                                Background="{StaticResource BrushBackgroundLight}" Margin="0,0,60,0"
                                VerticalAlignment="Center"
                                BorderBrush="{StaticResource BrushAccentPrimary}" BorderThickness="1.5">
                            <Grid>
                                <Image x:Name="HeroGameIcon" Stretch="Uniform" Margin="10" />
                                <Border Background="{StaticResource BrushGlowAccent}" IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Content -->
        <cc:OnScreenScrollViewer x:Name="PageScroller" Grid.Row="1">
            <StackPanel Margin="0,0,0,20">

                <!-- Dashboard Cards Row -->
                <Border Margin="20,16" Padding="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" x:Name="CardCloudGaming" CornerRadius="12" Margin="0,0,8,0"
                                Background="{StaticResource BrushBackgroundCard}" Cursor="Hand"
                                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                MouseLeftButtonDown="DashboardCard_Click" Tag="cloudgaming"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Mouse.MouseEnter">
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.04" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.04" Duration="0:0:0.15" />
                                        <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#0066FF" Duration="0:0:0.15" />
                                    </Storyboard></BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="Mouse.MouseLeave">
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15" />
                                        <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#1E2A55" Duration="0:0:0.15" />
                                    </Storyboard></BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                            <StackPanel Margin="16,20" HorizontalAlignment="Center">
                                <TextBlock Text="☁️" FontSize="40" HorizontalAlignment="Center" />
                                <TextBlock Text="Cloud Gaming" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"
                                           HorizontalAlignment="Center" Margin="0,8,0,0" />
                                <TextBlock Text="Play instantly. No downloads." FontSize="10" Foreground="{StaticResource BrushTextMuted}"
                                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" x:Name="CardLibrary" CornerRadius="12" Margin="4,0,4,0"
                                Background="{StaticResource BrushBackgroundCard}" Cursor="Hand"
                                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                MouseLeftButtonDown="DashboardCard_Click" Tag="library">
                            <StackPanel Margin="16,20" HorizontalAlignment="Center">
                                <TextBlock Text="📚" FontSize="40" HorizontalAlignment="Center" />
                                <TextBlock Text="Library" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"
                                           HorizontalAlignment="Center" Margin="0,8,0,0" />
                                <TextBlock Text="Your games. All in one place." FontSize="10" Foreground="{StaticResource BrushTextMuted}"
                                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" x:Name="CardStore" CornerRadius="12" Margin="4,0,4,0"
                                Background="{StaticResource BrushBackgroundCard}" Cursor="Hand"
                                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                MouseLeftButtonDown="DashboardCard_Click" Tag="store">
                            <StackPanel Margin="16,20" HorizontalAlignment="Center">
                                <TextBlock Text="🛍️" FontSize="40" HorizontalAlignment="Center" />
                                <TextBlock Text="Store" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"
                                           HorizontalAlignment="Center" Margin="0,8,0,0" />
                                <TextBlock Text="Discover. Buy. Play." FontSize="10" Foreground="{StaticResource BrushTextMuted}"
                                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" x:Name="CardSettings" CornerRadius="12" Margin="4,0,4,0"
                                Background="{StaticResource BrushBackgroundCard}" Cursor="Hand"
                                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                MouseLeftButtonDown="DashboardCard_Click" Tag="settings">
                            <StackPanel Margin="16,20" HorizontalAlignment="Center">
                                <TextBlock Text="⚙️" FontSize="40" HorizontalAlignment="Center" />
                                <TextBlock Text="Settings" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"
                                           HorizontalAlignment="Center" Margin="0,8,0,0" />
                                <TextBlock Text="System. Display. Accounts." FontSize="10" Foreground="{StaticResource BrushTextMuted}"
                                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" x:Name="CardMedia" CornerRadius="12" Margin="8,0,0,0"
                                Background="{StaticResource BrushBackgroundCard}" Cursor="Hand"
                                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                MouseLeftButtonDown="DashboardCard_Click" Tag="music">
                            <StackPanel Margin="16,20" HorizontalAlignment="Center">
                                <TextBlock Text="🎬" FontSize="40" HorizontalAlignment="Center" />
                                <TextBlock Text="Media" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"
                                           HorizontalAlignment="Center" Margin="0,8,0,0" />
                                <TextBlock Text="Movies. Music. Entertainment." FontSize="10" Foreground="{StaticResource BrushTextMuted}"
                                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Built-in Games Row -->
                <TextBlock Text="PLAY NOW - BUILT-IN GAMES" Style="{StaticResource SectionTitleStyle}" />
                <ItemsControl x:Name="BuiltInGamesList" Margin="20,0"
                              MouseDoubleClick="BuiltInGame_Click">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="180" Height="220" CornerRadius="12" Margin="0,0,12,12"
                                    Background="{StaticResource BrushBackgroundCard}" Cursor="Hand" Tag="{Binding Id}"
                                    MouseLeftButtonDown="BuiltInGame_Click"
                                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform />
                                </Border.RenderTransform>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Mouse.MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 To="1.06" Duration="0:0:0.15" />
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 To="1.06" Duration="0:0:0.15" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="Mouse.MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 To="1" Duration="0:0:0.15" />
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 To="1" Duration="0:0:0.15" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                                <Grid>
                                    <Border CornerRadius="12" Background="{StaticResource BrushGradientSurface}" />
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-10,0,0">
                                        <TextBlock Text="{Binding Emoji}" FontSize="48" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold"
                                                   Foreground="{StaticResource BrushTextPrimary}"
                                                   HorizontalAlignment="Center" Margin="0,8,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Description}" FontSize="10"
                                                   Foreground="{StaticResource BrushTextMuted}"
                                                   HorizontalAlignment="Center" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border VerticalAlignment="Bottom" Margin="0,0,0,10">
                                        <Border Background="{StaticResource BrushAccentPrimary}"
                                                CornerRadius="6" Padding="16,6" HorizontalAlignment="Center">
                                            <TextBlock Text="PLAY" FontSize="11" FontWeight="Bold" Foreground="#0D0D14" />
                                        </Border>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Continue Playing Row -->
                <TextBlock Text="CONTINUE PLAYING" Style="{StaticResource SectionTitleStyle}" />
            <ItemsControl x:Name="ContinuePlayingList" Margin="20,0"
                          MouseDoubleClick="GameTile_DoubleClick">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource GameTileStyle}" Cursor="Hand">
                            <Grid MouseLeftButtonDown="GameTile_Click" Tag="{Binding Id}">
                                <Border CornerRadius="10" Margin="8" ClipToBounds="True">
                                    <Image Source="{Binding BannerPath}" Stretch="UniformToFill" />
                                </Border>
                                <Border CornerRadius="10" Margin="8">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0.4" />
                                            <GradientStop Color="#000000CC" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel VerticalAlignment="Bottom" Margin="8">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold"
                                                   Foreground="{StaticResource BrushTextPrimary}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Platform}" FontSize="11"
                                                   Foreground="{StaticResource BrushTextMuted}" />
                                        <Border Background="{StaticResource BrushAccentPrimary}"
                                                CornerRadius="4" Padding="6,2" Margin="0,6,0,0"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="PLAY" FontSize="10" FontWeight="Bold"
                                                       Foreground="#0D0D14" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Activity Feed Row -->
            <TextBlock Text="RECENT ACTIVITY" Style="{StaticResource SectionTitleStyle}" />
            <Border Margin="20,0,20,8" Padding="12" CornerRadius="12"
                    Background="{StaticResource BrushBackgroundLight}" MinHeight="60">
                <ItemsControl x:Name="ActivityFeedList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Background="{StaticResource BrushBackgroundCard}"
                                    Padding="12,8" Margin="4" Width="200">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource BrushTextPrimary}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Description}" FontSize="10"
                                               Foreground="{StaticResource BrushTextMuted}"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding TimeAgo}" FontSize="9"
                                               Foreground="{StaticResource BrushAccentPrimary}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Recommended Row -->
            <TextBlock Text="RECOMMENDED" Style="{StaticResource SectionTitleStyle}" />
            <ItemsControl x:Name="RecommendedList" Margin="20,0"
                          MouseDoubleClick="GameTile_DoubleClick">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource GameTileStyle}" Cursor="Hand">
                            <Grid MouseLeftButtonDown="GameTile_Click" Tag="{Binding Id}">
                                <Border CornerRadius="10" Margin="8" ClipToBounds="True">
                                    <Image Source="{Binding BannerPath}" Stretch="UniformToFill" />
                                </Border>
                                <Border CornerRadius="10" Margin="8">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0.4" />
                                            <GradientStop Color="#000000CC" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel VerticalAlignment="Bottom" Margin="8">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold"
                                                   Foreground="{StaticResource BrushTextPrimary}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Platform}" FontSize="11"
                                                   Foreground="{StaticResource BrushTextMuted}" />
                                        <Border Background="{StaticResource BrushGradientAccent}"
                                                CornerRadius="4" Padding="6,2" Margin="0,6,0,0"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="PLAY" FontSize="10" FontWeight="Bold"
                                                       Foreground="#0D0D14" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Apps Row -->
            <TextBlock Text="APPS" Style="{StaticResource SectionTitleStyle}" />
            <ItemsControl x:Name="AppsList" Margin="20,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="180" Height="110" CornerRadius="12" Margin="0,0,12,12"
                                Background="{StaticResource BrushGradientSurface}" Cursor="Hand" Tag="{Binding Route}"
                                MouseLeftButtonDown="AppTile_Click"
                                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform />
                            </Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Mouse.MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.04" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.04" Duration="0:0:0.15" />
                                            <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                             To="#0066FF" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="Mouse.MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1" Duration="0:0:0.15" />
                                            <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                             To="#2A2A44" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                            <Grid>
                                <TextBlock Text="{Binding Icon}" FontSize="34" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Margin="0,-14,0,0" />
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Platform Status -->
            <Border Margin="20,8" Padding="16" CornerRadius="12"
                    Background="{StaticResource BrushBackgroundLight}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Platforms:" FontSize="14"
                               Foreground="{StaticResource BrushTextSecondary}"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" x:Name="PlatformListPanel" Orientation="Horizontal" />
                    <TextBlock Grid.Column="2" x:Name="GameCountText" Text="0 games"
                               FontSize="14" Foreground="{StaticResource BrushAccentPrimary}"
                               VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Border Grid.Column="3" CornerRadius="6" Background="{StaticResource BrushBackgroundCard}"
                            Padding="8,4" Cursor="Hand" MouseLeftButtonDown="ViewAll_Click">
                        <TextBlock Text="VIEW ALL" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource BrushAccentPrimary}" />
                    </Border>
                </Grid>
            </Border>
        </StackPanel>
        </cc:OnScreenScrollViewer>
    </Grid>
</UserControl>
