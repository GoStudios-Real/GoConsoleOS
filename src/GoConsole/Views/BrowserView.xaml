<UserControl x:Class="GoConsoleOS.GoConsole.Views.BrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="Transparent"
             Loaded="UserControl_Loaded"
             Unloaded="OnUnloaded">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Browser Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource BrushBackgroundMedium}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border CornerRadius="4" Padding="8,4" Cursor="Hand"
                            Background="{StaticResource BrushBackgroundCard}" Margin="0,0,4,0"
                            MouseLeftButtonDown="BrowserHome">
                        <TextBlock Text="⌂" FontSize="14" Foreground="{StaticResource BrushTextPrimary}" />
                    </Border>
                    <Border CornerRadius="4" Padding="8,4" Cursor="Hand"
                            Background="{StaticResource BrushBackgroundCard}" Margin="0,0,4,0"
                            MouseLeftButtonDown="BrowserRefresh">
                        <TextBlock Text="⟳" FontSize="14" Foreground="{StaticResource BrushTextPrimary}" />
                    </Border>
                    <Border CornerRadius="4" Padding="8,4" Cursor="Hand"
                            Background="{StaticResource BrushBackgroundCard}" Margin="0,0,4,0"
                            MouseLeftButtonDown="BrowserBack">
                        <TextBlock Text="◀" FontSize="14" Foreground="{StaticResource BrushTextPrimary}" />
                    </Border>
                    <Border CornerRadius="4" Padding="8,4" Cursor="Hand"
                            Background="{StaticResource BrushBackgroundCard}" Margin="0,0,8,0"
                            MouseLeftButtonDown="BrowserForward">
                        <TextBlock Text="▶" FontSize="14" Foreground="{StaticResource BrushTextPrimary}" />
                    </Border>
                </StackPanel>

                <Border Grid.Column="1" CornerRadius="16" Background="{StaticResource BrushBackgroundCard}"
                        Padding="12,4" Margin="0,0,8,0">
                    <TextBlock x:Name="UrlText" Text="Enter URL..." FontSize="13"
                               Foreground="{StaticResource BrushTextSecondary}"
                               VerticalAlignment="Center" />
                </Border>

                <Border Grid.Column="2" CornerRadius="16" Background="{StaticResource BrushBackgroundCard}"
                        Padding="12,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔒" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="UrlBar" Text="" FontSize="13"
                                 Foreground="{StaticResource BrushTextPrimary}"
                                 Background="Transparent" BorderThickness="0"
                                 VerticalAlignment="Center" MinWidth="220"
                                 KeyDown="UrlBar_KeyDown" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" CornerRadius="6" Background="{StaticResource BrushBackgroundCard}"
                        Padding="10,4" Cursor="Hand" MouseLeftButtonDown="OpenKeyboard"
                        Margin="6,0,0,0">
                    <TextBlock Text="⌨" FontSize="13" VerticalAlignment="Center" />
                </Border>

                <Border Grid.Column="4" CornerRadius="6" Background="{StaticResource BrushAccentPrimary}"
                        Padding="12,4" Cursor="Hand" MouseLeftButtonDown="NavigateUrl"
                        Margin="8,0,0,0">
                    <TextBlock Text="GO" FontSize="12" FontWeight="Bold" Foreground="#0D0D14" />
                </Border>
            </Grid>
        </Border>

        <!-- WebView2 Content -->
        <wv2:WebView2 x:Name="Browser" Grid.Row="1" Margin="0" />
    </Grid>
</UserControl>
