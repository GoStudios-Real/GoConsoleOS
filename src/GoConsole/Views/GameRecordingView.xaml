<UserControl x:Class="GoConsoleOS.GoConsole.Views.GameRecordingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="GAME RECORDING" FontSize="28" FontWeight="Bold"
                   Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" Text="Record and manage your gameplay clips."
                   FontSize="14" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,20" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}" Padding="16" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="RECORDING CONTROLS" FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource BrushAccentPrimary}" Margin="0,0,0,12" />

                    <Border CornerRadius="8" Background="{StaticResource BrushBackgroundCard}" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Recording Status" FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                            <TextBlock x:Name="RecordingStatus" Text="IDLE" FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Max Clip Length" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                    <ComboBox x:Name="ClipLengthBox" FontSize="12" Margin="0,4,0,12"
                              Background="{StaticResource BrushBackgroundCard}"
                              Foreground="{StaticResource BrushTextPrimary}" BorderThickness="0">
                        <ComboBoxItem Content="30 seconds" IsSelected="True" />
                        <ComboBoxItem Content="1 minute" />
                        <ComboBoxItem Content="3 minutes" />
                        <ComboBoxItem Content="5 minutes" />
                    </ComboBox>

                    <TextBlock Text="Quality" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                    <ComboBox x:Name="QualityBox" FontSize="12" Margin="0,4,0,12"
                              Background="{StaticResource BrushBackgroundCard}"
                              Foreground="{StaticResource BrushTextPrimary}" BorderThickness="0">
                        <ComboBoxItem Content="1080p 60fps" IsSelected="True" />
                        <ComboBoxItem Content="1080p 30fps" />
                        <ComboBoxItem Content="720p 60fps" />
                        <ComboBoxItem Content="720p 30fps" />
                    </ComboBox>

                    <Button x:Name="RecordToggleBtn" Content="⏺ START RECORDING" FontSize="13" FontWeight="Bold"
                            Background="#FF5252" Foreground="White" BorderThickness="0"
                            Padding="0,10" Cursor="Hand" Click="ToggleRecording" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}" Padding="16">
                <StackPanel>
                    <TextBlock Text="RECENT CLIPS" FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource BrushAccentPrimary}" Margin="0,0,0,12" />
                    <ItemsControl x:Name="ClipList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Background="{StaticResource BrushBackgroundCard}"
                                        Padding="10,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🎬" FontSize="20"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Game}" FontSize="13" FontWeight="Bold"
                                                       Foreground="{StaticResource BrushTextPrimary}" />
                                            <TextBlock Text="{Binding Duration}" FontSize="10"
                                                       Foreground="{StaticResource BrushTextMuted}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Date}" FontSize="10"
                                                   Foreground="{StaticResource BrushTextSecondary}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Text="Game recording captures the last N minutes of gameplay. Press Ctrl+Shift+R to save a clip."
                   FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,12,0,0" />
    </Grid>
</UserControl>
