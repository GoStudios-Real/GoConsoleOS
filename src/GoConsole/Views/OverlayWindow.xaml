<Window x:Class="GoConsoleOS.GoConsole.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cc="clr-namespace:GoConsoleOS.GoConsole.Controls"
        Title="GoConsoleOS Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        IsHitTestVisible="False"
        KeyDown="Window_KeyDown">
    <Grid>
        <Border x:Name="OverlayBackground"
                Background="#66000000" CornerRadius="0" IsHitTestVisible="False">
            <Grid Margin="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="16" Background="#CC1A1A2E"
                        Padding="20" IsHitTestVisible="False">
                    <StackPanel>
                        <TextBlock Text="SYSTEM" FontSize="16" FontWeight="Bold"
                                   Foreground="#0066FF" Margin="0,0,0,12" />

                        <TextBlock Text="CPU" FontSize="11" Foreground="#8888AA" Margin="0,0,0,2" />
                        <Border CornerRadius="4" Background="#1A1A2E" Height="16" Margin="0,0,0,8">
                            <Border x:Name="CpuBar" CornerRadius="4" Background="#0066FF"
                                    Width="0" HorizontalAlignment="Left" />
                        </Border>
                        <TextBlock x:Name="StatCpu" Text="CPU: --%" FontSize="13"
                                   Foreground="#F0F0FF" Margin="0,0,0,8" />

                        <TextBlock Text="GPU" FontSize="11" Foreground="#8888AA" Margin="0,0,0,2" />
                        <Border CornerRadius="4" Background="#1A1A2E" Height="16" Margin="0,0,0,8">
                            <Border x:Name="GpuBar" CornerRadius="4" Background="#7B2DFF"
                                    Width="0" HorizontalAlignment="Left" />
                        </Border>
                        <TextBlock x:Name="StatGpu" Text="GPU: --%" FontSize="13"
                                   Foreground="#F0F0FF" Margin="0,0,0,8" />

                        <TextBlock Text="RAM" FontSize="11" Foreground="#8888AA" Margin="0,0,0,2" />
                        <Border CornerRadius="4" Background="#1A1A2E" Height="16" Margin="0,0,0,8">
                            <Border x:Name="RamBar" CornerRadius="4" Background="#FFD600"
                                    Width="0" HorizontalAlignment="Left" />
                        </Border>
                        <TextBlock x:Name="StatRam" Text="RAM: -- / -- GB" FontSize="13"
                                   Foreground="#F0F0FF" Margin="0,0,0,8" />

                        <TextBlock x:Name="StatFps" Text="FPS: --" FontSize="16"
                                   Foreground="#FFD600" Margin="0,4,0,8" />
                        <TextBlock x:Name="StatMode" Text="Mode: Balanced" FontSize="12"
                                   Foreground="#8888AA" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" CornerRadius="16" Background="#CC1A1A2E"
                        Padding="20" Margin="20,0" IsHitTestVisible="False">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="IN-GAME OVERLAY" FontSize="22" FontWeight="Bold"
                                   Foreground="#0066FF" HorizontalAlignment="Center" />
                        <cc:ControllerHintBar HorizontalAlignment="Center" Margin="0,10,0,0">
                            <cc:ControllerHintItem Button="Guide" Text="Close" />
                            <cc:ControllerHintItem Button="B" Text="Back" />
                        </cc:ControllerHintBar>

                        <Separator Margin="0,16" Opacity="0.3" />

                        <TextBlock Text="Quick Actions" FontSize="16" FontWeight="Bold"
                                   Foreground="#F0F0FF" HorizontalAlignment="Center"
                                   Margin="0,0,0,12" />
                        <cc:ControllerHintBar HorizontalAlignment="Center">
                            <cc:ControllerHintItem Button="Guide" Text="Quick Menu" />
                            <cc:ControllerHintItem Button="Start" Text="Power Menu" />
                        </cc:ControllerHintBar>
                        <TextBlock Text="F11 = Cycle Performance" FontSize="13"
                                   Foreground="#7B2DFF" HorizontalAlignment="Center"
                                   Margin="0,6,0,0" />
                        <TextBlock Text="F9 = Toggle Overlay" FontSize="13"
                                   Foreground="#7B2DFF" HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" CornerRadius="16" Background="#CC1A1A2E"
                        Padding="20" IsHitTestVisible="False">
                    <StackPanel>
                        <TextBlock Text="AUDIO &amp; NETWORK" FontSize="16" FontWeight="Bold"
                                   Foreground="#FF4D8C" Margin="0,0,0,16" />
                        <TextBlock x:Name="StatVolume" Text="Volume: --%" FontSize="14"
                                   Foreground="#F0F0FF" Margin="0,4" />
                        <TextBlock x:Name="StatOutput" Text="Output: Default" FontSize="14"
                                   Foreground="#F0F0FF" Margin="0,4" />
                        <Separator Margin="0,12" Opacity="0.3" />
                        <TextBlock x:Name="StatNetwork" Text="Network: --" FontSize="14"
                                   Foreground="#F0F0FF" Margin="0,4" />
                        <TextBlock x:Name="StatIp" Text="IP: --" FontSize="12"
                                   Foreground="#8888AA" Margin="0,4" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
