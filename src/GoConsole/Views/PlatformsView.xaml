<UserControl x:Class="GoConsoleOS.GoConsole.Views.PlatformsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="Transparent"
             Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- GoStudios Games Tabs Bar -->
        <Border Grid.Row="0" Background="{StaticResource BrushBackgroundDark}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
                Padding="40,8,20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border x:Name="Tab2D" CornerRadius="8,8,0,0" Background="#00C9DB"
                            Padding="12,8" Cursor="Hand" Margin="0,0,3,0"
                            MouseLeftButtonDown="SwitchTab" Tag="2d">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F3AE;" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="2D GAMES" FontSize="12" FontWeight="Bold" Foreground="#0D0D14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="Tab3D" CornerRadius="8,8,0,0" Background="{StaticResource BrushBackgroundLight}"
                            Padding="12,8" Cursor="Hand" Margin="0,0,3,0"
                            MouseLeftButtonDown="SwitchTab" Tag="3d">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F57C;" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="3D GAMES" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="TabAll" CornerRadius="8,8,0,0" Background="{StaticResource BrushBackgroundLight}"
                            Padding="12,8" Cursor="Hand" Margin="0,0,3,0"
                            MouseLeftButtonDown="SwitchTab" Tag="all">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F3C6;" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="ALL GAMES" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="TabStore" CornerRadius="8,8,0,0" Background="{StaticResource BrushBackgroundLight}"
                            Padding="12,8" Cursor="Hand" Margin="0,0,3,0"
                            MouseLeftButtonDown="SwitchTab" Tag="store">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F6D2;" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="STORE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Navigation Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="4" Background="{StaticResource BrushBackgroundCard}"
                            Padding="6,4" Cursor="Hand" Margin="0,0,4,0"
                            MouseLeftButtonDown="NavBack">
                        <TextBlock Text="&#x25C0;" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" />
                    </Border>
                    <Border CornerRadius="4" Background="{StaticResource BrushBackgroundCard}"
                            Padding="6,4" Cursor="Hand" Margin="0,0,4,0"
                            MouseLeftButtonDown="NavForward">
                        <TextBlock Text="&#x25B6;" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" />
                    </Border>
                    <Border CornerRadius="4" Background="{StaticResource BrushBackgroundCard}"
                            Padding="6,4" Cursor="Hand" Margin="0,0,4,0"
                            MouseLeftButtonDown="NavRefresh">
                        <TextBlock Text="&#x21BB;" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" />
                    </Border>
                    <TextBlock x:Name="TabTitle" Text="GoStudios Corporation Games"
                               FontSize="11" Foreground="{StaticResource BrushTextMuted}"
                               VerticalAlignment="Center" Margin="4,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- WebView2 -->
        <wv2:WebView2 x:Name="PlatformBrowser" Grid.Row="1" Margin="0" />
    </Grid>
</UserControl>
