<UserControl x:Class="GoConsoleOS.GoConsole.Views.PlatformsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="Transparent"
             Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Platform Tabs Bar -->
        <Border Grid.Row="0" Background="{StaticResource BrushBackgroundDark}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
                Padding="40,8,20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border x:Name="TabSteam" CornerRadius="8,8,0,0" Background="#00C9DB"
                            Padding="12,8" Cursor="Hand" Margin="0,0,3,0"
                            MouseLeftButtonDown="SwitchTab" Tag="steam">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x26A1;" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="STEAM" FontSize="12" FontWeight="Bold" Foreground="#0D0D14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="TabEpic" CornerRadius="8,8,0,0" Background="{StaticResource BrushBackgroundLight}"
                            Padding="12,8" Cursor="Hand" Margin="0,0,3,0"
                            MouseLeftButtonDown="SwitchTab" Tag="epic">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x2728;" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="EPIC" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="TabXbox" CornerRadius="8,8,0,0" Background="{StaticResource BrushBackgroundLight}"
                            Padding="12,8" Cursor="Hand" Margin="0,0,3,0"
                            MouseLeftButtonDown="SwitchTab" Tag="xbox">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x2744;" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="XBOX" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="TabGog" CornerRadius="8,8,0,0" Background="{StaticResource BrushBackgroundLight}"
                            Padding="12,8" Cursor="Hand" Margin="0,0,3,0"
                            MouseLeftButtonDown="SwitchTab" Tag="gog">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x2B50;" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="GOG" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="TabPlaystation" CornerRadius="8,8,0,0" Background="{StaticResource BrushBackgroundLight}"
                            Padding="12,8" Cursor="Hand" Margin="0,0,3,0"
                            MouseLeftButtonDown="SwitchTab" Tag="playstation">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F3AE;" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="PLAYSTATION" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="TabNintendo" CornerRadius="8,8,0,0" Background="{StaticResource BrushBackgroundLight}"
                            Padding="12,8" Cursor="Hand" Margin="0,0,3,0"
                            MouseLeftButtonDown="SwitchTab" Tag="nintendo">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F344;" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="NINTENDO" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="TabBattlenet" CornerRadius="8,8,0,0" Background="{StaticResource BrushBackgroundLight}"
                            Padding="12,8" Cursor="Hand" Margin="0,0,3,0"
                            MouseLeftButtonDown="SwitchTab" Tag="battlenet">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F525;" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="BATTLE.NET" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="TabEa" CornerRadius="8,8,0,0" Background="{StaticResource BrushBackgroundLight}"
                            Padding="12,8" Cursor="Hand" Margin="0,0,3,0"
                            MouseLeftButtonDown="SwitchTab" Tag="ea">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F3C6;" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="EA" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="TabUbisoft" CornerRadius="8,8,0,0" Background="{StaticResource BrushBackgroundLight}"
                            Padding="12,8" Cursor="Hand" Margin="0,0,3,0"
                            MouseLeftButtonDown="SwitchTab" Tag="ubisoft">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F9E9;" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="UBISOFT" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="TabItch" CornerRadius="8,8,0,0" Background="{StaticResource BrushBackgroundLight}"
                            Padding="12,8" Cursor="Hand" Margin="0,0,3,0"
                            MouseLeftButtonDown="SwitchTab" Tag="itch">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F339;" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="ITCH.IO" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Navigation Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="4" Background="{StaticResource BrushBackgroundCard}"
                            Padding="6,4" Cursor="Hand" Margin="0,0,4,0"
                            MouseLeftButtonDown="NavBack">
                        <TextBlock Text="&#x25C0;" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" />
                    </Border>
                    <Border CornerRadius="4" Background="{StaticResource BrushBackgroundCard}"
                            Padding="6,4" Cursor="Hand" Margin="0,0,4,0"
                            MouseLeftButtonDown="NavForward">
                        <TextBlock Text="&#x25B6;" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" />
                    </Border>
                    <Border CornerRadius="4" Background="{StaticResource BrushBackgroundCard}"
                            Padding="6,4" Cursor="Hand" Margin="0,0,4,0"
                            MouseLeftButtonDown="NavRefresh">
                        <TextBlock Text="&#x21BB;" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" />
                    </Border>
                    <TextBlock x:Name="TabTitle" Text="store.steampowered.com"
                               FontSize="11" Foreground="{StaticResource BrushTextMuted}"
                               VerticalAlignment="Center" Margin="4,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- WebView2 -->
        <wv2:WebView2 x:Name="PlatformBrowser" Grid.Row="1" Margin="0" />
    </Grid>
</UserControl>
