<UserControl x:Class="GoConsoleOS.GoConsole.Views.FriendsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="FRIENDS &amp; PROFILES" FontSize="28" FontWeight="Bold"
                   Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,20" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Current Profile + Profile Switcher -->
            <Border Grid.Column="0" CornerRadius="16" Background="{StaticResource BrushBackgroundLight}"
                    Padding="24" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="CURRENT PROFILE" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource BrushAccentPrimary}" />

                    <Border CornerRadius="12" Background="{StaticResource BrushBackgroundCard}"
                            Padding="16" Margin="0,12,0,0">
                        <StackPanel>
                            <Ellipse Width="64" Height="64" Fill="{StaticResource BrushAccentSecondary}"
                                     HorizontalAlignment="Left" Margin="0,0,0,8" />
                            <TextBlock x:Name="CurrentProfileName" Text="Guest"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock x:Name="CurrentProfileDetails" Text=""
                                       FontSize="14" Foreground="{StaticResource BrushTextSecondary}" />
                            <Border Background="{StaticResource BrushBackgroundCardHover}"
                                    CornerRadius="8" Padding="12" Margin="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock x:Name="StatGames" Text="0" FontSize="20" FontWeight="Bold"
                                                   Foreground="{StaticResource BrushAccentPrimary}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="Games" FontSize="11"
                                                   Foreground="{StaticResource BrushTextMuted}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock x:Name="StatPlaytime" Text="0h" FontSize="20" FontWeight="Bold"
                                                   Foreground="{StaticResource BrushAccentSecondary}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="Played" FontSize="11"
                                                   Foreground="{StaticResource BrushTextMuted}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock x:Name="StatAchievements" Text="0" FontSize="20" FontWeight="Bold"
                                                   Foreground="{StaticResource BrushWarning}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="ACHV" FontSize="11"
                                                   Foreground="{StaticResource BrushTextMuted}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="SWITCH PROFILE" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextSecondary}"
                               Margin="0,16,0,8" />
                    <ListBox x:Name="ProfileListBox"
                             Background="Transparent" BorderThickness="0"
                             MaxHeight="200"
                             SelectionChanged="Profile_Selected">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Background="{StaticResource BrushBackgroundCard}"
                                        Padding="12,8" Margin="0,2" Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="32" Height="32"
                                                 Fill="{StaticResource BrushAccentTertiary}"
                                                 Margin="0,0,12,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="Bold"
                                                       Foreground="{StaticResource BrushTextPrimary}" />
                                            <TextBlock Text="{Binding Username}" FontSize="11"
                                                       Foreground="{StaticResource BrushTextMuted}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Right: Activity / Add Friend -->
            <Border Grid.Column="1" CornerRadius="16" Background="{StaticResource BrushBackgroundLight}"
                    Padding="24" Margin="12,0,0,0">
                <StackPanel>
                    <TextBlock Text="ACTIVITY" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource BrushAccentSecondary}" />

                    <Border CornerRadius="12" Background="{StaticResource BrushBackgroundCard}"
                            Padding="16" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Recent Activity" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" />
                            <ItemsControl x:Name="ActivityList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Background="{StaticResource BrushBackgroundCardHover}"
                                                Padding="8" Margin="0,4">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold"
                                                           Foreground="{StaticResource BrushTextPrimary}" />
                                                <TextBlock Text="{Binding Description}" FontSize="11"
                                                           Foreground="{StaticResource BrushTextMuted}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="12" Background="{StaticResource BrushBackgroundCard}"
                            Padding="16" Margin="0,12,0,0" Cursor="Hand"
                            MouseLeftButtonDown="AddFriend_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="+" FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource BrushAccentPrimary}"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <StackPanel>
                                <TextBlock Text="Add Friend" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource BrushTextPrimary}" />
                                <TextBlock Text="Search by username or display name"
                                           FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="12" Background="{StaticResource BrushBackgroundCard}"
                            Padding="16" Margin="0,12,0,0" Cursor="Hand"
                            MouseLeftButtonDown="CreateProfile_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="+" FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource BrushAccentSecondary}"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <StackPanel>
                                <TextBlock Text="Create New Profile" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource BrushTextPrimary}" />
                                <TextBlock Text="Set up a new local profile with your preferences"
                                           FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
