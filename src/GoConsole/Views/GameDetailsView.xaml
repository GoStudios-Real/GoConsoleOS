<UserControl x:Class="GoConsoleOS.GoConsole.Views.GameDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Hero Banner -->
        <Border Grid.Row="0" Height="280">
            <Grid>
                <Image x:Name="HeroImage" Stretch="UniformToFill" />
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#0D0D14" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid Margin="40,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="120" Height="120" CornerRadius="16"
                                Background="{StaticResource BrushBackgroundLight}" Margin="0,0,24,0"
                                VerticalAlignment="Center">
                            <Image x:Name="GameIconImage" Stretch="Uniform" Margin="8" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="GameTitleText" Text="" FontSize="42" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock x:Name="GamePlatformText" Text="" FontSize="18"
                                       Foreground="{StaticResource BrushAccentPrimary}" Margin="0,4,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Border x:Name="PlayButton" CornerRadius="8"
                                        Background="{StaticResource BrushAccentPrimary}" Padding="20,10"
                                        Cursor="Hand" MouseLeftButtonDown="Play_Click">
                                    <TextBlock Text="▶  PLAY" FontSize="18" FontWeight="Bold"
                                               Foreground="#0D0D14" HorizontalAlignment="Center" />
                                </Border>
                                <Border x:Name="BackBtn" CornerRadius="8"
                                        Background="{StaticResource BrushBackgroundCard}" Padding="16,10"
                                        Cursor="Hand" MouseLeftButtonDown="Back_Click" Margin="12,0,0,0">
                                    <TextBlock Text="BACK" FontSize="14" FontWeight="Bold"
                                               Foreground="{StaticResource BrushTextSecondary}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Details Content -->
        <ScrollViewer Grid.Row="1" Style="{StaticResource InvisibleScrollViewer}">
            <Grid Margin="40,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Panel: Stats -->
                <Border Grid.Column="0" CornerRadius="16" Background="{StaticResource BrushBackgroundLight}"
                        Padding="24" Margin="0,0,24,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock x:Name="PlaytimeText" Text="0h" FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource BrushAccentPrimary}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Played" FontSize="11"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock x:Name="LastPlayedText" Text="Never" FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Last Played" FontSize="11"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock x:Name="GenreTags" Text="--" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource BrushAccentSecondary}"
                                           HorizontalAlignment="Center" TextWrapping="Wrap" />
                                <TextBlock Text="Genres" FontSize="11"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Right Panel: Description, Achievements, Guides -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="DESCRIPTION" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,8" />
                    <TextBlock x:Name="DescriptionText" Text=""
                               FontSize="14" Foreground="{StaticResource BrushTextPrimary}"
                               TextWrapping="Wrap" Margin="0,0,0,24" />

                    <TextBlock Text="ACHIEVEMENTS" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,8" />
                    <ItemsControl x:Name="AchievementsList" Margin="0,0,0,20">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="240" Margin="4" CornerRadius="8"
                                        Background="{StaticResource BrushBackgroundLight}" Padding="10"
                                        Opacity="{Binding Opacity}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}" FontSize="16" Margin="0,0,8,0" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold"
                                                           Foreground="{StaticResource BrushTextPrimary}" />
                                                <TextBlock Text="{Binding Description}" FontSize="10"
                                                           Foreground="{StaticResource BrushTextMuted}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="RELATED GUIDES" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,8" />
                    <ItemsControl x:Name="RelatedGuidesList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="260" Margin="4" CornerRadius="10"
                                        Background="{StaticResource BrushBackgroundLight}" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="Bold"
                                                   Foreground="{StaticResource BrushAccentPrimary}" />
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold"
                                                   Foreground="{StaticResource BrushTextPrimary}"
                                                   Margin="0,4,0,4" />
                                        <TextBlock Text="{Binding Description}" FontSize="11"
                                                   Foreground="{StaticResource BrushTextMuted}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
