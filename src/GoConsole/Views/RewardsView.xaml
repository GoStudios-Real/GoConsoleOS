<UserControl x:Class="GoConsoleOS.GoConsole.Views.RewardsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="REWARDS &amp; POINTS" FontSize="28" FontWeight="Bold"
                   Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" Text="Earn points by playing, capturing screenshots, and earning achievements."
                   FontSize="14" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,20" />

        <!-- Points Summary -->
        <Border Grid.Row="2" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}" Padding="20" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock x:Name="TotalPoints" Text="1,250" FontSize="36" FontWeight="Bold"
                               Foreground="{StaticResource BrushAccentPrimary}" HorizontalAlignment="Center" />
                    <TextBlock Text="Total Points" FontSize="11" Foreground="{StaticResource BrushTextMuted}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <Border Grid.Column="1" Width="1" Background="{StaticResource BrushBackgroundCard}" Height="40" Margin="10,0" />

                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock x:Name="LevelText" Text="LEVEL 5" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center" />
                    <TextBlock Text="Player Rank" FontSize="11" Foreground="{StaticResource BrushTextMuted}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <Border Grid.Column="3" Width="1" Background="{StaticResource BrushBackgroundCard}" Height="40" Margin="10,0" />

                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                    <TextBlock x:Name="NextLevel" Text="250 pts" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center" />
                    <TextBlock Text="To Next Level" FontSize="11" Foreground="{StaticResource BrushTextMuted}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Reward Activities -->
        <ScrollViewer Grid.Row="3" Style="{StaticResource InvisibleScrollViewer}">
            <ItemsControl x:Name="RewardList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="10" Background="{StaticResource BrushBackgroundLight}"
                                Padding="14,10" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                                        Background="#0066FF33" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Icon}" FontSize="16"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold"
                                               Foreground="{StaticResource BrushTextPrimary}" />
                                    <TextBlock Text="{Binding Description}" FontSize="11"
                                               Foreground="{StaticResource BrushTextSecondary}" />
                                </StackPanel>
                                <Border Grid.Column="2" CornerRadius="6"
                                        Background="{StaticResource BrushAccentPrimary}" Padding="8,4"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Points}" FontSize="11" FontWeight="Bold"
                                               Foreground="#0D0D14" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
