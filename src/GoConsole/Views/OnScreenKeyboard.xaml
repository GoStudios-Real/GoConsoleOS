<Window x:Class="GoConsoleOS.GoConsole.Views.OnScreenKeyboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cc="clr-namespace:GoConsoleOS.GoConsole.Controls"
        Title="On-Screen Keyboard"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Overlay_Click">
    <Border x:Name="OverlayBg" Background="#88000000">
        <Border CornerRadius="16" Background="#E61A1A2E" Padding="20,16"
                Width="1040" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,40">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Input Display -->
                <Border Grid.Row="0" CornerRadius="8" Background="#0D0D14"
                        Padding="14,10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InputBox" FontSize="22" Foreground="#F0F0FF"
                                 Background="Transparent" BorderThickness="0"
                                 IsReadOnly="True" Text="" Grid.Column="0"
                                 VerticalAlignment="Center" />
                        <Border Grid.Column="1" CornerRadius="4" Background="#00C9DB33"
                                Padding="8,4" VerticalAlignment="Center">
                            <TextBlock x:Name="CharCount" Text="0" FontSize="11"
                                       Foreground="#00C9DB" FontWeight="Bold" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Row 1: Numbers -->
                <WrapPanel Grid.Row="1" x:Name="Row1Panel" HorizontalAlignment="Center" Margin="0,0,0,4" />

                <!-- Row 2: QWERTY top -->
                <WrapPanel Grid.Row="2" x:Name="Row2Panel" HorizontalAlignment="Center" Margin="0,0,0,4" />

                <!-- Row 3: QWERTY home -->
                <WrapPanel Grid.Row="3" x:Name="Row3Panel" HorizontalAlignment="Center" Margin="0,0,0,4" />

                <!-- Row 4: QWERTY bottom -->
                <WrapPanel Grid.Row="4" x:Name="Row4Panel" HorizontalAlignment="Center" Margin="0,0,0,4" />

                <!-- Row 5: Action keys -->
                <WrapPanel Grid.Row="5" HorizontalAlignment="Center" Margin="0,0,0,4">
                    <Border x:Name="ShiftKey" CornerRadius="6" Background="#1E1E32" Padding="14,10"
                            Cursor="Hand" MouseLeftButtonDown="Shift_Click" Margin="0,0,4,0"
                            BorderBrush="Transparent" BorderThickness="2">
                        <TextBlock x:Name="ShiftText" Text="⇧" FontSize="16" FontWeight="Bold"
                                   Foreground="#F0F0FF" />
                    </Border>
                    <Border x:Name="SpaceKey" CornerRadius="6" Background="#1E1E32" Padding="120,10"
                            Cursor="Hand" MouseLeftButtonDown="Space_Click" Margin="0,0,4,0"
                            BorderBrush="Transparent" BorderThickness="2">
                        <TextBlock Text="SPACE" FontSize="14" FontWeight="Bold"
                                   Foreground="#F0F0FF" />
                    </Border>
                    <Border x:Name="BackspaceKey" CornerRadius="6" Background="#1E1E32" Padding="14,10"
                            Cursor="Hand" MouseLeftButtonDown="Backspace_Click" Margin="0,0,4,0"
                            BorderBrush="Transparent" BorderThickness="2">
                        <TextBlock Text="⌫" FontSize="18" FontWeight="Bold" Foreground="#FF5252" />
                    </Border>
                    <Border x:Name="CopyKey" CornerRadius="6" Background="#1E1E32" Padding="14,10"
                            Cursor="Hand" MouseLeftButtonDown="Copy_Click" Margin="0,0,4,0"
                            BorderBrush="Transparent" BorderThickness="2">
                        <TextBlock Text="📋 COPY" FontSize="12" FontWeight="Bold" Foreground="#00C9DB" />
                    </Border>
                    <Border x:Name="PasteKey" CornerRadius="6" Background="#1E1E32" Padding="14,10"
                            Cursor="Hand" MouseLeftButtonDown="Paste_Click" Margin="0,0,4,0"
                            BorderBrush="Transparent" BorderThickness="2">
                        <TextBlock Text="📥 PASTE" FontSize="12" FontWeight="Bold" Foreground="#FFC300" />
                    </Border>
                    <Border x:Name="ClearKey" CornerRadius="6" Background="#1E1E32" Padding="14,10"
                            Cursor="Hand" MouseLeftButtonDown="Clear_Click" Margin="0,0,4,0"
                            BorderBrush="Transparent" BorderThickness="2">
                        <TextBlock Text="✕" FontSize="16" FontWeight="Bold" Foreground="#FF4D8C" />
                    </Border>
                    <Border x:Name="EnterKey" CornerRadius="6" Background="#00C9DB" Padding="20,10"
                            Cursor="Hand" MouseLeftButtonDown="Enter_Click"
                            BorderBrush="Transparent" BorderThickness="2">
                        <TextBlock Text="↵ DONE" FontSize="14" FontWeight="Bold" Foreground="#0D0D14" />
                    </Border>
                </WrapPanel>

                <!-- Footer -->
                <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <TextBlock Text="Mouse: click keys · Ctrl+K toggle · Ctrl+C/V copy-paste" FontSize="10"
                               Foreground="#555577" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <cc:ControllerHintBar>
                        <cc:ControllerHintItem Button="DPadUp" Text="Move" />
                        <cc:ControllerHintItem Button="A" Text="Press" />
                        <cc:ControllerHintItem Button="B" Text="Backspace" />
                        <cc:ControllerHintItem Button="Y" Text="Shift" />
                        <cc:ControllerHintItem Button="X" Text="Clear" />
                        <cc:ControllerHintItem Button="Start" Text="Done" />
                    </cc:ControllerHintBar>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
