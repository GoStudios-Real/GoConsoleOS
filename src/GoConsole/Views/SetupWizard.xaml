<Window x:Class="GoConsoleOS.GoConsole.Views.SetupWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GoConsoleOS Setup"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Width="640" Height="520"
        Background="{StaticResource BrushBackgroundDark}"
        Topmost="True"
        KeyDown="Window_KeyDown">
    <Border CornerRadius="16" Background="{StaticResource BrushBackgroundLight}" Padding="32" Margin="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Step Indicator -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                <Ellipse x:Name="Step1Dot" Width="10" Height="10" Fill="{StaticResource BrushAccentPrimary}" Margin="0,0,4,0" />
                <Ellipse x:Name="Step2Dot" Width="10" Height="10" Fill="{StaticResource BrushBackgroundCard}" Margin="0,0,4,0" />
                <Ellipse x:Name="Step3Dot" Width="10" Height="10" Fill="{StaticResource BrushBackgroundCard}" Margin="0,0,4,0" />
                <Ellipse x:Name="Step4Dot" Width="10" Height="10" Fill="{StaticResource BrushBackgroundCard}" Margin="0,0,4,0" />
                <Ellipse x:Name="Step5Dot" Width="10" Height="10" Fill="{StaticResource BrushBackgroundCard}" Margin="0,0,4,0" />
                <Ellipse x:Name="Step6Dot" Width="10" Height="10" Fill="{StaticResource BrushBackgroundCard}" />
            </StackPanel>

            <!-- Title -->
            <TextBlock Grid.Row="1" x:Name="StepTitle" Text="WELCOME TO GOCONSOLEOS"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource BrushAccentPrimary}"
                       HorizontalAlignment="Center" Margin="0,0,0,20" />

            <!-- Step Content -->
            <Grid Grid.Row="2">
                <!-- Step 1: Welcome -->
                <StackPanel x:Name="Step1Panel">
                    <TextBlock Text="Welcome! Let's get your console set up in a few steps."
                               FontSize="15" Foreground="{StaticResource BrushTextSecondary}"
                               TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,20" />
                    <Border CornerRadius="12" Background="{StaticResource BrushBackgroundCard}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="GoConsoleOS turns your Windows PC into a gaming console."
                                       FontSize="13" Foreground="{StaticResource BrushTextSecondary}"
                                       TextWrapping="Wrap" Margin="0,0,0,12" />
                            <TextBlock Text="You'll set up:" FontSize="13"
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,8" />
                            <TextBlock Text="  1. Your account" FontSize="13" Foreground="{StaticResource BrushTextSecondary}" />
                            <TextBlock Text="  2. Controller preferences" FontSize="13" Foreground="{StaticResource BrushTextSecondary}" />
                            <TextBlock Text="  3. Display &amp; Performance" FontSize="13" Foreground="{StaticResource BrushTextSecondary}" />
                            <TextBlock Text="  4. Theme &amp; Colors" FontSize="13" Foreground="{StaticResource BrushTextSecondary}" />
                            <TextBlock Text="  5. Game library scan" FontSize="13" Foreground="{StaticResource BrushTextSecondary}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Step 2: Account -->
                <StackPanel x:Name="Step2Panel" Visibility="Collapsed">
                    <TextBlock Text="Create or sign in to your account."
                               FontSize="15" Foreground="{StaticResource BrushTextSecondary}"
                               HorizontalAlignment="Center" Margin="0,0,0,16" />
                    <Border CornerRadius="12" Background="{StaticResource BrushBackgroundCard}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Username" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                            <TextBox x:Name="SetupUsername" FontSize="14" Padding="10,8"
                                     Background="{StaticResource BrushBackgroundCardHover}"
                                     Foreground="{StaticResource BrushTextPrimary}"
                                     BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                     Margin="0,4,0,8" />
                            <TextBlock Text="Display Name" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                            <TextBox x:Name="SetupDisplayName" FontSize="14" Padding="10,8"
                                     Background="{StaticResource BrushBackgroundCardHover}"
                                     Foreground="{StaticResource BrushTextPrimary}"
                                     BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                     Margin="0,4,0,8" />
                            <TextBlock Text="Password" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                            <PasswordBox x:Name="SetupPassword" FontSize="14" Padding="10,8"
                                          Background="{StaticResource BrushBackgroundCardHover}"
                                          Foreground="{StaticResource BrushTextPrimary}"
                                          BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                          Margin="0,4,0,12" />
                            <Border x:Name="SetupGuestBtn" CornerRadius="6"
                                    Background="{StaticResource BrushBackgroundCard}" Padding="12,8"
                                    Cursor="Hand" MouseLeftButtonDown="SkipToGuest"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="SKIP — USE GUEST" FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource BrushTextSecondary}" />
                            </Border>
                            <TextBlock x:Name="SetupAccountStatus" Text="" FontSize="12"
                                       Foreground="{StaticResource BrushError}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Step 3: Controller -->
                <StackPanel x:Name="Step3Panel" Visibility="Collapsed">
                    <TextBlock Text="Connect and test your controller."
                               FontSize="15" Foreground="{StaticResource BrushTextSecondary}"
                               HorizontalAlignment="Center" Margin="0,0,0,16" />
                    <Border CornerRadius="12" Background="{StaticResource BrushBackgroundCard}" Padding="20">
                        <StackPanel>
                            <TextBlock x:Name="ControllerStatusText" Text="No controller detected"
                                       FontSize="16" Foreground="{StaticResource BrushTextMuted}"
                                       HorizontalAlignment="Center" Margin="0,0,0,12" />
                            <Border CornerRadius="8" Background="{StaticResource BrushBackgroundCardHover}" Padding="16">
                                <StackPanel>
                                    <CheckBox x:Name="SetupVibration" Content="Enable controller vibration"
                                              IsChecked="True" Foreground="{StaticResource BrushTextPrimary}"
                                              FontSize="13" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Step 4: Display & Performance -->
                <StackPanel x:Name="Step4Panel" Visibility="Collapsed">
                    <TextBlock Text="Choose your display and performance settings."
                               FontSize="15" Foreground="{StaticResource BrushTextSecondary}"
                               HorizontalAlignment="Center" Margin="0,0,0,16" />
                    <Border CornerRadius="12" Background="{StaticResource BrushBackgroundCard}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Performance Mode" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource BrushAccentPrimary}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,16">
                                <Border x:Name="SetupPerfQuiet" CornerRadius="6"
                                        Background="{StaticResource BrushBackgroundCardHover}"
                                        Padding="16,8" Cursor="Hand" Margin="0,0,8,0"
                                        MouseLeftButtonDown="SelectPerfMode" Tag="quiet">
                                    <TextBlock Text="QUIET" FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource BrushTextPrimary}" />
                                </Border>
                                <Border x:Name="SetupPerfBalanced" CornerRadius="6"
                                        Background="{StaticResource BrushAccentPrimary}"
                                        Padding="16,8" Cursor="Hand" Margin="0,0,8,0"
                                        MouseLeftButtonDown="SelectPerfMode" Tag="balanced">
                                    <TextBlock Text="BALANCED" FontSize="12" FontWeight="Bold"
                                               Foreground="#0D0D14" />
                                </Border>
                                <Border x:Name="SetupPerfTurbo" CornerRadius="6"
                                        Background="{StaticResource BrushBackgroundCardHover}"
                                        Padding="16,8" Cursor="Hand"
                                        MouseLeftButtonDown="SelectPerfMode" Tag="turbo">
                                    <TextBlock Text="TURBO" FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource BrushTextPrimary}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Resolution" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource BrushAccentSecondary}" />
                            <ComboBox x:Name="SetupResolution" Width="200" HorizontalAlignment="Left"
                                      Background="{StaticResource BrushBackgroundCardHover}"
                                      Foreground="{StaticResource BrushTextPrimary}"
                                      FontSize="13" Margin="0,8,0,0">
                                <ComboBoxItem Content="1920x1080" Tag="1920x1080" />
                                <ComboBoxItem Content="2560x1440" Tag="2560x1440" />
                                <ComboBoxItem Content="3840x2160" Tag="3840x2160" />
                                <ComboBoxItem Content="Auto Detect" Tag="auto" IsSelected="True" />
                            </ComboBox>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Step 5: Theme -->
                <StackPanel x:Name="Step5Panel" Visibility="Collapsed">
                    <TextBlock Text="Pick your theme and accent color."
                               FontSize="15" Foreground="{StaticResource BrushTextSecondary}"
                               HorizontalAlignment="Center" Margin="0,0,0,16" />
                    <Border CornerRadius="12" Background="{StaticResource BrushBackgroundCard}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Background Theme" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border x:Name="ThemeDark" CornerRadius="6"
                                        Background="#0D0D14" Padding="16,8" Cursor="Hand"
                                        Margin="0,0,8,0" MouseLeftButtonDown="SelectTheme" Tag="dark"
                                        BorderBrush="{StaticResource BrushAccentPrimary}" BorderThickness="2">
                                    <TextBlock Text="DARK" FontSize="12" FontWeight="Bold" Foreground="#F0F0FF" />
                                </Border>
                                <Border x:Name="ThemeDarker" CornerRadius="6"
                                        Background="#050508" Padding="16,8" Cursor="Hand"
                                        Margin="0,0,8,0" MouseLeftButtonDown="SelectTheme" Tag="darker"
                                        BorderBrush="{StaticResource BrushBackgroundCard}" BorderThickness="2">
                                    <TextBlock Text="DEEPER" FontSize="12" FontWeight="Bold" Foreground="#8888AA" />
                                </Border>
                                <Border x:Name="ThemeAmber" CornerRadius="6"
                                        Background="#1A1508" Padding="16,8" Cursor="Hand"
                                        MouseLeftButtonDown="SelectTheme" Tag="amber"
                                        BorderBrush="{StaticResource BrushBackgroundCard}" BorderThickness="2">
                                    <TextBlock Text="AMBER" FontSize="12" FontWeight="Bold" Foreground="#FFD600" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Accent Color" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="AccentCyan" CornerRadius="4" Width="32" Height="32"
                                        Background="#0066FF" Cursor="Hand" Margin="0,0,6,0"
                                        MouseLeftButtonDown="SelectAccent" Tag="#0066FF"
                                        BorderThickness="2" BorderBrush="{StaticResource BrushAccentPrimary}" />
                                <Border x:Name="AccentPurple" CornerRadius="4" Width="32" Height="32"
                                        Background="#7B2DFF" Cursor="Hand" Margin="0,0,6,0"
                                        MouseLeftButtonDown="SelectAccent" Tag="#7B2DFF"
                                        BorderThickness="2" BorderBrush="Transparent" />
                                <Border x:Name="AccentPink" CornerRadius="4" Width="32" Height="32"
                                        Background="#FF4D8C" Cursor="Hand" Margin="0,0,6,0"
                                        MouseLeftButtonDown="SelectAccent" Tag="#FF4D8C"
                                        BorderThickness="2" BorderBrush="Transparent" />
                                <Border x:Name="AccentGreen" CornerRadius="4" Width="32" Height="32"
                                        Background="#00E676" Cursor="Hand" Margin="0,0,6,0"
                                        MouseLeftButtonDown="SelectAccent" Tag="#00E676"
                                        BorderThickness="2" BorderBrush="Transparent" />
                                <Border x:Name="AccentOrange" CornerRadius="4" Width="32" Height="32"
                                        Background="#FFB940" Cursor="Hand" Margin="0,0,6,0"
                                        MouseLeftButtonDown="SelectAccent" Tag="#FFB940"
                                        BorderThickness="2" BorderBrush="Transparent" />
                                <Border x:Name="AccentRed" CornerRadius="4" Width="32" Height="32"
                                        Background="#FF5252" Cursor="Hand" Margin="0,0,6,0"
                                        MouseLeftButtonDown="SelectAccent" Tag="#FF5252"
                                        BorderThickness="2" BorderBrush="Transparent" />
                                <Border x:Name="AccentBlue" CornerRadius="4" Width="32" Height="32"
                                        Background="#448AFF" Cursor="Hand"
                                        MouseLeftButtonDown="SelectAccent" Tag="#448AFF"
                                        BorderThickness="2" BorderBrush="Transparent" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Step 6: Complete -->
                <StackPanel x:Name="Step6Panel" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="ALL SET!" FontSize="32" FontWeight="Bold"
                               Foreground="{StaticResource BrushSuccess}"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="CompleteText" Text="Your console is ready. Let's scan for games."
                               FontSize="15" Foreground="{StaticResource BrushTextSecondary}"
                               HorizontalAlignment="Center" Margin="0,12,0,0"
                               TextWrapping="Wrap" />
                    <Border CornerRadius="12" Background="{StaticResource BrushBackgroundCard}" Padding="20" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock x:Name="SummaryAccount" Text="" FontSize="13"
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4" />
                            <TextBlock x:Name="SummaryController" Text="" FontSize="13"
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4" />
                            <TextBlock x:Name="SummaryDisplay" Text="" FontSize="13"
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4" />
                            <TextBlock x:Name="SummaryTheme" Text="" FontSize="13"
                                       Foreground="{StaticResource BrushTextPrimary}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Navigation Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Border x:Name="PrevBtn" CornerRadius="6"
                        Background="{StaticResource BrushBackgroundCard}" Padding="20,10"
                        Cursor="Hand" MouseLeftButtonDown="PreviousStep" Margin="0,0,12,0"
                        Visibility="Collapsed">
                    <TextBlock Text="← BACK" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextSecondary}" />
                </Border>
                <Border x:Name="NextBtn" CornerRadius="6"
                        Background="{StaticResource BrushAccentPrimary}" Padding="20,10"
                        Cursor="Hand" MouseLeftButtonDown="NextStep">
                    <TextBlock x:Name="NextBtnText" Text="GET STARTED →" FontSize="13" FontWeight="Bold"
                               Foreground="#0D0D14" />
                </Border>
            </StackPanel>

            <TextBlock Grid.Row="4" Text="Press Escape to skip setup"
                       FontSize="11" Foreground="{StaticResource BrushTextMuted}"
                       HorizontalAlignment="Center" Margin="0,8,0,0" />
        </Grid>
    </Border>
</Window>
