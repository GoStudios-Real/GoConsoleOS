<UserControl x:Class="GoConsoleOS.GoConsole.Views.AccessibilityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="ACCESSIBILITY" FontSize="28" FontWeight="Bold"
                   Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,24" />

        <Border Grid.Row="1" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}" Padding="20" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="DISPLAY" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource BrushAccentPrimary}" Margin="0,0,0,12" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="High Contrast Mode"
                               FontSize="14" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" />
                    <Border Grid.Row="0" Grid.Column="1" x:Name="HighContrastToggle"
                            CornerRadius="6" Background="{StaticResource BrushBackgroundCard}" Padding="12,4"
                            Cursor="Hand" MouseLeftButtonDown="ToggleHighContrast">
                        <TextBlock x:Name="HighContrastText" Text="OFF" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextPrimary}" />
                    </Border>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Color Filters (colorblind)"
                               FontSize="14" Foreground="{StaticResource BrushTextPrimary}" Margin="0,8,0,0" VerticalAlignment="Center" />
                    <Border Grid.Row="1" Grid.Column="1" x:Name="ColorFilterToggle"
                            CornerRadius="6" Background="{StaticResource BrushBackgroundCard}" Padding="12,4"
                            Cursor="Hand" Margin="0,8,0,0" MouseLeftButtonDown="ToggleColorFilter">
                        <TextBlock x:Name="ColorFilterText" Text="OFF" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextPrimary}" />
                    </Border>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Reduce Motion (disable animations)"
                               FontSize="14" Foreground="{StaticResource BrushTextPrimary}" Margin="0,8,0,0" VerticalAlignment="Center" />
                    <Border Grid.Row="2" Grid.Column="1" x:Name="ReduceMotionToggle"
                            CornerRadius="6" Background="{StaticResource BrushBackgroundCard}" Padding="12,4"
                            Cursor="Hand" Margin="0,8,0,0" MouseLeftButtonDown="ToggleReduceMotion">
                        <TextBlock x:Name="ReduceMotionText" Text="OFF" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextPrimary}" />
                    </Border>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Narrator (text-to-speech)"
                               FontSize="14" Foreground="{StaticResource BrushTextPrimary}" Margin="0,8,0,0" VerticalAlignment="Center" />
                    <Border Grid.Row="3" Grid.Column="1" x:Name="NarratorToggle"
                            CornerRadius="6" Background="{StaticResource BrushBackgroundCard}" Padding="12,4"
                            Cursor="Hand" Margin="0,8,0,0" MouseLeftButtonDown="ToggleNarrator">
                        <TextBlock x:Name="NarratorText" Text="OFF" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextPrimary}" />
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}" Padding="20" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="AUDIO" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource BrushWarning}" Margin="0,0,0,12" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Mono Audio"
                               FontSize="14" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" />
                    <Border Grid.Row="0" Grid.Column="1" x:Name="MonoAudioToggle"
                            CornerRadius="6" Background="{StaticResource BrushBackgroundCard}" Padding="12,4"
                            Cursor="Hand" MouseLeftButtonDown="ToggleMonoAudio">
                        <TextBlock x:Name="MonoAudioText" Text="OFF" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextPrimary}" />
                    </Border>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Visual Cue for Sounds"
                               FontSize="14" Foreground="{StaticResource BrushTextPrimary}" Margin="0,8,0,0" VerticalAlignment="Center" />
                    <Border Grid.Row="1" Grid.Column="1" x:Name="VisualSoundToggle"
                            CornerRadius="6" Background="{StaticResource BrushBackgroundCard}" Padding="12,4"
                            Cursor="Hand" Margin="0,8,0,0" MouseLeftButtonDown="ToggleVisualSound">
                        <TextBlock x:Name="VisualSoundText" Text="OFF" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextPrimary}" />
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}" Padding="20" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="TEXT &amp; NAVIGATION" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource BrushAccentSecondary}" Margin="0,0,0,12" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Larger Text"
                               FontSize="14" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" />
                    <Border Grid.Row="0" Grid.Column="1" x:Name="LargeTextToggle"
                            CornerRadius="6" Background="{StaticResource BrushBackgroundCard}" Padding="12,4"
                            Cursor="Hand" MouseLeftButtonDown="ToggleLargeText">
                        <TextBlock x:Name="LargeTextText" Text="OFF" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextPrimary}" />
                    </Border>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Controller Cursor Snap"
                               FontSize="14" Foreground="{StaticResource BrushTextPrimary}" Margin="0,8,0,0" VerticalAlignment="Center" />
                    <Border Grid.Row="1" Grid.Column="1" x:Name="CursorSnapToggle"
                            CornerRadius="6" Background="{StaticResource BrushBackgroundCard}" Padding="12,4"
                            Cursor="Hand" Margin="0,8,0,0" MouseLeftButtonDown="ToggleCursorSnap">
                        <TextBlock x:Name="CursorSnapText" Text="ON" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextPrimary}" />
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="4" Text="Accessibility settings are applied immediately."
                   FontSize="12" Foreground="{StaticResource BrushTextMuted}" Margin="0,12,0,0" />

        <Border Grid.Row="5" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}" Padding="20" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="INPUT" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource BrushSuccess}" Margin="0,0,0,12" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Pen / Stylus Support"
                               FontSize="14" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" />
                    <Border Grid.Row="0" Grid.Column="1" x:Name="PenToggle"
                            CornerRadius="6" Background="{StaticResource BrushBackgroundCard}" Padding="12,4"
                            Cursor="Hand" MouseLeftButtonDown="TogglePen">
                        <TextBlock x:Name="PenText" Text="ON" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextPrimary}" />
                    </Border>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Touchscreen Support"
                               FontSize="14" Foreground="{StaticResource BrushTextPrimary}" Margin="0,8,0,0" VerticalAlignment="Center" />
                    <Border Grid.Row="1" Grid.Column="1" x:Name="TouchToggle"
                            CornerRadius="6" Background="{StaticResource BrushBackgroundCard}" Padding="12,4"
                            Cursor="Hand" Margin="0,8,0,0" MouseLeftButtonDown="ToggleTouch">
                        <TextBlock x:Name="TouchText" Text="ON" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextPrimary}" />
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="6" Text="Pen and touchscreen let you tap, select and navigate with a stylus or your finger."
                   FontSize="12" Foreground="{StaticResource BrushTextMuted}" Margin="0,4,0,0" />
    </Grid>
</UserControl>
