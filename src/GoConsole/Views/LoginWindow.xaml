<Window x:Class="GoConsoleOS.GoConsole.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GoConsoleOS - Sign In"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Width="420" Height="560"
        Background="#0A0E1C"
        Topmost="True"
        KeyDown="Window_KeyDown">
    <Border CornerRadius="16" Background="#141A2E" Padding="32" Margin="20"
            BorderBrush="#1E2A55" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.6" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header with Logo -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="G" FontSize="32" FontWeight="Bold"
                           Foreground="#0066FF" HorizontalAlignment="Center" />
                <TextBlock Text="GoStudios" FontSize="14" FontWeight="SemiBold"
                           Foreground="#8888AA" HorizontalAlignment="Center" Margin="0,-4,0,0" />
                <TextBlock x:Name="SubtitleText" Text="Sign in to your account"
                           FontSize="13" Foreground="#555577"
                           HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>

            <!-- Tab Buttons -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" x:Name="SignInTab" CornerRadius="8,0,0,8"
                        Background="#0066FF" Padding="12,10"
                        Cursor="Hand" MouseLeftButtonDown="SwitchToSignIn">
                    <TextBlock x:Name="SignInTabText" Text="SIGN IN" FontSize="13" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center" />
                </Border>
                <Border Grid.Column="1" x:Name="SignUpTab" CornerRadius="0,8,8,0"
                        Background="#1E2A55" Padding="12,10"
                        Cursor="Hand" MouseLeftButtonDown="SwitchToSignUp">
                    <TextBlock x:Name="SignUpTabText" Text="SIGN UP" FontSize="13" FontWeight="Bold"
                               Foreground="#8888AA" HorizontalAlignment="Center" />
                </Border>
            </Grid>

            <!-- Form Content -->
            <StackPanel Grid.Row="2" x:Name="SignInPanel">
                <TextBlock Text="Username" FontSize="11" Foreground="#8888AA"
                           Margin="0,0,0,4" />
                <TextBox x:Name="LoginUsername" FontSize="14" Padding="10,10"
                         Background="#0D0D14" Foreground="#F0F0FF"
                         BorderBrush="#1E2A55" BorderThickness="1"
                         CaretBrush="#0066FF" Margin="0,0,0,12" />

                <TextBlock Text="Password" FontSize="11" Foreground="#8888AA"
                           Margin="0,0,0,4" />
                <Grid Margin="0,0,0,16">
                    <PasswordBox x:Name="LoginPassword" FontSize="14" Padding="10,10"
                                 Background="#0D0D14" Foreground="#F0F0FF"
                                 BorderBrush="#1E2A55" BorderThickness="1" />
                    <TextBox x:Name="LoginPasswordText" FontSize="14" Padding="10,10"
                             Visibility="Collapsed"
                             Background="#0D0D14" Foreground="#F0F0FF"
                             BorderBrush="#1E2A55" BorderThickness="1" />
                    <Button x:Name="LoginPasswordToggle" Content="👁" FontSize="14"
                            Width="34" Height="30" Cursor="Hand"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#555577"
                            Click="TogglePasswordVisibility" Tag="login" />
                </Grid>

                <Border x:Name="LoginBtn" CornerRadius="8"
                        Background="#0066FF" Padding="12,12"
                        Cursor="Hand" MouseLeftButtonDown="DoSignIn">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3" Color="#0066FF" />
                    </Border.Effect>
                    <TextBlock Text="SIGN IN" FontSize="14" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center" />
                </Border>

                <Border CornerRadius="8" Background="Transparent"
                        BorderBrush="#1E2A55" BorderThickness="1"
                        Padding="12,10" Margin="0,10,0,0" Cursor="Hand"
                        MouseLeftButtonDown="ContinueAsGuest">
                    <TextBlock Text="CONTINUE AS GUEST" FontSize="11" FontWeight="Bold"
                               Foreground="#555577" HorizontalAlignment="Center" />
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="2" x:Name="SignUpPanel" Visibility="Collapsed">
                <TextBlock Text="Username" FontSize="11" Foreground="#8888AA"
                           Margin="0,0,0,4" />
                <TextBox x:Name="RegUsername" FontSize="14" Padding="10,10"
                         Background="#0D0D14" Foreground="#F0F0FF"
                         BorderBrush="#1E2A55" BorderThickness="1"
                         CaretBrush="#0066FF" Margin="0,0,0,8" />

                <TextBlock Text="Display Name" FontSize="11" Foreground="#8888AA"
                           Margin="0,0,0,4" />
                <TextBox x:Name="RegDisplayName" FontSize="14" Padding="10,10"
                         Background="#0D0D14" Foreground="#F0F0FF"
                         BorderBrush="#1E2A55" BorderThickness="1"
                         CaretBrush="#0066FF" Margin="0,0,0,8" />

                <TextBlock Text="Email (optional)" FontSize="11" Foreground="#8888AA"
                           Margin="0,0,0,4" />
                <TextBox x:Name="RegEmail" FontSize="14" Padding="10,10"
                         Background="#0D0D14" Foreground="#8888AA"
                         BorderBrush="#1E2A55" BorderThickness="1"
                         CaretBrush="#0066FF" Margin="0,0,0,8" />

                <TextBlock Text="Password" FontSize="11" Foreground="#8888AA"
                           Margin="0,0,0,4" />
                <Grid Margin="0,0,0,8">
                    <PasswordBox x:Name="RegPassword" FontSize="14" Padding="10,10"
                                 Background="#0D0D14" Foreground="#F0F0FF"
                                 BorderBrush="#1E2A55" BorderThickness="1" />
                    <TextBox x:Name="RegPasswordText" FontSize="14" Padding="10,10"
                             Visibility="Collapsed"
                             Background="#0D0D14" Foreground="#F0F0FF"
                             BorderBrush="#1E2A55" BorderThickness="1" />
                    <Button x:Name="RegPasswordToggle" Content="👁" FontSize="14"
                            Width="34" Height="30" Cursor="Hand"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#555577"
                            Click="TogglePasswordVisibility" Tag="reg" />
                </Grid>

                <TextBlock Text="Confirm Password" FontSize="11" Foreground="#8888AA"
                           Margin="0,0,0,4" />
                <PasswordBox x:Name="RegPasswordConfirm" FontSize="14" Padding="10,10"
                              Background="#0D0D14" Foreground="#F0F0FF"
                              BorderBrush="#1E2A55" BorderThickness="1"
                              Margin="0,0,0,12" />

                <Border x:Name="SignUpBtn" CornerRadius="8"
                        Background="#0066FF" Padding="12,12"
                        Cursor="Hand" MouseLeftButtonDown="DoSignUp">
                    <TextBlock Text="CREATE ACCOUNT" FontSize="14" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center" />
                </Border>
            </StackPanel>

            <!-- Status / Error -->
            <TextBlock Grid.Row="3" x:Name="StatusText" Text=""
                       FontSize="11" Foreground="#FF5252"
                       HorizontalAlignment="Center" Margin="0,12,0,0"
                       TextWrapping="Wrap" />

            <Border Grid.Row="3" CornerRadius="6" Background="#1E2A55"
                    Padding="8,4" Margin="0,8,0,0" Cursor="Hand"
                    MouseLeftButtonDown="CloseWindow"
                    HorizontalAlignment="Center">
                <TextBlock Text="✕ CLOSE" FontSize="11" FontWeight="Bold"
                           Foreground="#555577" />
            </Border>

            <TextBlock Grid.Row="3" x:Name="CountdownText" Text="Continuing as guest in 8s..."
                       FontSize="10" Foreground="#3A3A55"
                       HorizontalAlignment="Center" Margin="0,4,0,0" />
        </Grid>
    </Border>
</Window>
