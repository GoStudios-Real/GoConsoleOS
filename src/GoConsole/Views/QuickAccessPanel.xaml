<Window x:Class="GoConsoleOS.GoConsole.Views.QuickAccessPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cc="clr-namespace:GoConsoleOS.GoConsole.Controls"
        Title="Quick Access"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="520" Height="660"
        WindowState="Normal">
    <Border CornerRadius="20" Background="#E61A1A2E" Padding="24" Margin="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="QUICK ACCESS" FontSize="22" FontWeight="Bold"
                       Foreground="#00C9DB" HorizontalAlignment="Center" Margin="0,0,0,20" />

            <ScrollViewer Grid.Row="1" Style="{StaticResource InvisibleScrollViewer}">
                <StackPanel>

                    <!-- Performance Mode -->
                    <Border CornerRadius="12" Background="#1E1E32" Padding="16" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="PERFORMANCE" FontSize="14" FontWeight="Bold"
                                       Foreground="#F0F0FF" />
                            <TextBlock x:Name="CurrentPerfMode" Text="Balanced" FontSize="12"
                                       Foreground="#8888AA" Margin="0,4,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="PerfQuiet" CornerRadius="6" Background="#2A2A44"
                                        Padding="12,6" Cursor="Hand" Margin="0,0,8,0"
                                        MouseLeftButtonDown="SetPerformance" Tag="quiet">
                                    <TextBlock Text="QUIET" FontSize="12" FontWeight="Bold"
                                               Foreground="#F0F0FF" />
                                </Border>
                                <Border x:Name="PerfBalanced" CornerRadius="6" Background="#00C9DB"
                                        Padding="12,6" Cursor="Hand" Margin="0,0,8,0"
                                        MouseLeftButtonDown="SetPerformance" Tag="balanced">
                                    <TextBlock Text="BALANCED" FontSize="12" FontWeight="Bold"
                                               Foreground="#0D0D14" />
                                </Border>
                                <Border x:Name="PerfTurbo" CornerRadius="6" Background="#2A2A44"
                                        Padding="12,6" Cursor="Hand"
                                        MouseLeftButtonDown="SetPerformance" Tag="turbo">
                                    <TextBlock Text="TURBO" FontSize="12" FontWeight="Bold"
                                               Foreground="#F0F0FF" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Notifications -->
                    <Border CornerRadius="12" Background="#1E1E32" Padding="16" Margin="0,0,0,8"
                            Cursor="Hand" MouseLeftButtonDown="OpenNotifications">
                        <StackPanel>
                            <TextBlock Text="NOTIFICATIONS" FontSize="14" FontWeight="Bold"
                                       Foreground="#F0F0FF" />
                            <TextBlock x:Name="NotificationStatus" Text="No new notifications"
                                       FontSize="12" Foreground="#8888AA" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- System Toggles -->
                    <Border CornerRadius="12" Background="#1E1E32" Padding="16" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="QUICK TOGGLES"
                                       FontSize="14" FontWeight="Bold" Foreground="#F0F0FF"
                                       Margin="0,0,0,8" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Wi-Fi"
                                       FontSize="13" Foreground="#8888AA" VerticalAlignment="Center" />
                            <Border Grid.Row="1" Grid.Column="1" x:Name="WifiToggle"
                                    CornerRadius="6" Background="#00E676" Padding="12,4"
                                    Cursor="Hand" MouseLeftButtonDown="ToggleWifi">
                                <TextBlock x:Name="WifiText" Text="ON" FontSize="11" FontWeight="Bold"
                                           Foreground="#0D0D14" />
                            </Border>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Bluetooth"
                                       FontSize="13" Foreground="#8888AA" VerticalAlignment="Center"
                                       Margin="0,4,0,0" />
                            <Border Grid.Row="2" Grid.Column="1" x:Name="BluetoothToggle"
                                    CornerRadius="6" Background="#2A2A44" Padding="12,4"
                                    Cursor="Hand" MouseLeftButtonDown="ToggleBluetooth" Margin="0,4,0,0">
                                <TextBlock x:Name="BluetoothText" Text="OFF" FontSize="11" FontWeight="Bold"
                                           Foreground="#F0F0FF" />
                            </Border>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Game Optimized Mode"
                                       FontSize="13" Foreground="#8888AA" VerticalAlignment="Center"
                                       Margin="0,4,0,0" />
                            <Border Grid.Row="3" Grid.Column="1" x:Name="GameOptToggle"
                                    CornerRadius="6" Background="#2A2A44" Padding="12,4"
                                    Cursor="Hand" MouseLeftButtonDown="ToggleGameOptimized" Margin="0,4,0,0">
                                <TextBlock x:Name="GameOptText" Text="OFF" FontSize="11" FontWeight="Bold"
                                           Foreground="#F0F0FF" />
                            </Border>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Night Mode"
                                       FontSize="13" Foreground="#8888AA" VerticalAlignment="Center"
                                       Margin="0,4,0,0" />
                            <Border Grid.Row="4" Grid.Column="1" x:Name="NightModeToggle"
                                    CornerRadius="6" Background="#2A2A44" Padding="12,4"
                                    Cursor="Hand" MouseLeftButtonDown="ToggleNightMode" Margin="0,4,0,0">
                                <TextBlock x:Name="NightModeText" Text="OFF" FontSize="11" FontWeight="Bold"
                                           Foreground="#F0F0FF" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Screenshots -->
                    <Border CornerRadius="12" Background="#1E1E32" Padding="16" Margin="0,0,0,8"
                            Cursor="Hand" MouseLeftButtonDown="OpenScreenshots">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📷" FontSize="20" Margin="0,0,12,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="SCREENSHOTS" FontSize="14" FontWeight="Bold"
                                           Foreground="#F0F0FF" />
                                <TextBlock x:Name="ScreenshotCount" Text="0 screenshots"
                                           FontSize="11" Foreground="#8888AA" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="→" FontSize="16"
                                       Foreground="#8888AA" />
                        </Grid>
                    </Border>

                    <!-- Mode Switch -->
                    <Border CornerRadius="12" Background="#1E1E32" Padding="16" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="MODE" FontSize="14" FontWeight="Bold"
                                       Foreground="#F0F0FF" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="GoConsoleModeToggle"
                                        CornerRadius="6" Background="#00C9DB" Padding="12,6"
                                        Cursor="Hand" MouseLeftButtonDown="SwitchToGoConsoleMode"
                                        Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock x:Name="GoConsoleModeText" Text="🎮 GOCONSOLE" FontSize="11" FontWeight="Bold"
                                                   Foreground="#0D0D14" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="DesktopModeToggle"
                                        CornerRadius="6" Background="#1E1E32" Padding="12,6"
                                        Cursor="Hand" MouseLeftButtonDown="SwitchToDesktopMode"
                                        Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock x:Name="DesktopModeText" Text="🖥️ DESKTOP" FontSize="11" FontWeight="Bold"
                                                   Foreground="#8888AA" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#D32F2F" CornerRadius="6" Padding="12,6"
                                        Cursor="Hand" MouseLeftButtonDown="ShutdownSystem">
                                    <TextBlock Text="⏻" FontSize="14" FontWeight="Bold" Foreground="White" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                <cc:ControllerHintBar>
                    <cc:ControllerHintItem Button="Guide" Text="Close" />
                </cc:ControllerHintBar>
                <TextBlock Text="or press Escape" FontSize="11" Foreground="#555577"
                           VerticalAlignment="Center" Margin="14,0,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
