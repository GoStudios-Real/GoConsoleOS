<Window x:Class="GoConsoleOS.GoConsole.Views.GuideMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cc="clr-namespace:GoConsoleOS.GoConsole.Controls"
        Title="GoConsole Mode Menu"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Overlay_Click">
    <Grid>
        <Border x:Name="OverlayBg" Background="#88000000">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,80,0,0">
                <Border CornerRadius="20" Background="#E61A1A2E" Padding="32"
                        Width="560">
                    <StackPanel>
                        <!-- Header -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="8" Background="#0066FF33" Padding="8,4"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="ModeIndicator" Text="✦ GOCONSOLE MODE" FontSize="11"
                                           FontWeight="Bold" Foreground="#0066FF" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="GOCONSOLE MODE MENU" FontSize="20" FontWeight="Bold"
                                       Foreground="#F0F0FF" HorizontalAlignment="Center" />
                            <Border Grid.Column="2" Width="28" Height="28" CornerRadius="6" Background="Transparent"
                                    Cursor="Hand" MouseLeftButtonDown="CloseMenu_Click">
                                <TextBlock Text="✕" FontSize="14" FontWeight="Bold"
                                           Foreground="#8888AA"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- GoConsole Mode -->
                            <Border Grid.Column="0" x:Name="GoConsoleModeBtn"
                                    CornerRadius="10" Background="#0066FF" Padding="12,10"
                                    Cursor="Hand" MouseLeftButtonDown="SwitchToGoConsoleMode"
                                    Margin="0,0,6,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🎮" FontSize="24" HorizontalAlignment="Center" />
                                    <TextBlock Text="GoConsole" FontSize="12" FontWeight="Bold"
                                               Foreground="#0D0D14" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    <TextBlock x:Name="GoConsoleStatus" Text="ACTIVE" FontSize="9"
                                               Foreground="#0D0D14" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Desktop Mode -->
                            <Border Grid.Column="1" x:Name="DesktopModeBtn"
                                    CornerRadius="10" Background="#1E1E32" Padding="12,10"
                                    Cursor="Hand" MouseLeftButtonDown="SwitchToDesktopMode"
                                    Margin="3,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🖥️" FontSize="24" HorizontalAlignment="Center" />
                                    <TextBlock Text="Desktop" FontSize="12" FontWeight="Bold"
                                               Foreground="#F0F0FF" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    <TextBlock x:Name="DesktopStatus" Text="Switch" FontSize="9"
                                               Foreground="#8888AA" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Rest Mode -->
                            <Border Grid.Column="2" CornerRadius="10" Background="#1E1E32" Padding="12,10"
                                    Cursor="Hand" MouseLeftButtonDown="EnterRestMode"
                                    Margin="6,0,0,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🌙" FontSize="24" HorizontalAlignment="Center" />
                                    <TextBlock Text="Rest Mode" FontSize="12" FontWeight="Bold"
                                               Foreground="#F0F0FF" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    <TextBlock Text="Sleep" FontSize="9"
                                               Foreground="#8888AA" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Resume -->
                        <Border CornerRadius="10" Background="#1E1E32" Padding="16,12"
                                Margin="0,4" Cursor="Hand"
                                MouseLeftButtonDown="Resume_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="▶" FontSize="18"
                                           Foreground="#0066FF" VerticalAlignment="Center"
                                           Margin="0,0,12,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Resume" FontSize="16" FontWeight="Bold"
                                               Foreground="#F0F0FF" />
                                    <TextBlock Text="Close menu and return to console" FontSize="12"
                                               Foreground="#8888AA" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Performance Mode -->
                        <Border x:Name="PerfMenuItem" CornerRadius="10"
                                Background="#1E1E32" Padding="16,12"
                                Margin="0,4" Cursor="Hand"
                                MouseLeftButtonDown="CyclePerfMode_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="⚡" FontSize="18"
                                           Foreground="#7B2DFF" VerticalAlignment="Center"
                                           Margin="0,0,12,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Performance Mode" FontSize="16" FontWeight="Bold"
                                               Foreground="#F0F0FF" />
                                    <TextBlock x:Name="PerfModeDesc" Text="Current: Balanced"
                                               FontSize="12" Foreground="#8888AA" />
                                </StackPanel>
                                <TextBlock x:Name="PerfModeValue" Grid.Column="2"
                                           Text="BALANCED" FontSize="12" FontWeight="Bold"
                                           Foreground="#0066FF" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Volume -->
                        <Border CornerRadius="10" Background="#1E1E32" Padding="16,12"
                                Margin="0,4" Cursor="Hand"
                                MouseLeftButtonDown="Volume_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔊" FontSize="18"
                                           Foreground="#FF4D8C" VerticalAlignment="Center"
                                           Margin="0,0,12,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Volume Control" FontSize="16" FontWeight="Bold"
                                               Foreground="#F0F0FF" />
                                    <TextBlock x:Name="VolumeDesc" Text="Current: 75%"
                                               FontSize="12" Foreground="#8888AA" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Quick Resume -->
                        <Border CornerRadius="10" Background="#1E1E32" Padding="16,12"
                                Margin="0,4" Cursor="Hand"
                                MouseLeftButtonDown="OpenQuickResume">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="⏸" FontSize="18"
                                           Foreground="#FFD600" VerticalAlignment="Center"
                                           Margin="0,0,12,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Quick Resume" FontSize="16" FontWeight="Bold"
                                               Foreground="#F0F0FF" />
                                    <TextBlock Text="View and manage suspended games" FontSize="12"
                                               Foreground="#8888AA" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="→" FontSize="16"
                                           Foreground="#8888AA" />
                            </Grid>
                        </Border>

                        <!-- Exit Menu -->
                        <Border CornerRadius="10" Background="#1E1E32" Padding="16,12"
                                Margin="0,4" Cursor="Hand"
                                MouseLeftButtonDown="OpenExitMenu">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="⏏" FontSize="18"
                                           Foreground="#107C10" VerticalAlignment="Center"
                                           Margin="0,0,12,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Exit Menu" FontSize="16" FontWeight="Bold"
                                               Foreground="#F0F0FF" />
                                    <TextBlock Text="Turn off, restart, sleep, or exit to desktop" FontSize="12"
                                               Foreground="#8888AA" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="→" FontSize="16"
                                           Foreground="#8888AA" />
                            </Grid>
                        </Border>

                        <!-- Separator -->
                        <Border Height="1" Background="#2A2A44" Margin="0,8" />

                        <!-- Profile -->
                        <Border CornerRadius="10" Background="#1E1E32" Padding="12,8"
                                Margin="0,4" Cursor="Hand"
                                MouseLeftButtonDown="OpenProfile">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                                        Background="#0066FF33" Margin="0,0,10,0">
                                    <TextBlock Text="👤" FontSize="16" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="ProfileName" Text="Player" FontSize="14" FontWeight="Bold"
                                               Foreground="#F0F0FF" />
                                    <TextBlock x:Name="ProfilePoints" Text="0 points" FontSize="11"
                                               Foreground="#8888AA" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="→" FontSize="16"
                                           Foreground="#8888AA" />
                            </Grid>
                        </Border>

                        <!-- Shutdown -->
                        <Border CornerRadius="10" Background="#1E1E32" Padding="16,12"
                                Margin="0,4" Cursor="Hand"
                                MouseLeftButtonDown="ShutdownPC_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="⏻" FontSize="18"
                                           Foreground="#FF5252" VerticalAlignment="Center"
                                           Margin="0,0,12,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Shutdown PC" FontSize="16" FontWeight="Bold"
                                               Foreground="#F0F0FF" />
                                    <TextBlock Text="Fully shut down the system" FontSize="12"
                                               Foreground="#8888AA" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Restart -->
                        <Border CornerRadius="10" Background="#1E1E32" Padding="16,12"
                                Margin="0,4" Cursor="Hand"
                                MouseLeftButtonDown="RestartPC_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="↻" FontSize="18"
                                           Foreground="#FFD600" VerticalAlignment="Center"
                                           Margin="0,0,12,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Restart PC" FontSize="16" FontWeight="Bold"
                                               Foreground="#F0F0FF" />
                                    <TextBlock Text="Restart the system" FontSize="12"
                                               Foreground="#8888AA" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Footer -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                            <cc:ControllerHintBar>
                                <cc:ControllerHintItem Button="Guide" Text="Close" />
                                <cc:ControllerHintItem Button="B" Text="Close" />
                            </cc:ControllerHintBar>
                            <TextBlock Text="or press Escape" FontSize="11" Foreground="#555577"
                                       VerticalAlignment="Center" Margin="14,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
