<Window x:Class="GoConsoleOS.GoConsole.Views.GoAiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GoAI Voice Assistant"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="520" Height="720"
        WindowState="Normal">
    <Border CornerRadius="20" Background="#F00E1024" Padding="0" Margin="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="24,20,24,0">
                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="GoAI Assistant" FontSize="22" FontWeight="Bold" Foreground="#0066FF" />
                    <TextBlock x:Name="AiStatus" Text="Built-in AI · Ready" FontSize="12"
                               Foreground="#7A80A0" Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="X" Style="{StaticResource NavButtonStyle}"
                        FontSize="13" Padding="10,4" VerticalAlignment="Top"
                        Click="CloseButton_Click" />
            </Grid>
            </Border>

            <Border Grid.Row="1" CornerRadius="16" Background="#1A1A2E" Margin="20,16,20,0" Padding="16">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="MicStatus" Text="Tap microphone to speak"
                               FontSize="13" Foreground="#7A80A0" HorizontalAlignment="Center" />
                    <Ellipse x:Name="MicIndicator" Width="60" Height="60" Fill="#1E1E32"
                             Stroke="#0066FF" StrokeThickness="2" Margin="0,12,0,0"
                             HorizontalAlignment="Center" />
                    <TextBlock x:Name="ListeningText" Text="" FontSize="14" Foreground="#0066FF"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <ScrollViewer x:Name="ChatScroll" Grid.Row="2" Margin="20,12,20,0"
                          Style="{StaticResource InvisibleScrollViewer}">
                <StackPanel x:Name="ChatLog" />
            </ScrollViewer>

            <Grid Grid.Row="3" Margin="20,12,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="MicButton" Grid.Column="0" Content="MIC" Style="{StaticResource NavButtonStyle}"
                        FontSize="13" Padding="12,10" Click="MicButton_Click"
                        Foreground="#0066FF" />
                <TextBox x:Name="InputBox" Grid.Column="1" Background="#1E1E32"
                         Foreground="#F0F0FF" CaretBrush="#F0F0FF" BorderThickness="0"
                         Padding="14,10" FontSize="14" Margin="10,0,10,0"
                         VerticalContentAlignment="Center" KeyDown="InputBox_KeyDown" />
                <Button Grid.Column="2" Content="SEND" Style="{StaticResource NavButtonStyle}"
                        FontSize="13" Padding="14,10" Click="SendButton_Click" />
            </Grid>

            <TextBlock Grid.Row="4" Text="GoAI is built-in. No API key required."
                       FontSize="10" Foreground="#4A4A6A" HorizontalAlignment="Center"
                       Margin="0,10,0,14" />
        </Grid>
    </Border>
</Window>
