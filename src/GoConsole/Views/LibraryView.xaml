<UserControl x:Class="GoConsoleOS.GoConsole.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left sidebar with filters -->
        <Border Grid.Column="0" Background="{StaticResource BrushBackgroundMedium}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
            <StackPanel Margin="16">
                <TextBlock Text="LIBRARY" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource BrushTextPrimary}"
                           Margin="0,16,0,20" />
                <Button x:Name="FilterAll" Content="ALL GAMES" Style="{StaticResource NavButtonStyle}"
                        HorizontalContentAlignment="Left" Padding="8" Click="Filter_Click" Tag="all" />
                <Button x:Name="FilterInstalled" Content="INSTALLED" Style="{StaticResource NavButtonStyle}"
                        HorizontalContentAlignment="Left" Padding="8" Click="Filter_Click" Tag="installed" />
                <Button x:Name="FilterFavorites" Content="FAVORITES" Style="{StaticResource NavButtonStyle}"
                        HorizontalContentAlignment="Left" Padding="8" Click="Filter_Click" Tag="favorites" />
                <Button x:Name="FilterSteam" Content="STEAM" Style="{StaticResource NavButtonStyle}"
                        HorizontalContentAlignment="Left" Padding="8" Click="Filter_Click" Tag="Steam" />
                <Button x:Name="FilterEpic" Content="EPIC GAMES" Style="{StaticResource NavButtonStyle}"
                        HorizontalContentAlignment="Left" Padding="8" Click="Filter_Click" Tag="Epic Games" />
                <Button x:Name="FilterXbox" Content="XBOX" Style="{StaticResource NavButtonStyle}"
                        HorizontalContentAlignment="Left" Padding="8" Click="Filter_Click" Tag="Xbox" />
                <Button x:Name="FilterGog" Content="GOG" Style="{StaticResource NavButtonStyle}"
                        HorizontalContentAlignment="Left" Padding="8" Click="Filter_Click" Tag="GOG" />
            </StackPanel>
        </Border>

        <!-- Game grid -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="LibraryTitle" Grid.Row="0" Text="ALL GAMES"
                       Style="{StaticResource SectionTitleStyle}" />

            <Border Grid.Row="1" Background="{StaticResource BrushBackgroundLight}"
                    CornerRadius="8" Margin="20,0,20,8" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="GameCountDetail" Text=""
                               FontSize="13" Foreground="{StaticResource BrushTextSecondary}"
                               VerticalAlignment="Center" />
                    <Border Grid.Column="1" CornerRadius="6" Background="{StaticResource BrushBackgroundCard}"
                            Padding="8,4" Width="150">
                        <TextBox x:Name="SearchBox" FontSize="13"
                                 Foreground="{StaticResource BrushTextPrimary}"
                                 Background="Transparent" BorderThickness="0"
                                 TextChanged="Search_Changed" />
                    </Border>
                    <Border Grid.Column="2" CornerRadius="6" Background="{StaticResource BrushBackgroundCard}"
                            Padding="8,4" Cursor="Hand" MouseLeftButtonDown="OpenKeyboard"
                            Margin="6,0,0,0">
                        <TextBlock Text="⌨" FontSize="12" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="2" Style="{StaticResource InvisibleScrollViewer}">
                <ItemsControl x:Name="GameGrid" Margin="20,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GameTileStyle}" Cursor="Hand"
                                    MouseLeftButtonDown="GameTile_Click" Tag="{Binding Id}">
                                <Grid>
                                    <Border CornerRadius="10" Background="{StaticResource BrushBackgroundCardHover}" Margin="8">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Bottom" Margin="8">
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold"
                                                           Foreground="{StaticResource BrushTextPrimary}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Platform}" FontSize="11"
                                                           Foreground="{StaticResource BrushTextMuted}" />
                                                <TextBlock Text="{Binding PlaytimeMinutes, StringFormat='{}Played: {0} min'}"
                                                           FontSize="10" Foreground="{StaticResource BrushTextMuted}" />
                                            </StackPanel>

                                            <Border VerticalAlignment="Top" HorizontalAlignment="Right"
                                                    Background="{StaticResource BrushAccentPrimary}"
                                                    CornerRadius="6" Padding="8,4" Margin="8"
                                                    Tag="{Binding Id}"
                                                    MouseLeftButtonDown="PlayButton_Click"
                                                    Cursor="Hand">
                                                <TextBlock Text="PLAY" FontSize="11" FontWeight="Bold"
                                                           Foreground="#0D0D14" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
