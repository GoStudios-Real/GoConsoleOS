<UserControl x:Class="GoConsoleOS.GoConsole.Views.PartyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="PARTY" FontSize="28" FontWeight="Bold"
                   Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" Text="Create or join a party to play with friends."
                   FontSize="14" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,20" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Create Party -->
            <Border Grid.Column="0" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}"
                    Padding="20" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="CREATE PARTY" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource BrushAccentPrimary}" Margin="0,0,0,12" />
                    <TextBlock Text="Party Name" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                    <TextBox x:Name="PartyNameBox" Text="My Party" FontSize="14"
                             Foreground="{StaticResource BrushTextPrimary}"
                             Background="{StaticResource BrushBackgroundCard}"
                             BorderThickness="0" Padding="8,6" Margin="0,4,0,12" />
                    <TextBlock Text="Max Members" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                    <Slider x:Name="MaxMembersSlider" Minimum="2" Maximum="16" Value="4"
                            Width="200" HorizontalAlignment="Left" Margin="0,4,0,4" />
                    <TextBlock x:Name="MaxMembersLabel" Text="4 members" FontSize="12"
                               Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,12" />
                    <Button Content="CREATE PARTY" FontSize="14" FontWeight="Bold"
                            Background="{StaticResource BrushAccentPrimary}" Foreground="#0D0D14"
                            BorderThickness="0" Padding="16,10" HorizontalAlignment="Left" Cursor="Hand"
                            Click="CreateParty" />
                </StackPanel>
            </Border>

            <!-- Current Party / Join -->
            <Border Grid.Column="1" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}"
                    Padding="20" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="CURRENT PARTY" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource BrushAccentPrimary}" Margin="0,0,0,12" />
                    <Border CornerRadius="8" Background="{StaticResource BrushBackgroundCard}" Padding="12">
                        <StackPanel>
                            <TextBlock x:Name="PartyStatus" Text="No active party" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextSecondary}" />
                            <ItemsControl x:Name="MemberList" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Border CornerRadius="10" Width="16" Height="16"
                                                    Background="LimeGreen" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding}" FontSize="12"
                                                       Foreground="{StaticResource BrushTextPrimary}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Button x:Name="LeavePartyBtn" Content="LEAVE PARTY" FontSize="13" FontWeight="Bold"
                            Background="{StaticResource BrushBackgroundCard}" Foreground="{StaticResource BrushTextPrimary}"
                            BorderThickness="0" Padding="16,8" Margin="0,12,0,0" HorizontalAlignment="Left"
                            Cursor="Hand" Click="LeaveParty" IsEnabled="False" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Text="Parties are local. Invite friends by sharing your party name."
                   FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,12,0,0" />
    </Grid>
</UserControl>
