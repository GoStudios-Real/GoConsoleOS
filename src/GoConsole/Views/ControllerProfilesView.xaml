<UserControl x:Class="GoConsoleOS.GoConsole.Views.ControllerProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="CONTROLLER PROFILES" FontSize="28" FontWeight="Bold"
                   Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" Text="Steam Input-style per-game controller configurations"
                   FontSize="14" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,20" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}"
                    Padding="20" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="GAMES" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10" />
                    <ScrollViewer Style="{StaticResource InvisibleScrollViewer}" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="GameList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Background="{StaticResource BrushBackgroundCard}"
                                            Padding="12" Margin="0,0,0,8" Cursor="Hand"
                                            MouseLeftButtonDown="SelectGame">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold"
                                                       Foreground="{StaticResource BrushTextPrimary}" />
                                            <TextBlock Text="{Binding Profile}" FontSize="11"
                                                       Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}" Padding="20">
                <StackPanel>
                    <TextBlock x:Name="SelectedGameText" Text="Select a game to configure"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}" />
                    <TextBlock x:Name="SelectedGameDesc" Text=""
                               FontSize="12" Foreground="{StaticResource BrushTextMuted}"
                               Margin="0,4,0,16" />

                    <ItemsControl x:Name="ProfileList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Background="{StaticResource BrushBackgroundCard}"
                                        Padding="12" Margin="0,0,0,8" Cursor="Hand"
                                        MouseLeftButtonDown="ApplyProfile">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold"
                                                       Foreground="{StaticResource BrushTextPrimary}" />
                                            <TextBlock Text="{Binding Description}" FontSize="11"
                                                       Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <TextBlock x:Name="ActiveBadge" Grid.Column="1"
                                                   Text="{Binding ActiveText}" FontSize="11" FontWeight="Bold"
                                                   Foreground="{StaticResource BrushSuccess}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
