<Window x:Class="GoConsoleOS.GoConsole.Views.CustomColorPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customize Theme"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Width="440" Height="480"
        WindowStartupLocation="CenterScreen">
    <Border CornerRadius="20" Background="#E61A1A2E" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="CUSTOMIZE THEME" FontSize="22" FontWeight="Bold"
                       Foreground="#00C9DB" HorizontalAlignment="Center" Margin="0,0,0,20" />

            <TextBlock Grid.Row="1" Text="Accent Color" FontSize="14" FontWeight="Bold"
                       Foreground="#F0F0FF" Margin="0,0,0,8" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16">
                <Border x:Name="ColorCyan" CornerRadius="8" Width="36" Height="36"
                        Background="#00C9DB" Cursor="Hand" Margin="0,0,8,0"
                        MouseLeftButtonDown="PickColor" Tag="#00C9DB" />
                <Border x:Name="ColorPurple" CornerRadius="8" Width="36" Height="36"
                        Background="#7B2DFF" Cursor="Hand" Margin="0,0,8,0"
                        MouseLeftButtonDown="PickColor" Tag="#7B2DFF" />
                <Border x:Name="ColorPink" CornerRadius="8" Width="36" Height="36"
                        Background="#FF4D8C" Cursor="Hand" Margin="0,0,8,0"
                        MouseLeftButtonDown="PickColor" Tag="#FF4D8C" />
                <Border x:Name="ColorGreen" CornerRadius="8" Width="36" Height="36"
                        Background="#00E676" Cursor="Hand" Margin="0,0,8,0"
                        MouseLeftButtonDown="PickColor" Tag="#00E676" />
                <Border x:Name="ColorOrange" CornerRadius="8" Width="36" Height="36"
                        Background="#FF9100" Cursor="Hand" Margin="0,0,8,0"
                        MouseLeftButtonDown="PickColor" Tag="#FF9100" />
                <Border x:Name="ColorRed" CornerRadius="8" Width="36" Height="36"
                        Background="#FF5252" Cursor="Hand" Margin="0,0,8,0"
                        MouseLeftButtonDown="PickColor" Tag="#FF5252" />
                <Border x:Name="ColorBlue" CornerRadius="8" Width="36" Height="36"
                        Background="#448AFF" Cursor="Hand"
                        MouseLeftButtonDown="PickColor" Tag="#448AFF" />
            </StackPanel>

            <TextBlock Grid.Row="3" Text="Background Theme" FontSize="14" FontWeight="Bold"
                       Foreground="#F0F0FF" Margin="0,0,0,8" />

            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,16">
                <Border x:Name="ThemeDark" CornerRadius="8" Padding="16,8"
                        Background="#0D0D14" Cursor="Hand" Margin="0,0,8,0"
                        MouseLeftButtonDown="SetTheme" Tag="dark">
                    <TextBlock Text="DARK" FontSize="12" FontWeight="Bold" Foreground="#F0F0FF" />
                </Border>
                <Border x:Name="ThemeDarker" CornerRadius="8" Padding="16,8"
                        Background="#050508" Cursor="Hand" Margin="0,0,8,0"
                        MouseLeftButtonDown="SetTheme" Tag="darker">
                    <TextBlock Text="DEEPER" FontSize="12" FontWeight="Bold" Foreground="#8888AA" />
                </Border>
                <Border x:Name="ThemeAmber" CornerRadius="8" Padding="16,8"
                        Background="#1A1508" Cursor="Hand"
                        MouseLeftButtonDown="SetTheme" Tag="amber">
                    <TextBlock Text="AMBER" FontSize="12" FontWeight="Bold" Foreground="#FFD600" />
                </Border>
            </StackPanel>

            <TextBlock Grid.Row="5" Text="System Color" FontSize="14" FontWeight="Bold"
                       Foreground="#F0F0FF" Margin="0,0,0,4" />

            <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,0,0,20">
                <Border CornerRadius="6" Background="#1E1E32" Padding="8">
                    <TextBox x:Name="HexInput" Text="#00C9DB" FontSize="14"
                             Foreground="#F0F0FF" Background="Transparent"
                             BorderThickness="0" Width="100"
                             TextChanged="HexInput_Changed" />
                </Border>
                <Border x:Name="PreviewColor" CornerRadius="6" Width="36" Height="28"
                        Background="#00C9DB" Margin="8,0,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Center">
                <Border CornerRadius="8" Background="#00C9DB" Padding="24,10"
                        Cursor="Hand" MouseLeftButtonDown="Apply_Click">
                    <TextBlock Text="APPLY" FontSize="14" FontWeight="Bold"
                               Foreground="#0D0D14" />
                </Border>
                <Border CornerRadius="8" Background="#2A2A44" Padding="24,10"
                        Cursor="Hand" MouseLeftButtonDown="Cancel_Click" Margin="12,0,0,0">
                    <TextBlock Text="CANCEL" FontSize="14" FontWeight="Bold"
                               Foreground="#8888AA" />
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>
