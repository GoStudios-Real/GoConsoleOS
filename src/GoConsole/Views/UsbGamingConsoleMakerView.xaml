<UserControl x:Class="GoConsoleOS.GoConsole.Views.UsbGamingConsoleMakerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="USB GAMING CONSOLE MAKER" FontSize="28" FontWeight="Bold"
                   Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" x:Name="MakerStatus" Text="Turn any USB drive into a portable gaming console"
                   FontSize="14" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,12" />

        <!-- USB Type Selector -->
        <Border Grid.Row="2" Background="{StaticResource BrushBackgroundLight}" CornerRadius="10"
                Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="SELECT USB TYPE" FontSize="12" FontWeight="Bold"
                           Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,10" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" CornerRadius="8" Padding="12" Margin="0,0,8,0" Cursor="Hand"
                            Background="{StaticResource BrushBackgroundCard}" BorderBrush="{StaticResource BrushAccentPrimary}"
                            BorderThickness="2" MouseLeftButtonDown="SelectUsbType_Click" Tag="goc">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🎮" FontSize="28" HorizontalAlignment="Center" />
                            <TextBlock Text="GoConsoleOS" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource BrushAccentPrimary}" HorizontalAlignment="Center" />
                            <TextBlock Text="Gaming Console" FontSize="11"
                                       Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" CornerRadius="8" Padding="12" Margin="4,0" Cursor="Hand"
                            Background="{StaticResource BrushBackgroundCard}" BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1" MouseLeftButtonDown="SelectUsbType_Click" Tag="androidtv">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📺" FontSize="28" HorizontalAlignment="Center" />
                            <TextBlock Text="Android TV" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center" />
                            <TextBlock Text="Google/Android TV Apps" FontSize="11"
                                       Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" CornerRadius="8" Padding="12" Margin="8,0,0,0" Cursor="Hand"
                            Background="{StaticResource BrushBackgroundCard}" BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1" MouseLeftButtonDown="SelectUsbType_Click" Tag="winplay">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🪟" FontSize="28" HorizontalAlignment="Center" />
                            <TextBlock Text="Windows Play" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center" />
                            <TextBlock Text="Win 10/11 No Boot - Just Play" FontSize="11"
                                       Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}"
                    Padding="20" Margin="0,0,12,0">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="CONNECTED USB DRIVES" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" />
                        <Border CornerRadius="6" Background="{StaticResource BrushBackgroundCard}" Padding="12,6"
                                Cursor="Hand" MouseLeftButtonDown="RefreshDrives_Click" HorizontalAlignment="Right">
                            <TextBlock Text="REFRESH" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" />
                        </Border>
                    </Grid>
                    <CheckBox x:Name="ShowInternalToggle" Content="Show internal disks (danger — wipes the drive)"
                              Foreground="{StaticResource BrushTextSecondary}" FontSize="11"
                              Checked="ShowInternal_Changed" Unchecked="ShowInternal_Changed" Margin="0,0,0,10" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                        <ItemsControl x:Name="DriveList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="DriveCard" CornerRadius="10"
                                            Background="{StaticResource BrushBackgroundCard}"
                                            Padding="14,12" Margin="0,0,0,10" Cursor="Hand"
                                            MouseLeftButtonDown="SelectDrive" Tag="{Binding}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#4CAF50" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Letter}" FontSize="18" FontWeight="Bold"
                                                           Foreground="{StaticResource BrushAccentPrimary}"
                                                           Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="Bold"
                                                           Foreground="{StaticResource BrushTextPrimary}"
                                                           VerticalAlignment="Center" />
                                                <Border CornerRadius="4" Background="#2A2A44" Padding="6,2"
                                                        Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Type}" FontSize="10" FontWeight="Bold"
                                                               Foreground="{Binding TypeBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Detail}" FontSize="12"
                                                       Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding State}" FontSize="12" FontWeight="Bold"
                                                       Foreground="{Binding StateBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}" Padding="20">
                <StackPanel>
                    <TextBlock x:Name="InstallTitle" Text="INSTALL GOCOSOLEOS" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,8" />
                    <TextBlock x:Name="InstallDescription" Text="Installs a self-contained GoConsoleOS onto the selected USB drive. The drive is renamed GoConsoleOS, gets a boot config, and launches automatically on plug-in."
                               FontSize="13" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,0,0,16" />

                    <Border CornerRadius="8" Background="{StaticResource BrushBackgroundCard}" Padding="14,10" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="SELECTED DRIVE" FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                            <TextBlock x:Name="SelectedDriveText" Text="None — choose a USB drive from the list" FontSize="15"
                                       Foreground="{StaticResource BrushTextPrimary}" FontWeight="Bold" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="InstallBtn" Content="CREATE USB" FontSize="14" FontWeight="Bold"
                            Background="{StaticResource BrushAccentPrimary}" Foreground="#0D0D14"
                            BorderThickness="0" Padding="20,10" HorizontalAlignment="Left"
                            Cursor="Hand" Click="InstallClick" IsEnabled="False" />

                    <ProgressBar x:Name="InstallProgress" Height="4" Margin="0,14,0,0" Maximum="100" Value="0"
                                 Foreground="{StaticResource BrushAccentPrimary}"
                                 Background="{StaticResource BrushBackgroundCard}" BorderThickness="0"
                                 Visibility="Collapsed" />
                    <TextBlock x:Name="InstallStatus" FontSize="12" Foreground="{StaticResource BrushTextMuted}"
                               TextWrapping="Wrap" Margin="0,8,0,0" />

                    <TextBlock x:Name="InstallWarning" Text="WARNING: All existing data on the target drive will be erased."
                               FontSize="11" Foreground="{StaticResource BrushError}" Margin="0,16,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
