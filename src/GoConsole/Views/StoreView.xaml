<UserControl x:Class="GoConsoleOS.GoConsole.Views.StoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:cc="clr-namespace:GoConsoleOS.GoConsole.Controls"
             Background="Transparent"
             Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,0,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="GOSTUDIOS STORE" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock x:Name="CatalogStatus" Text="Loading catalog..."
                           FontSize="13" Foreground="{StaticResource BrushTextSecondary}" />
            </StackPanel>
            <Border Grid.Column="1" x:Name="WishlistFilterBtn" CornerRadius="6"
                    Background="{StaticResource BrushBackgroundCard}" Padding="12,6"
                    Cursor="Hand" MouseLeftButtonDown="ToggleWishlistFilter"
                    VerticalAlignment="Center">
                <TextBlock x:Name="WishlistFilterText" Text="★ WISHLIST" FontSize="12" FontWeight="Bold"
                           Foreground="{StaticResource BrushTextSecondary}" />
            </Border>
        </Grid>

        <ScrollViewer x:Name="CatalogScroll" Grid.Row="1" Style="{StaticResource InvisibleScrollViewer}">
            <StackPanel Margin="20,0">
                <TextBlock Text="APPS" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                <ItemsControl x:Name="AppsList" Margin="0,0,0,16">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="CardBorder" Style="{StaticResource GameTileStyle}" Width="240" Height="250"
                                    Cursor="Hand" MouseLeftButtonDown="Card_Click" Tag="{Binding Id}">
                                <Grid Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0">
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"
                                                   Foreground="{StaticResource BrushTextPrimary}" />
                                        <TextBlock Text="{Binding Version}" FontSize="11"
                                                   Foreground="{StaticResource BrushAccentPrimary}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding Icon}" FontSize="40" />
                                        <TextBlock Text="{Binding Description}" FontSize="11"
                                                   Foreground="{StaticResource BrushTextMuted}"
                                                   TextWrapping="Wrap" Margin="0,6,0,0"
                                                   MaxHeight="64" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                        <Border x:Name="WishBtn"
                                                CornerRadius="6" Padding="8,4"
                                                MouseLeftButtonDown="ToggleWishlist_Click"
                                                Tag="{Binding Id}" Cursor="Hand"
                                                Background="{StaticResource BrushBackgroundCard}"
                                                Margin="0,0,6,0">
                                            <TextBlock Text="☆" FontSize="12" FontWeight="Bold"
                                                       Foreground="{StaticResource BrushTextSecondary}" />
                                        </Border>
                                        <Border x:Name="PreviewBtn" CornerRadius="6" Padding="8,4"
                                                MouseLeftButtonDown="PreviewItem_Click"
                                                Tag="{Binding Id}" Cursor="Hand"
                                                Background="{StaticResource BrushBackgroundCard}"
                                                Margin="0,0,6,0">
                                            <TextBlock Text="▶ PREVIEW" FontSize="10" FontWeight="Bold"
                                                       Foreground="{StaticResource BrushTextPrimary}" />
                                        </Border>
                                        <Border x:Name="InstallBtn"
                                                Background="{StaticResource BrushAccentPrimary}"
                                                CornerRadius="6" Padding="8,4"
                                                HorizontalAlignment="Stretch"
                                                MouseLeftButtonDown="InstallItem_Click"
                                                Tag="{Binding Id}"
                                                Cursor="Hand">
                                            <TextBlock x:Name="InstallBtnText"
                                                       Text="{Binding StatusText}" FontSize="11" FontWeight="Bold"
                                                       Foreground="#0D0D14"
                                                       HorizontalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="GAMES" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                <ItemsControl x:Name="GamesList" Margin="0,0,0,16">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="CardBorder" Style="{StaticResource GameTileStyle}" Width="240" Height="250"
                                    Cursor="Hand" MouseLeftButtonDown="Card_Click" Tag="{Binding Id}">
                                <Grid Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0">
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"
                                                   Foreground="{StaticResource BrushTextPrimary}" />
                                        <TextBlock Text="{Binding Version}" FontSize="11"
                                                   Foreground="{StaticResource BrushAccentPrimary}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding Icon}" FontSize="40" />
                                        <TextBlock Text="{Binding Description}" FontSize="11"
                                                   Foreground="{StaticResource BrushTextMuted}"
                                                   TextWrapping="Wrap" Margin="0,6,0,0"
                                                   MaxHeight="64" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                        <Border x:Name="WishBtn"
                                                CornerRadius="6" Padding="8,4"
                                                MouseLeftButtonDown="ToggleWishlist_Click"
                                                Tag="{Binding Id}" Cursor="Hand"
                                                Background="{StaticResource BrushBackgroundCard}"
                                                Margin="0,0,6,0">
                                            <TextBlock Text="☆" FontSize="12" FontWeight="Bold"
                                                       Foreground="{StaticResource BrushTextSecondary}" />
                                        </Border>
                                        <Border x:Name="PreviewBtn" CornerRadius="6" Padding="8,4"
                                                MouseLeftButtonDown="PreviewItem_Click"
                                                Tag="{Binding Id}" Cursor="Hand"
                                                Background="{StaticResource BrushBackgroundCard}"
                                                Margin="0,0,6,0">
                                            <TextBlock Text="▶ PREVIEW" FontSize="10" FontWeight="Bold"
                                                       Foreground="{StaticResource BrushTextPrimary}" />
                                        </Border>
                                        <Border x:Name="InstallBtn"
                                                Background="{StaticResource BrushAccentPrimary}"
                                                CornerRadius="6" Padding="8,4"
                                                HorizontalAlignment="Stretch"
                                                MouseLeftButtonDown="InstallItem_Click"
                                                Tag="{Binding Id}"
                                                Cursor="Hand">
                                            <TextBlock x:Name="InstallBtnText"
                                                       Text="{Binding StatusText}" FontSize="11" FontWeight="Bold"
                                                       Foreground="#0D0D14"
                                                       HorizontalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Margin="0,0,0,12" Padding="12,8" CornerRadius="10"
                        Background="{StaticResource BrushBackgroundLight}">
                    <cc:ControllerHintBar HorizontalAlignment="Center">
                        <cc:ControllerHintItem Button="DPadUp" Text="Move" />
                        <cc:ControllerHintItem Button="A" Text="Install / Play" />
                        <cc:ControllerHintItem Button="X" Text="Wishlist" />
                        <cc:ControllerHintItem Button="Y" Text="Preview" />
                        <cc:ControllerHintItem Button="B" Text="Back" />
                    </cc:ControllerHintBar>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- WebView2 preview iframe overlay -->
        <Grid x:Name="PreviewOverlay" Grid.RowSpan="2" Background="#CC0D0D14" Visibility="Collapsed">
            <Border Width="1150" Height="680" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="PreviewTitle" Text="PREVIEW" FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock x:Name="PreviewUrl" Text="" FontSize="11"
                                       Foreground="{StaticResource BrushTextMuted}" />
                        </StackPanel>
                        <Border Grid.Column="1" CornerRadius="6" Background="{StaticResource BrushAccentTertiary}"
                                Padding="14,6" Cursor="Hand" MouseLeftButtonDown="ClosePreview_Click"
                                VerticalAlignment="Center">
                            <TextBlock Text="✕ CLOSE (B)" FontSize="12" FontWeight="Bold" Foreground="White" />
                        </Border>
                    </Grid>
                    <Border Grid.Row="1" Margin="16,0,16,16" CornerRadius="10" ClipToBounds="True"
                            Background="{StaticResource BrushBackgroundCard}">
                        <wv2:WebView2 x:Name="PreviewWeb" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
