<UserControl x:Class="GoConsoleOS.GoConsole.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer Style="{StaticResource InvisibleScrollViewer}">
        <Grid Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="SETTINGS" FontSize="28" FontWeight="Bold"
                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,24" />

            <Border Grid.Row="1" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}"
                    Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="PERFORMANCE" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource BrushAccentPrimary}" />
                    <TextBlock x:Name="CurrentModeText" Text="Current: Balanced"
                               FontSize="16" Foreground="{StaticResource BrushTextSecondary}"
                               Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="QuietBtn" Content="QUIET" Style="{StaticResource NavButtonStyle}"
                                Padding="16,8" Click="PerfBtn_Click" Tag="quiet" />
                        <Button x:Name="BalancedBtn" Content="BALANCED" Style="{StaticResource NavButtonStyle}"
                                Padding="16,8" Click="PerfBtn_Click" Tag="balanced" />
                        <Button x:Name="TurboBtn" Content="TURBO" Style="{StaticResource NavButtonStyle}"
                                Padding="16,8" Click="PerfBtn_Click" Tag="turbo" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}"
                    Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="AUDIO" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource BrushWarning}" />
                    <TextBlock x:Name="VolumeText" Text="Volume: 75%"
                               FontSize="16" Foreground="{StaticResource BrushTextSecondary}"
                               Margin="0,8,0,0" />
                    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="75"
                            Width="300" HorizontalAlignment="Left" Margin="0,8,0,0"
                            ValueChanged="Volume_Changed" />
                    <TextBlock Text="SOUND EFFECTS" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,12,0,0" />
                    <CheckBox x:Name="SoundFxCheck" Content="Enable sound effects (navigation, clicks, notifications, store)"
                              IsChecked="True"
                              Foreground="{StaticResource BrushTextPrimary}"
                              FontSize="13" Margin="0,6,0,0"
                              Checked="SoundFx_Changed" Unchecked="SoundFx_Changed" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Border CornerRadius="6" Background="{StaticResource BrushBackgroundCard}" Padding="12,6"
                                Cursor="Hand" MouseLeftButtonDown="TestSound_Click">
                            <TextBlock Text="▶ TEST SOUNDS" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" />
                        </Border>
                        <Border CornerRadius="6" Background="{StaticResource BrushBackgroundCard}" Padding="12,6"
                                Cursor="Hand" MouseLeftButtonDown="PreviewStore" Margin="8,0,0,0">
                            <TextBlock Text="🛒 GOSTUDIOS STORE" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}"
                    Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="CONTROLLER" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource BrushAccentSecondary}" />
                    <TextBlock x:Name="ControllerStatus" Text="No controller detected"
                               FontSize="16" Foreground="{StaticResource BrushTextSecondary}"
                               Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Controller type:" FontSize="13"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="ControllerKindCombo" Width="230" Margin="10,0,0,0"
                                  FontSize="12" VerticalAlignment="Center"
                                  SelectionChanged="ControllerKind_Changed">
                            <ComboBoxItem Content="Auto-detect (Xbox / PS5 / Switch 2)" Tag="Auto" />
                            <ComboBoxItem Content="Xbox Controller" Tag="Xbox" />
                            <ComboBoxItem Content="PlayStation 5 (DualSense)" Tag="PlayStation5" />
                            <ComboBoxItem Content="Nintendo Switch 2" Tag="Switch2" />
                            <ComboBoxItem Content="Generic Gamepad" Tag="Generic" />
                        </ComboBox>
                    </StackPanel>
                    <CheckBox x:Name="MouseEmulationCheck" Content="Enable mouse emulation (Right Stick)"
                              IsChecked="True"
                              Foreground="{StaticResource BrushTextPrimary}"
                              FontSize="14" Margin="0,8,0,0"
                              Checked="MouseEmulation_Changed" Unchecked="MouseEmulation_Changed" />
                    <CheckBox x:Name="VibrationCheck" Content="Enable controller vibration"
                              IsChecked="True"
                              Foreground="{StaticResource BrushTextPrimary}"
                              FontSize="14" Margin="0,4,0,0"
                              Checked="Vibration_Changed" Unchecked="Vibration_Changed" />
                </StackPanel>
            </Border>

            <Border Grid.Row="4" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}"
                    Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="DISPLAY" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource BrushAccentTertiary}" />
                    <TextBlock x:Name="DisplayInfo" Text="Fullscreen mode"
                               FontSize="16" Foreground="{StaticResource BrushTextSecondary}"
                               Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Resolution:" FontSize="14"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="ResolutionCombo" Width="160"
                                  Background="{StaticResource BrushBackgroundCard}"
                                  Foreground="{StaticResource BrushTextPrimary}"
                                  FontSize="14" SelectionChanged="Resolution_Changed">
                            <ComboBoxItem Content="1920x1080" Tag="1920x1080" />
                            <ComboBoxItem Content="2560x1440" Tag="2560x1440" />
                            <ComboBoxItem Content="3840x2160" Tag="3840x2160" />
                            <ComboBoxItem Content="Auto" Tag="auto" IsSelected="True" />
                        </ComboBox>
                    </StackPanel>
                    <CheckBox x:Name="FullscreenCheck" Content="Fullscreen (borderless)"
                              IsChecked="True"
                              Foreground="{StaticResource BrushTextPrimary}"
                              FontSize="14" Margin="0,10,0,0"
                              Checked="Fullscreen_Changed" Unchecked="Fullscreen_Changed" />
                </StackPanel>
            </Border>

            <Border Grid.Row="9" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}"
                    Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="APPEARANCE" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource BrushAccentPrimary}" />
                    <TextBlock Text="Accent color"
                               FontSize="14" Foreground="{StaticResource BrushTextSecondary}"
                               Margin="0,8,0,0" />
                    <WrapPanel Margin="0,12,0,0">
                        <Border CornerRadius="14" Width="28" Height="28" Background="#00C9DB" Cursor="Hand"
                                Margin="0,0,10,10" MouseLeftButtonDown="Accent_Click" Tag="#00C9DB"
                                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" />
                        <Border CornerRadius="14" Width="28" Height="28" Background="#7B2DFF" Cursor="Hand"
                                Margin="0,0,10,10" MouseLeftButtonDown="Accent_Click" Tag="#7B2DFF"
                                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" />
                        <Border CornerRadius="14" Width="28" Height="28" Background="#FF4D8C" Cursor="Hand"
                                Margin="0,0,10,10" MouseLeftButtonDown="Accent_Click" Tag="#FF4D8C"
                                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" />
                        <Border CornerRadius="14" Width="28" Height="28" Background="#FFB900" Cursor="Hand"
                                Margin="0,0,10,10" MouseLeftButtonDown="Accent_Click" Tag="#FFB900"
                                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" />
                        <Border CornerRadius="14" Width="28" Height="28" Background="#00E676" Cursor="Hand"
                                Margin="0,0,10,10" MouseLeftButtonDown="Accent_Click" Tag="#00E676"
                                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" />
                        <Border CornerRadius="14" Width="28" Height="28" Background="#448AFF" Cursor="Hand"
                                Margin="0,0,10,10" MouseLeftButtonDown="Accent_Click" Tag="#448AFF"
                                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" />
                        <Border CornerRadius="14" Width="28" Height="28" Background="#FF5252" Cursor="Hand"
                                Margin="0,0,10,10" MouseLeftButtonDown="Accent_Click" Tag="#FF5252"
                                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" />
                        <Border CornerRadius="14" Width="28" Height="28" Background="#B388FF" Cursor="Hand"
                                Margin="0,0,10,10" MouseLeftButtonDown="Accent_Click" Tag="#B388FF"
                                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" />
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Border CornerRadius="6" Background="{StaticResource BrushBackgroundCard}" Padding="12,6"
                                Cursor="Hand" MouseLeftButtonDown="CustomAccent_Click">
                            <TextBlock Text="🎨 CUSTOM COLOR..." FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="5" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}"
                    Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="MORE SETTINGS" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource BrushAccentSecondary}" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Border CornerRadius="6" Background="{StaticResource BrushBackgroundCard}" Padding="12,6"
                                Cursor="Hand" MouseLeftButtonDown="OpenRemapping" Margin="0,0,8,0">
                            <TextBlock Text="CONTROLLER REMAPPING" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" />
                        </Border>
                        <Border CornerRadius="6" Background="{StaticResource BrushBackgroundCard}" Padding="12,6"
                                Cursor="Hand" MouseLeftButtonDown="OpenStorage" Margin="0,0,8,0">
                            <TextBlock Text="STORAGE" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" />
                        </Border>
                        <Border CornerRadius="6" Background="{StaticResource BrushBackgroundCard}" Padding="12,6"
                                Cursor="Hand" MouseLeftButtonDown="OpenAccessibility" Margin="0,0,8,0">
                            <TextBlock Text="ACCESSIBILITY" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" />
                        </Border>
                        <Border CornerRadius="6" Background="{StaticResource BrushBackgroundCard}" Padding="12,6"
                                Cursor="Hand" MouseLeftButtonDown="OpenUsbMaker">
                            <TextBlock Text="USB GAMING CONSOLE" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="6" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}"
                    Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="ACCOUNT" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource BrushAccentPrimary}" />
                    <TextBlock x:Name="AccountInfoText" Text="Loading..."
                               FontSize="14" Foreground="{StaticResource BrushTextSecondary}"
                               Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Border x:Name="ChangeNameBtn" CornerRadius="6"
                                Background="{StaticResource BrushBackgroundCard}" Padding="12,6"
                                Cursor="Hand" MouseLeftButtonDown="ChangeDisplayName"
                                Margin="0,0,8,0">
                            <TextBlock Text="EDIT DISPLAY NAME" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" />
                        </Border>
                        <Border x:Name="ChangePassBtn" CornerRadius="6"
                                Background="{StaticResource BrushBackgroundCard}" Padding="12,6"
                                Cursor="Hand" MouseLeftButtonDown="ChangePassword"
                                Margin="0,0,8,0">
                            <TextBlock Text="CHANGE PASSWORD" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" />
                        </Border>
                        <Border x:Name="SignOutBtn" CornerRadius="6"
                                Background="#FF5252" Padding="12,6"
                                Cursor="Hand" MouseLeftButtonDown="SignOut">
                            <TextBlock Text="SIGN OUT" FontSize="11" FontWeight="Bold"
                                       Foreground="White" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="7" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="ABOUT" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}" />
                    <TextBlock x:Name="AboutText" Text="GoConsoleOS v1.4.0"
                               FontSize="14" Foreground="{StaticResource BrushTextSecondary}"
                               Margin="0,8,0,0" />
                    <TextBlock x:Name="SystemInfoText" Text=""
                               FontSize="13" Foreground="{StaticResource BrushTextMuted}"
                               Margin="0,4,0,0" />
                    <TextBlock Text="Console Mode for Windows 11. Built by GoStudios."
                               FontSize="13" Foreground="{StaticResource BrushTextMuted}"
                               Margin="0,4,0,0" />
                    <TextBlock Text="Supported CPUs: Intel Core i5 / i7 / i9, AMD Ryzen 3 / 5 / 7 / 9"
                               FontSize="13" Foreground="{StaticResource BrushTextMuted}"
                               Margin="0,4,0,0" />
                    <TextBlock Text="GoConsoleOS™ and the GoConsoleOS logo are trademarks of GoStudios. © 2026 GoStudios. All rights reserved."
                               FontSize="12" Foreground="{StaticResource BrushTextMuted}"
                               TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Row="8" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="WALLPAPER" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource BrushAccentPrimary}" />
                    <TextBlock x:Name="WallpaperInfo" Text="Default"
                               FontSize="14" Foreground="{StaticResource BrushTextSecondary}"
                               Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Border CornerRadius="6" Background="{StaticResource BrushBackgroundCard}" Padding="14,8"
                                Cursor="Hand" MouseLeftButtonDown="Wallpaper_Click" Tag="default"
                                Margin="0,0,8,0">
                            <TextBlock Text="MIDNIGHT" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" />
                        </Border>
                        <Border CornerRadius="6" Background="{StaticResource BrushBackgroundCard}" Padding="14,8"
                                Cursor="Hand" MouseLeftButtonDown="Wallpaper_Click" Tag="aurora"
                                Margin="0,0,8,0">
                            <TextBlock Text="AURORA" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" />
                        </Border>
                        <Border CornerRadius="6" Background="{StaticResource BrushBackgroundCard}" Padding="14,8"
                                Cursor="Hand" MouseLeftButtonDown="Wallpaper_Click" Tag="minimal"
                                Margin="0,0,8,0">
                            <TextBlock Text="MINIMAL" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" />
                        </Border>
                        <Border CornerRadius="6" Background="{StaticResource BrushBackgroundCard}" Padding="14,8"
                                Cursor="Hand" MouseLeftButtonDown="SetCustomWallpaper">
                            <TextBlock Text="SET CUSTOM IMAGE..." FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource BrushAccentPrimary}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        <Border Grid.Row="10" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}"
            Padding="20">
            <StackPanel>
                <TextBlock Text="LOCK SCREEN &amp; SECURITY" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource BrushError}" />
                <TextBlock x:Name="PinStatusText" Text="No PIN set - lock screen disabled"
                           FontSize="14" Foreground="{StaticResource BrushTextSecondary}"
                           Margin="0,8,0,0" />
                <TextBlock Text="Set a 4-digit PIN to enable the lock screen (Ctrl+L to lock)"
                           FontSize="13" Foreground="{StaticResource BrushTextMuted}"
                           Margin="0,4,0,12" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBox x:Name="PinInput" MaxLength="4" Width="120" FontSize="16"
                             Background="{StaticResource BrushBackgroundCard}"
                             Foreground="{StaticResource BrushTextPrimary}"
                             BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                             Padding="8,6" VerticalAlignment="Center"
                             PreviewTextInput="PinInput_PreviewTextInput"
                             KeyDown="PinInput_KeyDown" />
                    <Border CornerRadius="6" Background="{StaticResource BrushAccentPrimary}" Padding="12,6"
                            Cursor="Hand" MouseLeftButtonDown="SetPin_Click" Margin="8,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="SET PIN" FontSize="11" FontWeight="Bold"
                                   Foreground="#0D0D14" />
                    </Border>
                    <Border CornerRadius="6" Background="{StaticResource BrushBackgroundCard}" Padding="12,6"
                            Cursor="Hand" MouseLeftButtonDown="ClearPin_Click" Margin="8,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="ClearPinBtnText" Text="REMOVE PIN" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextPrimary}" />
                    </Border>
                </StackPanel>
                <CheckBox x:Name="AutoLockCheck" Content="Auto-lock after inactivity"
                          Foreground="{StaticResource BrushTextPrimary}" FontSize="14"
                          Margin="0,6,0,6" IsChecked="False" Checked="AutoLock_Changed" Unchecked="AutoLock_Changed" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Lock after:" FontSize="13"
                               Foreground="{StaticResource BrushTextSecondary}"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="LockTimeoutCombo" Width="120" Margin="10,0,0,0"
                              FontSize="12" VerticalAlignment="Center"
                              SelectionChanged="LockTimeout_Changed">
                        <ComboBoxItem Content="1 minute" Tag="1" />
                        <ComboBoxItem Content="5 minutes" Tag="5" />
                        <ComboBoxItem Content="15 minutes" Tag="15" />
                        <ComboBoxItem Content="30 minutes" Tag="30" />
                        <ComboBoxItem Content="60 minutes" Tag="60" />
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
