<Window x:Class="GoConsoleOS.GoConsole.Views.ExitMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cc="clr-namespace:GoConsoleOS.GoConsole.Controls"
        Title="Exit GoConsole"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Overlay_Click">
    <Grid>
        <Border x:Name="OverlayBg" Background="#99000000">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border CornerRadius="20" Background="#F20B0B14" Padding="36" Width="620">
                    <StackPanel>
                        <!-- Header -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="8" Background="#107C10" Padding="10,5"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="●" FontSize="10" Foreground="White"
                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="XBOX MODE" FontSize="11" FontWeight="Bold"
                                               Foreground="White" />
                                </StackPanel>
                            </Border>
                            <TextBlock Grid.Column="1" Text="EXIT MENU" FontSize="22" FontWeight="Bold"
                                       Foreground="#F0F0FF" HorizontalAlignment="Center" />
                            <Border Grid.Column="2" Width="28" Height="28" CornerRadius="6" Background="Transparent"
                                    Cursor="Hand" MouseLeftButtonDown="CloseMenu_Click">
                                <TextBlock Text="✕" FontSize="14" FontWeight="Bold"
                                           Foreground="#8888AA"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>

                        <!-- Exit to Desktop -->
                        <Border CornerRadius="10" Background="#107C10" Padding="18,14"
                                Margin="0,4" Cursor="Hand"
                                MouseLeftButtonDown="ExitToDesktop_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🖥️" FontSize="22"
                                           VerticalAlignment="Center" Margin="0,0,14,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Exit to Desktop" FontSize="17" FontWeight="Bold"
                                               Foreground="White" />
                                    <TextBlock Text="Leave console mode and return to Windows"
                                               FontSize="12" Foreground="#B8E8B8" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="→" FontSize="16" Foreground="#B8E8B8"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Shut Down Console -->
                        <Border CornerRadius="10" Background="#1E1E32" Padding="18,14"
                                Margin="0,4" Cursor="Hand"
                                MouseLeftButtonDown="Shutdown_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="⏻" FontSize="22" Foreground="#FF5252"
                                           VerticalAlignment="Center" Margin="0,0,14,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Turn Off Console" FontSize="17" FontWeight="Bold"
                                               Foreground="#F0F0FF" />
                                    <TextBlock Text="Shut down the system completely"
                                               FontSize="12" Foreground="#8888AA" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="→" FontSize="16" Foreground="#8888AA"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Restart Console -->
                        <Border CornerRadius="10" Background="#1E1E32" Padding="18,14"
                                Margin="0,4" Cursor="Hand"
                                MouseLeftButtonDown="Restart_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="↻" FontSize="22" Foreground="#FFD600"
                                           VerticalAlignment="Center" Margin="0,0,14,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Restart Console" FontSize="17" FontWeight="Bold"
                                               Foreground="#F0F0FF" />
                                    <TextBlock Text="Reboot the system"
                                               FontSize="12" Foreground="#8888AA" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="→" FontSize="16" Foreground="#8888AA"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Sleep Mode -->
                        <Border CornerRadius="10" Background="#1E1E32" Padding="18,14"
                                Margin="0,4" Cursor="Hand"
                                MouseLeftButtonDown="Sleep_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🌙" FontSize="22" Foreground="#0066FF"
                                           VerticalAlignment="Center" Margin="0,0,14,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Sleep Mode" FontSize="17" FontWeight="Bold"
                                               Foreground="#F0F0FF" />
                                    <TextBlock Text="Suspend the system to save power"
                                               FontSize="12" Foreground="#8888AA" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="→" FontSize="16" Foreground="#8888AA"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Resume -->
                        <Border CornerRadius="10" Background="#1E1E32" Padding="18,14"
                                Margin="0,4" Cursor="Hand"
                                MouseLeftButtonDown="Resume_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="▶" FontSize="22" Foreground="#00E676"
                                           VerticalAlignment="Center" Margin="0,0,14,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Resume" FontSize="17" FontWeight="Bold"
                                               Foreground="#F0F0FF" />
                                    <TextBlock Text="Stay in GoConsoleOS"
                                               FontSize="12" Foreground="#8888AA" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="→" FontSize="16" Foreground="#8888AA"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Footer -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                            <cc:ControllerHintBar>
                                <cc:ControllerHintItem Button="Guide" Text="Close" />
                                <cc:ControllerHintItem Button="B" Text="Cancel" />
                            </cc:ControllerHintBar>
                            <TextBlock Text="or press Escape" FontSize="11" Foreground="#555577"
                                       VerticalAlignment="Center" Margin="14,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
