<UserControl x:Class="GoConsoleOS.GoConsole.Views.QuickResumeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="QUICK RESUME" FontSize="28" FontWeight="Bold"
                   Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" Text="Suspended games ready to resume instantly."
                   FontSize="14" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,20" />

        <ScrollViewer Grid.Row="2" Style="{StaticResource InvisibleScrollViewer}">
            <ItemsControl x:Name="ResumeList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="12" Background="{StaticResource BrushBackgroundLight}"
                                Padding="12" Margin="0,0,12,12" Width="240"
                                Cursor="Hand" MouseLeftButtonDown="ResumeGame" Tag="{Binding Title}">
                            <StackPanel>
                                <Border CornerRadius="8" Height="120"
                                        Background="{StaticResource BrushBackgroundCard}" Margin="0,0,0,10">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Icon}" FontSize="36" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Platform}" FontSize="11"
                                           Foreground="{StaticResource BrushTextMuted}" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Border CornerRadius="4" Background="#0066FF33" Padding="6,3">
                                        <TextBlock Text="{Binding Status}" FontSize="9" FontWeight="Bold"
                                                   Foreground="{StaticResource BrushAccentPrimary}" />
                                    </Border>
                                    <Border CornerRadius="4" Background="{StaticResource BrushBackgroundCard}"
                                            Padding="6,3" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding SavedAt}" FontSize="9"
                                                   Foreground="{StaticResource BrushTextSecondary}" />
                                    </Border>
                                </StackPanel>
                                <Button Content="▶ RESUME" FontSize="12" FontWeight="Bold"
                                        Background="{StaticResource BrushAccentPrimary}"
                                        Foreground="#0D0D14" BorderThickness="0"
                                        Padding="0,8" Margin="0,8,0,0" Cursor="Hand"
                                        Tag="{Binding Title}" Click="ResumeGameBtn" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
