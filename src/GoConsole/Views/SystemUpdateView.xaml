<UserControl x:Class="GoConsoleOS.GoConsole.Views.SystemUpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="SYSTEM UPDATE" FontSize="28" FontWeight="Bold"
                   Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" x:Name="UpdateStatus" Text="Check for the latest GoConsoleOS update"
                   FontSize="14" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,20" />

        <Border Grid.Row="2" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}" Padding="20" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Current Version" FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                        <TextBlock x:Name="CurrentVersionText" Text="v1.4.0" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextPrimary}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="CheckUpdatesBtn" Content="CHECK FOR UPDATES" FontSize="14" FontWeight="Bold"
                                Background="{StaticResource BrushAccentPrimary}" Foreground="#0D0D14"
                                BorderThickness="0" Padding="20,10" Cursor="Hand" Click="CheckUpdates" />
                    </StackPanel>
                </Grid>

                <Border x:Name="UpdateCard" CornerRadius="10" Background="{StaticResource BrushBackgroundCard}"
                        Padding="16" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔃" FontSize="20" Margin="0,0,10,0" />
                            <StackPanel>
                                <TextBlock x:Name="UpdateTitle" Text="" FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource BrushTextPrimary}" />
                                <TextBlock x:Name="UpdateDetail" Text="" FontSize="12"
                                           Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                        <ProgressBar x:Name="UpdateProgress" Height="6" Margin="0,14,0,0" Maximum="100" Value="0"
                                     Foreground="{StaticResource BrushAccentPrimary}"
                                     Background="{StaticResource BrushBackgroundLight}"
                                     BorderThickness="0" />
                        <TextBlock x:Name="UpdateProgressText" Text="" FontSize="11"
                                   Foreground="{StaticResource BrushTextSecondary}" Margin="0,6,0,0" />
                        <Button x:Name="InstallBtn" Content="DOWNLOAD &amp; INSTALL" FontSize="14" FontWeight="Bold"
                                Background="{StaticResource BrushSuccess}" Foreground="#0D0D14"
                                BorderThickness="0" Padding="20,10" Margin="0,12,0,0" HorizontalAlignment="Left"
                                Cursor="Hand" Click="InstallUpdate" />
                        <Button x:Name="ApplyBtn" Content="APPLY UPDATE &amp; RESTART" FontSize="14" FontWeight="Bold"
                                Background="{StaticResource BrushWarning}" Foreground="#0D0D14"
                                BorderThickness="0" Padding="20,10" Margin="0,12,0,0" HorizontalAlignment="Left"
                                Cursor="Hand" Click="ApplyUpdate" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}" Padding="20">
            <StackPanel>
                <TextBlock Text="UPDATE HISTORY" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10" />
                <ScrollViewer Style="{StaticResource InvisibleScrollViewer}" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="HistoryList" />
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
