<UserControl x:Class="GoConsoleOS.GoConsole.Views.GameStatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="GAME STATS HUB" FontSize="28" FontWeight="Bold"
                   Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" Text="Track playtime, achievements, and progress per game."
                   FontSize="14" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,20" />

        <ScrollViewer Grid.Row="2" Style="{StaticResource InvisibleScrollViewer}">
            <ItemsControl x:Name="StatsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="12" Background="{StaticResource BrushBackgroundLight}"
                                Padding="16,12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="8"
                                        Background="{StaticResource BrushBackgroundCard}" Margin="0,0,14,0">
                                    <TextBlock Text="{Binding Icon}" FontSize="24"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold"
                                               Foreground="{StaticResource BrushTextPrimary}" />
                                    <TextBlock Text="{Binding Platform}" FontSize="11"
                                               Foreground="{StaticResource BrushTextMuted}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="⏱" FontSize="11" Foreground="{StaticResource BrushAccentPrimary}"
                                                   Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding Playtime}" FontSize="11"
                                                   Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,12,0" />
                                        <TextBlock Text="★" FontSize="11" Foreground="#FFD600"
                                                   Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding Achievements}" FontSize="11"
                                                   Foreground="{StaticResource BrushTextSecondary}" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Grid.Column="2" CornerRadius="6"
                                        Background="{StaticResource BrushAccentPrimary}" Padding="10,6"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Completion}" FontSize="11" FontWeight="Bold"
                                               Foreground="#0D0D14" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
