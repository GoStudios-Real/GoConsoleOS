<UserControl x:Class="GoConsoleOS.GoConsole.Views.DiscordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="DISCORD" FontSize="28" FontWeight="Bold"
                       Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" />
            <Border CornerRadius="4" Background="{StaticResource BrushBackgroundCard}" Padding="8,3"
                    VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock x:Name="StatusChip" Text="OFFLINE" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource BrushTextMuted}" />
            </Border>
        </StackPanel>

        <Border Grid.Row="1" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}"
                Padding="16,10" Margin="0,12,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="TOKEN" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" />
                <TextBlock x:Name="TokenDisplayText" Text="Not set" FontSize="12"
                           Foreground="{StaticResource BrushTextMuted}" Margin="10,0,0,0" VerticalAlignment="Center" />
                <Border CornerRadius="6" Background="{StaticResource BrushBackgroundCard}" Padding="12,5"
                        Cursor="Hand" MouseLeftButtonDown="ChangeToken_Click" Margin="10,0,0,0">
                    <TextBlock Text="CHANGE" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}" />
                </Border>
                <Border CornerRadius="6" Background="{StaticResource BrushAccentPrimary}" Padding="12,5"
                        Cursor="Hand" MouseLeftButtonDown="KeyButton_Click" Margin="10,0,0,0">
                    <TextBlock Text="🔑 KEY" FontSize="11" FontWeight="Bold"
                               Foreground="#0D0D14" />
                </Border>
                <Border CornerRadius="6" Background="{StaticResource BrushBackgroundCard}" Padding="12,5"
                        Cursor="Hand" MouseLeftButtonDown="CreateToken_Click" Margin="10,0,0,0">
                    <TextBlock Text="CREATE TOKEN" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource BrushAccentSecondary}" />
                </Border>
                <ComboBox x:Name="TokenTypeCombo" Width="110" Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center">
                    <ComboBoxItem Content="Bot" />
                    <ComboBoxItem Content="User OAuth" />
                </ComboBox>
                <Button x:Name="ConnectBtn" Content="CONNECT" FontSize="12" FontWeight="Bold"
                        Background="{StaticResource BrushAccentPrimary}" Foreground="#0D0D14"
                        BorderThickness="0" Padding="16,6" Margin="12,0,0,0" Cursor="Hand" Click="Connect_Click" />
                <Button x:Name="DisconnectBtn" Content="DISCONNECT" FontSize="12" FontWeight="Bold"
                        Background="{StaticResource BrushBackgroundCard}" Foreground="{StaticResource BrushTextSecondary}"
                        BorderThickness="0" Padding="16,6" Margin="8,0,0,0" Cursor="Hand" Click="Disconnect_Click"
                        Visibility="Collapsed" />
                <TextBlock x:Name="ConnStatusText" Text="Idle" FontSize="12"
                           Foreground="{StaticResource BrushTextSecondary}" Margin="14,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*" />
                <ColumnDefinition Width="1.0*" />
                <ColumnDefinition Width="1.6*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}"
                    Padding="14" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="SERVERS" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource BrushAccentSecondary}" Margin="0,0,0,8" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ServersList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Background="{StaticResource BrushBackgroundCard}"
                                            Padding="10,8" Margin="0,0,0,6" Cursor="Hand"
                                            MouseLeftButtonDown="SelectGuild" Tag="{Binding}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#5865F2" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="30" Height="30" CornerRadius="15"
                                                    Background="#5865F2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Initial}" FontSize="13" FontWeight="Bold"
                                                           Foreground="White" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold"
                                                       Foreground="{StaticResource BrushTextPrimary}"
                                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}"
                    Padding="14" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock x:Name="TabChannels" Text="CHANNELS" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource BrushAccentSecondary}" Cursor="Hand"
                                   MouseLeftButtonDown="Tab_Click" Tag="channels" />
                        <TextBlock x:Name="TabFriends" Text="FRIENDS" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextSecondary}" Cursor="Hand"
                                   MouseLeftButtonDown="Tab_Click" Tag="friends" Margin="16,0,0,0" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ChannelsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="10,7" Margin="0,0,0,4" Cursor="Hand"
                                            MouseLeftButtonDown="SelectChannel" Tag="{Binding}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="category">
                                                        <Setter Property="Cursor" Value="Arrow" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#2E3350" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}" FontSize="12" Margin="0,0,8,0"
                                                       VerticalAlignment="Center" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="12"
                                                           Foreground="{Binding TextBrush}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="10"
                                                           Foreground="{StaticResource BrushTextMuted}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <Button x:Name="AddFriendBtn" Content="+ ADD FRIEND" FontSize="12" FontWeight="Bold"
                                Background="{StaticResource BrushAccentSecondary}" Foreground="White"
                                BorderThickness="0" Padding="14,6" HorizontalAlignment="Left" Margin="0,0,0,8"
                                Cursor="Hand" Click="AddFriend_Click" Visibility="Collapsed" />
                        <TextBlock x:Name="VoiceChannelInfo" Text="Select a voice channel to call"
                                   FontSize="11" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" />
                        <Button x:Name="JoinCallBtn" Content="🔊 JOIN CALL" FontSize="12" FontWeight="Bold"
                                Background="{StaticResource BrushAccentSecondary}" Foreground="White"
                                BorderThickness="0" Padding="14,6" HorizontalAlignment="Left" Margin="0,8,0,0"
                                Cursor="Hand" Click="JoinCall_Click" IsEnabled="False" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="MESSAGES" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource BrushAccentSecondary}" Margin="0,0,0,8" />
                    <ScrollViewer x:Name="MessagesScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="MessagesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,7">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Author}" FontSize="13" FontWeight="Bold"
                                                       Foreground="#7B2DFF" />
                                            <TextBlock Text="{Binding Time}" FontSize="11"
                                                       Foreground="{StaticResource BrushTextMuted}" Margin="8,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Content}" FontSize="13"
                                                   Foreground="{StaticResource BrushTextPrimary}"
                                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="8" Background="{StaticResource BrushBackgroundCard}"
                                Padding="12,8" Cursor="Hand" MouseLeftButtonDown="Keyboard_Click" Margin="0,0,8,0">
                            <TextBlock Text="⌨" FontSize="14" Foreground="{StaticResource BrushTextPrimary}" />
                        </Border>
                        <TextBox x:Name="MessageInput" Grid.Column="1" FontSize="14" Padding="10,7"
                                 Background="{StaticResource BrushBackgroundCard}"
                                 Foreground="{StaticResource BrushTextPrimary}" BorderThickness="0"
                                 CaretBrush="{StaticResource BrushTextPrimary}" Cursor="IBeam" />
                        <Button Grid.Column="2" Content="SEND" FontSize="12" FontWeight="Bold"
                                Background="{StaticResource BrushAccentPrimary}" Foreground="#0D0D14"
                                BorderThickness="0" Padding="16,7" Margin="8,0,0,0" Cursor="Hand" Click="Send_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="VoiceBar" Grid.Row="3" CornerRadius="12" Background="#241B3E"
                Padding="16,10" Margin="0,14,0,0" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔊 IN CALL" FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource BrushAccentSecondary}" VerticalAlignment="Center" />
                <TextBlock x:Name="CallInfoText" Text="" FontSize="13"
                           Foreground="{StaticResource BrushTextPrimary}" Margin="14,0,0,0" VerticalAlignment="Center" />
                <TextBlock x:Name="VoiceMembersText" Text="" FontSize="12"
                           Foreground="{StaticResource BrushTextSecondary}" Margin="14,0,0,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Button Content="LEAVE CALL" FontSize="12" FontWeight="Bold"
                        Background="#E53935" Foreground="White" BorderThickness="0" Padding="14,6"
                        HorizontalAlignment="Right" Margin="20,0,0,0" Cursor="Hand" Click="LeaveCall_Click" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
