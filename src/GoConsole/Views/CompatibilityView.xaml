<UserControl x:Class="GoConsoleOS.GoConsole.Views.CompatibilityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="GAME COMPATIBILITY" FontSize="28" FontWeight="Bold"
                   Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" Text="Deck Verified-style compatibility ratings for your library"
                   FontSize="14" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,20" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16">
            <Border CornerRadius="8" Background="#16221A" Padding="14,8" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✓" FontSize="14" FontWeight="Bold" Foreground="#4ADE80"
                               Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Verified" FontSize="13" FontWeight="Bold" Foreground="#4ADE80" />
                </StackPanel>
            </Border>
            <Border CornerRadius="8" Background="#221E14" Padding="14,8" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="◐" FontSize="14" FontWeight="Bold" Foreground="#FBBF24"
                               Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Playable" FontSize="13" FontWeight="Bold" Foreground="#FBBF24" />
                </StackPanel>
            </Border>
            <Border CornerRadius="8" Background="#221614" Padding="14,8" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="#F87171"
                               Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Unsupported" FontSize="13" FontWeight="Bold" Foreground="#F87171" />
                </StackPanel>
            </Border>
            <Border CornerRadius="8" Background="{StaticResource BrushBackgroundCard}" Padding="14,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="?" FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextMuted}"
                               Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Unknown" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextMuted}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="3" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}" Padding="20">
            <StackPanel>
                <TextBlock Text="YOUR LIBRARY" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10" />
                <ScrollViewer Style="{StaticResource InvisibleScrollViewer}" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="CompatibilityList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Background="{StaticResource BrushBackgroundCard}"
                                        Padding="14" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold"
                                                       Foreground="{StaticResource BrushTextPrimary}" />
                                            <TextBlock Text="{Binding Platform}" FontSize="11"
                                                       Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" CornerRadius="8" Padding="12,6"
                                                Background="{Binding BadgeBrush}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Badge}" FontSize="12" FontWeight="Bold"
                                                       Foreground="{Binding BadgeTextBrush}"
                                                       HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
