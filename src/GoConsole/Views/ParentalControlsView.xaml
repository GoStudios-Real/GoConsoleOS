<UserControl x:Class="GoConsoleOS.GoConsole.Views.ParentalControlsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="FAMILY &amp; PARENTAL CONTROLS" FontSize="28" FontWeight="Bold"
                   Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" Text="Manage restrictions and content filters for your console."
                   FontSize="14" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,20" />

        <ScrollViewer Grid.Row="2" Style="{StaticResource InvisibleScrollViewer}">
            <StackPanel>
                <!-- PIN Lock -->
                <Border CornerRadius="12" Background="{StaticResource BrushBackgroundLight}" Padding="16" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PIN Lock" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock Text="Require PIN to access settings, store, or launch games" FontSize="11"
                                       Foreground="{StaticResource BrushTextSecondary}" />
                        </StackPanel>
                        <Border Grid.Column="1" x:Name="PinToggle" CornerRadius="6"
                                Background="{StaticResource BrushBackgroundCard}" Padding="16,6"
                                Cursor="Hand" MouseLeftButtonDown="TogglePinLock">
                            <TextBlock x:Name="PinText" Text="OFF" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Content Filters -->
                <Border CornerRadius="12" Background="{StaticResource BrushBackgroundLight}" Padding="16" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Content Filters" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,8" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Mature Games (18+)" FontSize="12"
                                       Foreground="{StaticResource BrushTextSecondary}" Width="200" VerticalAlignment="Center" />
                            <Border x:Name="MatureToggle" CornerRadius="6"
                                    Background="{StaticResource BrushBackgroundCard}" Padding="12,4"
                                    Cursor="Hand" MouseLeftButtonDown="ToggleMature">
                                <TextBlock x:Name="MatureText" Text="BLOCKED" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource BrushTextPrimary}" />
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Store Purchases" FontSize="12"
                                       Foreground="{StaticResource BrushTextSecondary}" Width="200" VerticalAlignment="Center" />
                            <Border x:Name="PurchasesToggle" CornerRadius="6"
                                    Background="{StaticResource BrushBackgroundCard}" Padding="12,4"
                                    Cursor="Hand" MouseLeftButtonDown="TogglePurchases">
                                <TextBlock x:Name="PurchasesText" Text="ALLOWED" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource BrushTextPrimary}" />
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Multiplayer / Online" FontSize="12"
                                       Foreground="{StaticResource BrushTextSecondary}" Width="200" VerticalAlignment="Center" />
                            <Border x:Name="MultiplayerToggle" CornerRadius="6"
                                    Background="{StaticResource BrushBackgroundCard}" Padding="12,4"
                                    Cursor="Hand" MouseLeftButtonDown="ToggleMultiplayer">
                                <TextBlock x:Name="MultiplayerText" Text="ALLOWED" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource BrushTextPrimary}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Screen Time -->
                <Border CornerRadius="12" Background="{StaticResource BrushBackgroundLight}" Padding="16" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Screen Time Limits" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock Text="Set daily usage limits for the console" FontSize="11"
                                       Foreground="{StaticResource BrushTextSecondary}" />
                        </StackPanel>
                        <Border Grid.Column="1" CornerRadius="6"
                                Background="{StaticResource BrushAccentPrimary}" Padding="16,6"
                                Cursor="Hand" MouseLeftButtonDown="SetScreenTime">
                            <TextBlock Text="SET LIMITS" FontSize="12" FontWeight="Bold" Foreground="#0D0D14" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Activity Report -->
                <Border CornerRadius="12" Background="{StaticResource BrushBackgroundLight}" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Activity Report" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock Text="Weekly email summary of console usage" FontSize="11"
                                       Foreground="{StaticResource BrushTextSecondary}" />
                        </StackPanel>
                        <Border Grid.Column="1" CornerRadius="6"
                                Background="{StaticResource BrushBackgroundCard}" Padding="16,6"
                                Cursor="Hand" MouseLeftButtonDown="ToggleActivityReport">
                            <TextBlock x:Name="ActivityReportText" Text="OFF" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" />
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
