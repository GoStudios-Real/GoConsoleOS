<UserControl x:Class="GoConsoleOS.GoConsole.Views.DealsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="DEALS &amp; SALES" FontSize="28" FontWeight="Bold"
                   Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" x:Name="DealStatus" Text="Price-drop alerts for your wishlist"
                   FontSize="14" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,20" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16">
            <Border CornerRadius="8" Background="{StaticResource BrushBackgroundCard}" Padding="14,8" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💰" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="WishlistCount" Text="0 wishlisted" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}" />
                </StackPanel>
            </Border>
            <Border CornerRadius="8" Background="{StaticResource BrushBackgroundCard}" Padding="14,8" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📉" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="DealCount" Text="0 deals active" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource BrushSuccess}" />
                </StackPanel>
            </Border>
            <Border x:Name="AlertToggle" CornerRadius="8" Background="{StaticResource BrushAccentPrimary}"
                    Padding="14,8" Cursor="Hand" MouseLeftButtonDown="ToggleAlerts">
                <TextBlock x:Name="AlertText" Text="🔔 ALERTS: ON" FontSize="13" FontWeight="Bold"
                           Foreground="#0D0D14" />
            </Border>
        </StackPanel>

        <Border Grid.Row="3" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}" Padding="20">
            <StackPanel>
                <TextBlock Text="PRICE DROPS" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10" />
                <ScrollViewer Style="{StaticResource InvisibleScrollViewer}" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="DealList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Background="{StaticResource BrushBackgroundCard}"
                                        Padding="14" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold"
                                                       Foreground="{StaticResource BrushTextPrimary}" />
                                            <TextBlock Text="{Binding Platform}" FontSize="11"
                                                       Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding OldPrice}" FontSize="12"
                                                       Foreground="{StaticResource BrushTextMuted}"
                                                       TextDecorations="Strikethrough" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding NewPrice}" FontSize="15" FontWeight="Bold"
                                                       Foreground="{StaticResource BrushSuccess}"
                                                       HorizontalAlignment="Right" />
                                        </StackPanel>
                                        <Border Grid.Column="2" CornerRadius="8" Padding="10,6"
                                                Background="{StaticResource BrushBackgroundLight}"
                                                VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Discount}" FontSize="12" FontWeight="Bold"
                                                       Foreground="{StaticResource BrushSuccess}" />
                                        </Border>
                                        <Border Grid.Column="3" CornerRadius="8" Padding="12,6"
                                                Background="{StaticResource BrushAccentPrimary}"
                                                VerticalAlignment="Center" Cursor="Hand"
                                                MouseLeftButtonDown="VisitDeal" Tag="{Binding StoreUrl}">
                                            <TextBlock Text="VIEW" FontSize="12" FontWeight="Bold"
                                                       Foreground="#0D0D14" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
