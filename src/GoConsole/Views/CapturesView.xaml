<UserControl x:Class="GoConsoleOS.GoConsole.Views.CapturesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="CAPTURES &amp; SCREENSHOTS" FontSize="28" FontWeight="Bold"
                   Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,8" />

        <TextBlock Grid.Row="1" x:Name="CapturesDetail" Text=""
                   FontSize="14" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,16" />

        <ScrollViewer Grid.Row="2" Style="{StaticResource InvisibleScrollViewer}">
            <ItemsControl x:Name="CapturesGrid">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="280" Height="180" Margin="8" Cursor="Hand"
                                CornerRadius="12" Background="{StaticResource BrushBackgroundLight}"
                                MouseLeftButtonDown="Capture_Click">
                            <Grid>
                                <Border CornerRadius="12" ClipToBounds="True">
                                    <Image Source="{Binding ThumbPath}" Stretch="UniformToFill" />
                                </Border>
                                <Border VerticalAlignment="Bottom" Background="#AA000000"
                                        Padding="8,4" CornerRadius="0,0,12,0">
                                    <TextBlock Text="{Binding Name}" FontSize="11"
                                               Foreground="{StaticResource BrushTextSecondary}" />
                                </Border>
                                <Border x:Name="DeleteOverlay" Background="#AAFF5252"
                                        CornerRadius="0,12,0,12" Width="28" Height="28"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Cursor="Hand" MouseLeftButtonDown="DeleteCapture_Click">
                                    <TextBlock Text="✕" FontSize="12" FontWeight="Bold"
                                               Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Full-screen Zoom Overlay -->
        <Border x:Name="ZoomOverlay" Grid.RowSpan="3"
                Background="#EE000000" Visibility="Collapsed"
                MouseLeftButtonDown="ZoomOverlay_Click">
            <Grid>
                <Image x:Name="ZoomImage" MaxWidth="1600" MaxHeight="900"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Stretch="Uniform" />
                <TextBlock Text="Click anywhere to close" FontSize="14"
                           Foreground="{StaticResource BrushTextMuted}"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom"
                           Margin="0,0,0,40" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
