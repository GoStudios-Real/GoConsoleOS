<UserControl x:Class="GoConsoleOS.GoConsole.Views.UsbDeviceHealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="USB DEVICE HEALTH" FontSize="28" FontWeight="Bold"
                   Foreground="{StaticResource BrushTextPrimary}" />
        <Grid Grid.Row="1" Margin="0,4,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="S.M.A.R.T. diagnostics and storage status for connected USB devices"
                       FontSize="14" Foreground="{StaticResource BrushTextSecondary}" />
            <Border Grid.Column="1" CornerRadius="8" Background="{StaticResource BrushBackgroundLight}"
                    Padding="14,8" Cursor="Hand" MouseLeftButtonDown="RefreshHealth_Click">
                <TextBlock Text="⟳ REFRESH" FontSize="12" FontWeight="Bold"
                           Foreground="{StaticResource BrushAccentPrimary}" />
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Device list -->
            <Border Grid.Column="0" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}"
                    Padding="20" Margin="0,0,12,0" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="DEVICES" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10" />
                    <ScrollViewer Style="{StaticResource InvisibleScrollViewer}" MaxHeight="420"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="DeviceList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Background="{StaticResource BrushBackgroundCard}"
                                            Padding="12" Margin="0,0,0,8" Cursor="Hand"
                                            MouseLeftButtonDown="SelectDevice" Tag="{Binding}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold"
                                                       Foreground="{StaticResource BrushTextPrimary}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" FontSize="11"
                                                       Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" />
                                            <Border CornerRadius="4" Background="{StaticResource BrushBackgroundCardHover}"
                                                    Padding="6,2" HorizontalAlignment="Left" Margin="0,6,0,0">
                                                <TextBlock Text="{Binding HealthLabel}" FontSize="10" FontWeight="Bold"
                                                           Foreground="{Binding HealthBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="DeviceStatus" Text="No USB devices detected" FontSize="12"
                               Foreground="{StaticResource BrushTextMuted}" Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Selected device details -->
            <Border Grid.Column="1" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}"
                    Padding="24" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock x:Name="DetailName" Text="Select a device" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}" />
                    <TextBlock x:Name="DetailSubtitle" Text="" FontSize="12"
                               Foreground="{StaticResource BrushTextMuted}" Margin="0,4,0,16" />

                    <!-- Overall health -->
                    <Border x:Name="OverallCard" CornerRadius="10" Background="{StaticResource BrushBackgroundCard}"
                            Padding="16" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="OverallScore" Text="—" FontSize="34" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextMuted}" Width="90" />
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="OverallLabel" Text="No data" FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource BrushTextPrimary}" />
                                <TextBlock x:Name="OverallDesc" Text="Connect a USB storage device to see diagnostics."
                                           FontSize="12" Foreground="{StaticResource BrushTextMuted}" Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ItemsControl x:Name="StatList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Background="{StaticResource BrushBackgroundCard}"
                                        Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" FontSize="13"
                                                   Foreground="{StaticResource BrushTextSecondary}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13"
                                                   Foreground="{StaticResource BrushTextPrimary}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
