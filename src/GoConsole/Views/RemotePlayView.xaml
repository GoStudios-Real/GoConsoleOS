<UserControl x:Class="GoConsoleOS.GoConsole.Views.RemotePlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="REMOTE PLAY" FontSize="28" FontWeight="Bold"
                   Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" x:Name="RemoteStatus" Text="Stream your games to other devices"
                   FontSize="14" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,20" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}"
                    Padding="20" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="DEVICES" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10" />
                    <ScrollViewer Style="{StaticResource InvisibleScrollViewer}" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="DeviceList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Background="{StaticResource BrushBackgroundCard}"
                                            Padding="14" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="26"
                                                       Margin="0,0,12,0" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold"
                                                           Foreground="{StaticResource BrushTextPrimary}" />
                                                <TextBlock Text="{Binding Detail}" FontSize="11"
                                                           Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="2" x:Name="DeviceActionBtn" Content="{Binding ButtonText}"
                                                    FontSize="12" FontWeight="Bold"
                                                    Background="{StaticResource BrushAccentPrimary}"
                                                    Foreground="#0D0D14" BorderThickness="0" Padding="14,8"
                                                    Cursor="Hand" Click="ToggleStream" Tag="{Binding Name}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}" Padding="20">
                <StackPanel>
                    <TextBlock Text="STREAM QUALITY" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,16" />

                    <TextBlock Text="Resolution" FontSize="12" Foreground="{StaticResource BrushTextMuted}" />
                    <ComboBox x:Name="ResolutionBox" Margin="0,4,0,14" SelectedIndex="1"
                              Background="{StaticResource BrushBackgroundCard}"
                              Foreground="{StaticResource BrushTextPrimary}" BorderThickness="0">
                        <ComboBoxItem Content="720p" />
                        <ComboBoxItem Content="1080p" />
                        <ComboBoxItem Content="4K" />
                    </ComboBox>

                    <TextBlock Text="Frame Rate" FontSize="12" Foreground="{StaticResource BrushTextMuted}" />
                    <ComboBox x:Name="FrameBox" Margin="0,4,0,14" SelectedIndex="1"
                              Background="{StaticResource BrushBackgroundCard}"
                              Foreground="{StaticResource BrushTextPrimary}" BorderThickness="0">
                        <ComboBoxItem Content="30 FPS" />
                        <ComboBoxItem Content="60 FPS" />
                        <ComboBoxItem Content="120 FPS" />
                    </ComboBox>

                    <TextBlock Text="Bitrate" FontSize="12" Foreground="{StaticResource BrushTextMuted}" />
                    <ComboBox x:Name="BitrateBox" Margin="0,4,0,14" SelectedIndex="1"
                              Background="{StaticResource BrushBackgroundCard}"
                              Foreground="{StaticResource BrushTextPrimary}" BorderThickness="0">
                        <ComboBoxItem Content="10 Mbps" />
                        <ComboBoxItem Content="20 Mbps" />
                        <ComboBoxItem Content="50 Mbps" />
                    </ComboBox>

                    <Border x:Name="StreamingBadge" CornerRadius="8" Background="{StaticResource BrushBackgroundCard}"
                            Padding="12" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="● LIVE" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource BrushError}" />
                            <TextBlock x:Name="StreamingDetail" Text="" FontSize="11"
                                       Foreground="{StaticResource BrushTextMuted}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="StopAllBtn" Content="STOP ALL STREAMS" FontSize="14" FontWeight="Bold"
                            Background="{StaticResource BrushError}" Foreground="#0D0D14"
                            BorderThickness="0" Padding="16,10" Margin="0,16,0,0" Cursor="Hand"
                            Click="StopAll" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
