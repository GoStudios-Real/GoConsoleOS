<UserControl x:Class="GoConsoleOS.GoConsole.Views.WhatsNewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="WHAT'S NEW" FontSize="28" FontWeight="Bold"
                   Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4" />
        <TextBlock Grid.Row="0" Text="Latest GoConsoleOS features" FontSize="14"
                   Foreground="{StaticResource BrushTextSecondary}" Margin="0,34,0,16" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="FeatureList" />
        </ScrollViewer>
    </Grid>
</UserControl>
