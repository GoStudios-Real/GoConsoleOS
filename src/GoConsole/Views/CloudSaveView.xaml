<UserControl x:Class="GoConsoleOS.GoConsole.Views.CloudSaveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="CLOUD SAVES" FontSize="28" FontWeight="Bold"
                   Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" x:Name="CloudStatus" Text="Your game saves are synced to the cloud"
                   FontSize="14" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,20" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}"
                    Padding="20" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="SYNC STORAGE" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,16" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="☁" FontSize="30" Foreground="{StaticResource BrushAccentPrimary}"
                                   Margin="0,0,12,0" />
                        <StackPanel>
                            <TextBlock x:Name="StorageUsedText" Text="0 MB" FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock Text="of 10 GB used" FontSize="12" Foreground="{StaticResource BrushTextMuted}" />
                        </StackPanel>
                    </StackPanel>
                    <ProgressBar x:Name="StorageBar" Height="6" Maximum="10240" Value="0"
                                 Foreground="{StaticResource BrushAccentPrimary}"
                                 Background="{StaticResource BrushBackgroundCard}" BorderThickness="0"
                                 Margin="0,8,0,20" />

                    <Border x:Name="LastSyncCard" CornerRadius="8" Background="{StaticResource BrushBackgroundCard}"
                            Padding="12" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="LAST SYNC" FontSize="10" Foreground="{StaticResource BrushTextMuted}" />
                            <TextBlock x:Name="LastSyncText" Text="Never" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="SyncAllBtn" Content="SYNC ALL SAVES" FontSize="14" FontWeight="Bold"
                            Background="{StaticResource BrushAccentPrimary}" Foreground="#0D0D14"
                            BorderThickness="0" Padding="16,10" Cursor="Hand" Click="SyncAll" />
                    <ProgressBar x:Name="SyncProgress" Height="4" Margin="0,12,0,0" Maximum="100" Value="0"
                                 Foreground="{StaticResource BrushAccentPrimary}"
                                 Background="{StaticResource BrushBackgroundCard}" BorderThickness="0"
                                 Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}" Padding="20">
                <StackPanel>
                    <TextBlock Text="GAMES" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,10" />
                    <ScrollViewer Style="{StaticResource InvisibleScrollViewer}" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="SaveList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Background="{StaticResource BrushBackgroundCard}"
                                            Padding="14" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold"
                                                           Foreground="{StaticResource BrushTextPrimary}" />
                                                <TextBlock Text="{Binding Detail}" FontSize="11"
                                                           Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,16,0"
                                                        VerticalAlignment="Center" Orientation="Horizontal">
                                                <TextBlock Text="●" FontSize="12" VerticalAlignment="Center"
                                                           Foreground="{Binding StatusBrush}" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="Bold"
                                                           Foreground="{Binding StatusBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="SYNC" FontSize="12" FontWeight="Bold"
                                                    Background="{StaticResource BrushBackgroundLight}"
                                                    Foreground="{StaticResource BrushTextSecondary}"
                                                    BorderThickness="0" Padding="14,8" Cursor="Hand"
                                                    Click="SyncGame" Tag="{Binding Id}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
