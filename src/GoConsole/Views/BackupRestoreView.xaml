<UserControl x:Class="GoConsoleOS.GoConsole.Views.BackupRestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="BACKUP &amp; RESTORE" FontSize="28" FontWeight="Bold"
                   Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" x:Name="BackupStatus" Text="Export your profiles, saves, and settings"
                   FontSize="14" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,20" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}"
                    Padding="20" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="CREATE BACKUP" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,12" />
                    <TextBlock Text="Back up your console data to a safe location. Includes profiles, game saves, screenshots, wishlist, and settings."
                               FontSize="13" Foreground="{StaticResource BrushTextMuted}"
                               TextWrapping="Wrap" Margin="0,0,0,16" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border CornerRadius="8" Background="{StaticResource BrushBackgroundCard}" Padding="14,8" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="BackupSizeText" Text="Calculating size..." FontSize="13"
                                           Foreground="{StaticResource BrushTextPrimary}" />
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="8" Background="{StaticResource BrushBackgroundCard}" Padding="14,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🕑" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="LastBackupText" Text="Never backed up" FontSize="13"
                                           Foreground="{StaticResource BrushTextPrimary}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Button x:Name="BackupBtn" Content="CREATE BACKUP" FontSize="14" FontWeight="Bold"
                            Background="{StaticResource BrushAccentPrimary}" Foreground="#0D0D14"
                            BorderThickness="0" Padding="20,10" HorizontalAlignment="Left"
                            Cursor="Hand" Click="CreateBackup" />
                    <ProgressBar x:Name="BackupProgress" Height="4" Margin="0,12,0,0" Maximum="100" Value="0"
                                 Foreground="{StaticResource BrushAccentPrimary}"
                                 Background="{StaticResource BrushBackgroundCard}" BorderThickness="0"
                                 Visibility="Collapsed" />
                    <TextBlock x:Name="BackupLog" FontSize="11" Foreground="{StaticResource BrushTextMuted}"
                               TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="RESTORE" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,12" />
                    <TextBlock Text="Restore a previous backup to recover your console data."
                               FontSize="13" Foreground="{StaticResource BrushTextMuted}"
                               TextWrapping="Wrap" Margin="0,0,0,16" />

                    <ScrollViewer Style="{StaticResource InvisibleScrollViewer}" MaxHeight="280"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="BackupList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Background="{StaticResource BrushBackgroundCard}"
                                            Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold"
                                                           Foreground="{StaticResource BrushTextPrimary}" />
                                                <TextBlock Text="{Binding Detail}" FontSize="11"
                                                           Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="RESTORE" FontSize="12" FontWeight="Bold"
                                                    Background="{StaticResource BrushBackgroundLight}"
                                                    Foreground="{StaticResource BrushTextSecondary}"
                                                    BorderThickness="0" Padding="12,6" Cursor="Hand"
                                                    Click="RestoreBackup" Tag="{Binding Path}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" CornerRadius="12" Background="{StaticResource BrushBackgroundLight}"
                Padding="20" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="GAME SAVES" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource BrushAccentPrimary}" Margin="0,0,0,4" />
                <TextBlock Text="Snapshot and restore save data for games and apps installed from the GoStudios Corporation Store."
                           FontSize="13" Foreground="{StaticResource BrushTextMuted}"
                           TextWrapping="Wrap" Margin="0,0,0,12" />
                <ItemsControl x:Name="SaveList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="10" Background="{StaticResource BrushBackgroundCard}"
                                    Padding="12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold"
                                                   Foreground="{StaticResource BrushTextPrimary}" />
                                        <TextBlock Text="{Binding Detail}" FontSize="11"
                                                   Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="BACK UP" FontSize="12" FontWeight="Bold"
                                                Background="{StaticResource BrushBackgroundLight}"
                                                Foreground="{StaticResource BrushTextSecondary}"
                                                BorderThickness="0" Padding="12,6" Cursor="Hand"
                                                Margin="0,0,8,0" Click="BackupSaves_Click"
                                                Tag="{Binding Id}" IsEnabled="{Binding HasSaveFolders}" />
                                        <Button Content="RESTORE" FontSize="12" FontWeight="Bold"
                                                Background="{StaticResource BrushBackgroundLight}"
                                                Foreground="{StaticResource BrushTextSecondary}"
                                                BorderThickness="0" Padding="12,6" Cursor="Hand"
                                                Click="RestoreSaves_Click" Tag="{Binding Id}"
                                                IsEnabled="{Binding HasBackup}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
