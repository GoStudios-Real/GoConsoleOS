<Window x:Class="GoConsoleOS.GoConsole.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GoConsoleOS.GoConsole.Views"
        Title="GoConsoleOS"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="{StaticResource BrushBackgroundDark}"
        FontFamily="{StaticResource DisplayFont}"
        AllowsTransparency="False"
        Topmost="True"
        KeyDown="Window_KeyDown"
        StateChanged="Window_StateChanged"
        StylusDown="Window_StylusDown"
        StylusMove="Window_StylusMove"
        StylusUp="Window_StylusUp"
        TouchDown="Window_TouchDown"
        TouchMove="Window_TouchMove"
        TouchUp="Window_TouchUp"
        TouchEnter="Window_TouchEnter">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="48" />
        </Grid.RowDefinitions>

        <Image x:Name="WallpaperImage" Grid.RowSpan="3"
               Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />

        <!-- Top Navigation Bar -->
        <Border Grid.Row="0" Background="{StaticResource BrushBackgroundMedium}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Logo / OS Name -->
                <TextBlock x:Name="OsLogoText" Grid.Column="0" Text="GoConsoleOS"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource BrushAccentPrimary}"
                           VerticalAlignment="Center" />

                <!-- Navigation Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="NavHome" Content="HOME" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="home" IsEnabled="False" />
                    <Button x:Name="NavLibrary" Content="LIBRARY" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="library" />
                    <Button x:Name="NavStore" Content="STORE" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="store" />
                    <Button x:Name="NavFriends" Content="SOCIAL" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="friends" />
                    <Button x:Name="NavGuides" Content="GUIDES" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="guides" />
                    <Button x:Name="NavSettings" Content="SETTINGS" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="settings" />
                    <Button x:Name="NavGoAi" Content="GOAI" Style="{StaticResource NavButtonStyle}" Click="GoAiButton_Click" Tag="goai" />
                </StackPanel>

                <!-- Global Search -->
                <Border Grid.Column="2" CornerRadius="16" Background="{StaticResource BrushBackgroundCard}"
                        Padding="10,4" Width="200" Cursor="IBeam" Margin="0,0,24,0"
                        MouseLeftButtonDown="OpenSearchKeyboard" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource BrushTextMuted}" />
                        <TextBlock x:Name="SearchPlaceholder" Text="Search games, apps, settings..."
                                   FontSize="12" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" />
                        <TextBlock x:Name="SearchQueryText" Text="" FontSize="12"
                                   Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- Profile / Browser / Keyboard / Clock / Close -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ProfileNameText" Text="Guest" Style="{StaticResource StatusBarTextStyle}" Margin="0,0,24,0"
                               Cursor="Hand" MouseLeftButtonDown="ShowAccountMenu" />
                    <Border CornerRadius="4" Padding="6,2" Background="{StaticResource BrushBackgroundCard}"
                            Cursor="Hand" MouseLeftButtonDown="OpenBrowser" Margin="0,0,16,0">
                        <TextBlock Text="🌐" FontSize="14" VerticalAlignment="Center" />
                    </Border>
                    <Border CornerRadius="4" Padding="6,2" Background="{StaticResource BrushBackgroundCard}"
                            Cursor="Hand" MouseLeftButtonDown="OpenKeyboard" Margin="0,0,16,0">
                        <TextBlock Text="⌨" FontSize="14" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="ClockText" Text="" Style="{StaticResource StatusBarTextStyle}" FontSize="16" FontWeight="Bold" Margin="0,0,16,0" />
                    <Border Width="32" Height="32" CornerRadius="8" Background="Transparent"
                            Cursor="Hand" MouseLeftButtonDown="CloseButton_Click">
                        <TextBlock Text="✕" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Area -->
        <ContentControl x:Name="MainContent" Grid.Row="1">
            <ContentControl.RenderTransform>
                <TranslateTransform />
            </ContentControl.RenderTransform>
        </ContentControl>

        <!-- Bottom Status Bar (SteamOS-style) -->
        <Border Grid.Row="2" Background="{StaticResource BrushBackgroundMedium}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Profile avatar + name -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <Ellipse Width="20" Height="20" Fill="{StaticResource BrushAccentSecondary}"
                             Margin="0,0,8,0" />
                    <TextBlock x:Name="StatusProfileName" Text="Guest" Style="{StaticResource StatusBarTextStyle}"
                               Cursor="Hand" MouseLeftButtonDown="ShowAccountMenu" />
                </StackPanel>

                <!-- Network indicator -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock x:Name="StatusNetworkIcon" Text="●" FontSize="10"
                               Foreground="{StaticResource BrushSuccess}" VerticalAlignment="Center"
                               Margin="0,0,4,0" />
                    <TextBlock x:Name="StatusNetwork" Text="Online" Style="{StaticResource StatusBarTextStyle}" />
                </StackPanel>

                <!-- Volume indicator -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusVolumeIcon" Text="🔊" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBlock x:Name="StatusVolume" Text="75%" Style="{StaticResource StatusBarTextStyle}" />
                </StackPanel>

                <!-- Performance mode -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border Background="{StaticResource BrushBackgroundCard}" CornerRadius="4" Padding="8,2">
                        <TextBlock x:Name="StatusMode" Text="BALANCED" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource BrushAccentPrimary}" />
                    </Border>
                </StackPanel>

                <!-- Battery indicator -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="BatteryIcon" Text="🔋" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBlock x:Name="BatteryText" Text="" Style="{StaticResource StatusBarTextStyle}" />
                </StackPanel>

                <!-- Controller battery -->
                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="ControllerBatteryIcon" Text="🎮" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBlock x:Name="ControllerBatteryText" Text="" Style="{StaticResource StatusBarTextStyle}" />
                </StackPanel>

                <!-- FPS counter -->
                <TextBlock Grid.Column="6" x:Name="StatusFps" Text=""
                           Style="{StaticResource StatusBarTextStyle}" Margin="0,0,16,0" />

                <!-- Captures indicator -->
                <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0"
                            Cursor="Hand" MouseLeftButtonDown="CapturesIndicator_Click">
                    <TextBlock Text="📷" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBlock x:Name="StatusCaptures" Text="0" Style="{StaticResource StatusBarTextStyle}" />
                </StackPanel>

                <!-- Notification bell -->
                <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0"
                            Cursor="Hand" MouseLeftButtonDown="NotifBell_Click">
                    <TextBlock x:Name="NotifBellIcon" Text="🔔" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBlock x:Name="NotifBadge" Text="" Style="{StaticResource StatusBarTextStyle}" />
                </StackPanel>

                <!-- Clock -->
                <TextBlock Grid.Column="9" x:Name="StatusClock" Text=""
                           Style="{StaticResource StatusBarTextStyle}" FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource BrushTextPrimary}" />
            </Grid>
        </Border>

        <!-- Notification Toast -->
        <Border x:Name="NotificationOverlay" Grid.RowSpan="3"
                VerticalAlignment="Top" HorizontalAlignment="Center"
                Background="#CC1A1A2E" CornerRadius="12" Padding="20,12"
                Margin="0,80,0,0" Visibility="Collapsed"
                IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform />
            </Border.RenderTransform>
            <TextBlock x:Name="NotificationText" Text=""
                       FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource BrushTextPrimary}" />
        </Border>

        <!-- Achievement Toast -->
        <Border x:Name="AchievementToast" Grid.RowSpan="3"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="#E6B8860B" CornerRadius="14" Padding="24,16"
                Visibility="Collapsed" IsHitTestVisible="False"
                BorderBrush="{StaticResource BrushWarning}" BorderThickness="2">
            <Border.RenderTransform>
                <TranslateTransform Y="-80" />
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="AchievementIcon" Text="🏆" FontSize="36"
                           VerticalAlignment="Center" Margin="0,0,16,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="AchievementTitle" Text="ACHIEVEMENT UNLOCKED"
                               FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource BrushWarning}" />
                    <TextBlock x:Name="AchievementName" Text="" FontSize="22" FontWeight="Bold"
                               Foreground="White" />
                    <TextBlock x:Name="AchievementReward" Text="" FontSize="12"
                               Foreground="#FFE0B2" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Notification History Panel -->
        <Border x:Name="NotificationHistoryPanel" Grid.RowSpan="3"
                Width="360" HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="{StaticResource BrushBackgroundLight}"
                CornerRadius="0,0,0,16" Padding="16"
                Margin="0,64,0,0" Visibility="Collapsed"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="NOTIFICATIONS"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource BrushAccentPrimary}" />
                    <TextBlock Grid.Column="1" x:Name="ClearNotifBtn" Text="CLEAR ALL"
                               FontSize="12" FontWeight="Bold" Cursor="Hand"
                               Foreground="{StaticResource BrushTextMuted}"
                               MouseLeftButtonDown="ClearNotifications_Click" />
                </Grid>
                <ItemsControl x:Name="NotificationHistoryList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="6" Background="{StaticResource BrushBackgroundCard}"
                                    Padding="10,8" Margin="0,3">
                                <TextBlock Text="{Binding}" FontSize="12"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           TextWrapping="Wrap" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Search Results Overlay -->
        <Border x:Name="SearchResultsOverlay" Grid.RowSpan="3"
                Background="#AA000000" Visibility="Collapsed"
                MouseLeftButtonDown="CloseSearchResults">
            <Border CornerRadius="12" Background="{StaticResource BrushBackgroundLight}"
                    Padding="16" Width="500" MaxHeight="400"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,80,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="SearchResultTitle" Text="Search Results"
                                   FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushAccentPrimary}" />
                        <TextBlock Grid.Column="1" x:Name="SearchResultCount" Text="0 results"
                                   FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" />
                    </Grid>
                    <ScrollViewer MaxHeight="300" Style="{StaticResource InvisibleScrollViewer}">
                        <ItemsControl x:Name="SearchResultsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Background="{StaticResource BrushBackgroundCard}"
                                            Padding="10,8" Margin="0,0,0,4" Cursor="Hand"
                                            MouseLeftButtonDown="SearchResultClicked" Tag="{Binding Id}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="16"
                                                       Margin="0,0,10,0" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold"
                                                           Foreground="{StaticResource BrushTextPrimary}" />
                                                <TextBlock Text="{Binding Description}" FontSize="10"
                                                           Foreground="{StaticResource BrushTextSecondary}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Type}" FontSize="10"
                                                       Foreground="{StaticResource BrushTextMuted}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="Press Ctrl+K to open on-screen keyboard"
                               FontSize="10" Foreground="{StaticResource BrushTextMuted}"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Border>

        <!-- Night Mode Overlay -->
        <Border x:Name="NightModeOverlay" Grid.RowSpan="3"
                Background="#CCFFAA00" Visibility="Collapsed"
                IsHitTestVisible="False" Opacity="0.35" />

        <!-- Scanning Overlay -->
        <Border x:Name="ScanningOverlay" Grid.RowSpan="3"
                Background="#CC000000" Visibility="Collapsed">
            <Grid>
                <Border CornerRadius="16" Background="{StaticResource BrushBackgroundLight}"
                        Padding="32" Width="400" Height="160"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock x:Name="ScanningTitle" Text="SCANNING GAME LIBRARIES"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource BrushAccentPrimary}"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="ScanningDetail" Text="Looking for installed games..."
                                   FontSize="14" Foreground="{StaticResource BrushTextSecondary}"
                                   HorizontalAlignment="Center" Margin="0,8,0,12" />
                        <Border CornerRadius="6" Background="{StaticResource BrushBackgroundCard}" Height="8">
                            <Border x:Name="ScanningBar" CornerRadius="6"
                                    Background="{StaticResource BrushAccentPrimary}"
                                     Width="0" HorizontalAlignment="Left" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
