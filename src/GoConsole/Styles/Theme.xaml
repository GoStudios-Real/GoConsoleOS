<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:cc="clr-namespace:GoConsoleOS.GoConsole.Controls">

    <!-- Color Palette - SteamOS inspired dark + neon accents -->
    <Color x:Key="BackgroundDark">#0D0D14</Color>
    <Color x:Key="BackgroundMedium">#14141F</Color>
    <Color x:Key="BackgroundLight">#1A1A2E</Color>
    <Color x:Key="BackgroundCard">#1E1E32</Color>
    <Color x:Key="BackgroundCardHover">#282844</Color>
    <Color x:Key="AccentPrimary">#00C9DB</Color>
    <Color x:Key="AccentSecondary">#7B2DFF</Color>
    <Color x:Key="AccentTertiary">#FF4D8C</Color>
    <Color x:Key="TextPrimary">#F0F0FF</Color>
    <Color x:Key="TextSecondary">#8888AA</Color>
    <Color x:Key="TextMuted">#555577</Color>
    <Color x:Key="BorderColor">#2A2A44</Color>
    <Color x:Key="FocusGlow">#00C9DB</Color>
    <Color x:Key="SuccessColor">#00E676</Color>
    <Color x:Key="WarningColor">#FFD600</Color>
    <Color x:Key="ErrorColor">#FF5252</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BrushBackgroundDark" Color="{StaticResource BackgroundDark}" />
    <SolidColorBrush x:Key="BrushBackgroundMedium" Color="{StaticResource BackgroundMedium}" />
    <SolidColorBrush x:Key="BrushBackgroundLight" Color="{StaticResource BackgroundLight}" />
    <SolidColorBrush x:Key="BrushBackgroundCard" Color="{StaticResource BackgroundCard}" />
    <SolidColorBrush x:Key="BrushBackgroundCardHover" Color="{StaticResource BackgroundCardHover}" />
    <SolidColorBrush x:Key="BrushAccentPrimary" Color="{StaticResource AccentPrimary}" />
    <SolidColorBrush x:Key="BrushAccentSecondary" Color="{StaticResource AccentSecondary}" />
    <SolidColorBrush x:Key="BrushAccentTertiary" Color="{StaticResource AccentTertiary}" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource TextMuted}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BrushFocusGlow" Color="{StaticResource FocusGlow}" />
    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="BrushError" Color="{StaticResource ErrorColor}" />

    <!-- Gradient + glow brushes -->
    <LinearGradientBrush x:Key="BrushGradientAccent" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00C9DB" Offset="0" />
        <GradientStop Color="#7B2DFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrushGradientSurface" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1E1E32" Offset="0" />
        <GradientStop Color="#14141F" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="BrushGlowAccent" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5" GradientOrigin="0.5,0.5">
        <GradientStop Color="#3300C9DB" Offset="0" />
        <GradientStop Color="#0000C9DB" Offset="1" />
    </RadialGradientBrush>

    <!-- Font -->
    <FontFamily x:Key="DisplayFont">Segoe UI, Helvetica Neue, Arial, sans-serif</FontFamily>

    <!-- Styles -->
    <Style x:Key="NavButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="Underline" Height="3" CornerRadius="2,2,0,0" Width="20"
                                Background="{StaticResource BrushGradientAccent}"
                                VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="0.4" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Underline"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="Underline"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.04" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.04" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Underline"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter Property="Foreground" Value="{StaticResource BrushAccentPrimary}" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource BrushAccentPrimary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource BrushAccentPrimary}" />
                            <Setter TargetName="Underline" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GameTileStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushGradientSurface}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="Margin" Value="8" />
        <Setter Property="Width" Value="200" />
        <Setter Property="Height" Value="280" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform />
            </Setter.Value>
        </Setter>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="10" Opacity="0.35" ShadowDepth="6" Color="#000000" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <EventTrigger RoutedEvent="Mouse.MouseEnter">
                <BeginStoryboard>
                    <Storyboard>
<DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                         To="1.06" Duration="0:0:0.18" />
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                         To="1.06" Duration="0:0:0.18" />
                                    <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                         To="#00C9DB" Duration="0:0:0.18" />
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                         To="18" Duration="0:0:0.18" />
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.ShadowDepth)"
                                         To="10" Duration="0:0:0.18" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Mouse.MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                         To="1.0" Duration="0:0:0.18" />
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                         To="1.0" Duration="0:0:0.18" />
                                    <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                         To="#2A2A44" Duration="0:0:0.18" />
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                         To="10" Duration="0:0:0.18" />
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.ShadowDepth)"
                                         To="6" Duration="0:0:0.18" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="Margin" Value="20,16,0,8" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.5" Color="#00C9DB" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Glowing accent button -->
    <Style x:Key="AccentButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#0D0D14" />
        <Setter Property="Background" Value="{StaticResource BrushGradientAccent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform />
            </Setter.Value>
        </Setter>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.45" Color="#00C9DB" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="10" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.05" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.05" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                                         To="22" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                                         To="12" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StatusBarTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ScrollViewer style -->
    <Style x:Key="InvisibleScrollViewer" TargetType="ScrollViewer">
        <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="PanningMode" Value="Both" />
    </Style>

    <!-- On-screen scroll indicator viewer -->
    <Style TargetType="{x:Type cc:OnScreenScrollViewer}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type cc:OnScreenScrollViewer}">
                    <Grid>
                        <ScrollViewer x:Name="ContentScroller" PanningMode="Both"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Hidden">
                            <ContentPresenter />
                        </ScrollViewer>
                        <Border x:Name="ScrollIndicator" Width="6" CornerRadius="3"
                                Background="#66FFFFFF" HorizontalAlignment="Right"
                                Margin="0,0,6,0" VerticalAlignment="Top" Visibility="Collapsed"
                                IsHitTestVisible="False" Opacity="0" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Controller hint bar (gamepad icon + label) -->
    <Style TargetType="{x:Type cc:ControllerHintBar}">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <cc:ControllerButtonIcon Button="{Binding Button}" Label="{Binding Label}"
                                                 Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Text}" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{StaticResource BrushTextMuted}" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
