<Window x:Class="GoConsoleOS.GoConsole.BootScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GoConsoleOS"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Border x:Name="RootBorder" Background="#0D0D14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Glow -->
            <Ellipse Grid.Row="1" Width="420" Height="180" Margin="0,0,0,-40"
                     HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#3300C9DB" Offset="0" />
                        <GradientStop Color="#0000C9DB" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Brand screen phase 1 -->
            <StackPanel x:Name="BrandScreen" Grid.Row="1" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Visibility="Collapsed">
                <Border x:Name="BrandBadge" Width="160" Height="160" CornerRadius="40"
                        Background="#0066FF" Margin="0,0,0,24"
                        HorizontalAlignment="Center">
                    <TextBlock Text="G" FontSize="96" FontWeight="Bold"
                               Foreground="#0D0D14"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="BrandText" Text="GoStudios Corporation" FontSize="48" FontWeight="Bold"
                           Foreground="#0066FF" HorizontalAlignment="Center" />
                <TextBlock Text="Presents" FontSize="18" Foreground="#8888AA"
                           HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>

            <!-- Logo -->
            <StackPanel x:Name="LogoPanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border x:Name="LogoBadge" Width="96" Height="96" CornerRadius="24"
                        Background="#0066FF" Margin="0,0,0,20"
                        HorizontalAlignment="Center">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="LogoScale" ScaleX="0.6" ScaleY="0.6" />
                    </Border.RenderTransform>
                    <TextBlock Text="G" FontSize="56" FontWeight="Bold"
                               Foreground="#0D0D14"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="LogoText" Text="GoConsoleOS" FontSize="44" FontWeight="Bold"
                           Foreground="#0066FF" HorizontalAlignment="Center" />
                <TextBlock Text="Console Mode for Windows 11"
                           FontSize="16" Foreground="#8888AA"
                           HorizontalAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>

            <!-- Progress bar -->
            <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="360" Height="5" CornerRadius="2"
                        Background="#1A1A2E">
                    <Border x:Name="ProgressBar" Width="0" Height="5" CornerRadius="2"
                            Background="#0066FF" HorizontalAlignment="Left" />
                </Border>
                <TextBlock x:Name="StatusText" Text="Initializing..."
                           FontSize="13" Foreground="#555577"
                           HorizontalAlignment="Center" Margin="0,10,0,0" />
            </StackPanel>

            <!-- Version -->
            <TextBlock x:Name="VersionText" Text="v1.4.0"
                       FontSize="12" Foreground="#555577"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Margin="0,0,24,16" />
            <TextBlock x:Name="TrademarkText" Text="GoConsoleOS™ is a trademark of GoStudios Corporation. © 2026 GoStudios Corporation."
                       FontSize="11" Foreground="#444466"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom"
                       Margin="0,0,0,14" />
        </Grid>
    </Border>
</Window>
