<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="BackgroundDark">#0D0D14</Color>
    <Color x:Key="BackgroundMedium">#14141F</Color>
    <Color x:Key="BackgroundLight">#141A2E</Color>
    <Color x:Key="BackgroundCard">#182040</Color>
    <Color x:Key="BackgroundCardHover">#202850</Color>
    <Color x:Key="AccentPrimary">#0066FF</Color>
    <Color x:Key="AccentSecondary">#7B2DFF</Color>
    <Color x:Key="AccentTertiary">#FF4D8C</Color>
    <Color x:Key="TextPrimary">#F0F0FF</Color>
    <Color x:Key="TextSecondary">#8888AA</Color>
    <Color x:Key="TextMuted">#555577</Color>
    <Color x:Key="BorderColor">#1E2A55</Color>
    <Color x:Key="SuccessColor">#00E676</Color>
    <Color x:Key="WarningColor">#FFD600</Color>
    <Color x:Key="ErrorColor">#FF5252</Color>

    <SolidColorBrush x:Key="BrushBackgroundDark" Color="{StaticResource BackgroundDark}" />
    <SolidColorBrush x:Key="BrushBackgroundMedium" Color="{StaticResource BackgroundMedium}" />
    <SolidColorBrush x:Key="BrushBackgroundLight" Color="{StaticResource BackgroundLight}" />
    <SolidColorBrush x:Key="BrushBackgroundCard" Color="{StaticResource BackgroundCard}" />
    <SolidColorBrush x:Key="BrushBackgroundCardHover" Color="{StaticResource BackgroundCardHover}" />
    <SolidColorBrush x:Key="BrushAccentPrimary" Color="{StaticResource AccentPrimary}" />
    <SolidColorBrush x:Key="BrushAccentSecondary" Color="{StaticResource AccentSecondary}" />
    <SolidColorBrush x:Key="BrushAccentTertiary" Color="{StaticResource AccentTertiary}" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource TextMuted}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="BrushError" Color="{StaticResource ErrorColor}" />

    <FontFamily x:Key="DisplayFont">Segoe UI, Helvetica Neue, Arial, sans-serif</FontFamily>

    <Style x:Key="ProjectCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushBackgroundCard}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Margin" Value="12" />
        <Setter Property="Width" Value="320" />
        <Setter Property="Height" Value="400" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="12" Opacity="0.4" ShadowDepth="6" Color="#000000" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ActionButtonStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <ControlTemplate x:Key="ButtonTemplate" TargetType="Button">
        <Border Background="{TemplateBinding Background}"
                BorderThickness="0"
                Padding="{TemplateBinding Padding}"
                CornerRadius="8">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </ControlTemplate>

    <Style x:Key="StatusBarTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="InvisibleScrollViewer" TargetType="ScrollViewer">
        <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="PanningMode" Value="Both" />
    </Style>
</ResourceDictionary>
