<Window x:Class="GoStudiosLauncher.BrowserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GoBrowser"
        WindowStyle="None"
        WindowState="Maximized"
        Background="#0D0D14"
        Topmost="True"
        ResizeMode="NoResize"
        KeyDown="Window_KeyDown">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#14141F" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="6" Background="#1E1E32" Padding="12,6"
                        Cursor="Hand" MouseLeftButtonDown="GoBack">
                    <TextBlock Text="◀ BACK" FontSize="12" FontWeight="Bold" Foreground="#8888AA" />
                </Border>

                <Border Grid.Column="1" CornerRadius="6" Background="#1A1A2E" Padding="12,6" Margin="8,0">
                    <TextBox x:Name="UrlBar" Text="https://opencode.ai" FontSize="13"
                             Foreground="#F0F0FF" Background="Transparent" BorderThickness="0"
                             KeyDown="UrlBar_KeyDown" />
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Border CornerRadius="6" Background="#00C9DB" Padding="14,6" Cursor="Hand"
                            MouseLeftButtonDown="NavigateGo" Margin="0,0,8,0">
                        <TextBlock Text="GO" FontSize="12" FontWeight="Bold" Foreground="#0D0D14" />
                    </Border>
                    <Border Width="28" Height="28" CornerRadius="6" Background="Transparent"
                            Cursor="Hand" MouseLeftButtonDown="CloseBrowser">
                        <TextBlock Text="✕" FontSize="14" FontWeight="Bold"
                                   Foreground="#8888AA" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <WebBrowser Grid.Row="1" x:Name="BrowserControl" />
    </Grid>
</Window>
