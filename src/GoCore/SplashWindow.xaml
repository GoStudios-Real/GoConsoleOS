<Window x:Class="GoConsoleOS.GoCore.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GoConsoleOS"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Grid>
        <Border Background="#0D0D14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Logo Area -->
                <Viewbox Grid.Row="1" MaxWidth="300" MaxHeight="120" Margin="0,0,0,20">
                    <TextBlock Text="GoConsoleOS" FontSize="48" FontWeight="Bold"
                               Foreground="#00C9DB"
                               HorizontalAlignment="Center" />
                </Viewbox>

                <!-- Subtitle -->
                <TextBlock Grid.Row="2" Text="Console Mode for Windows 11"
                           FontSize="18" Foreground="#8888AA"
                           HorizontalAlignment="Center" Margin="0,0,0,40" />

                <!-- Loading bar -->
                <Border Grid.Row="3" Width="320" Height="4" CornerRadius="2"
                        Background="#1A1A2E" HorizontalAlignment="Center">
                    <Border x:Name="ProgressBar" Width="0" Height="4" CornerRadius="2"
                            Background="#00C9DB" HorizontalAlignment="Left" />
                </Border>

                <!-- Status text -->
                <TextBlock x:Name="StatusText" Grid.Row="4" Text="Initializing..."
                           FontSize="14" Foreground="#555577"
                           HorizontalAlignment="Center" VerticalAlignment="Top"
                           Margin="0,12,0,0" />

                <!-- Version -->
                <TextBlock x:Name="VersionText" Text="v1.4.0"
                           FontSize="12" Foreground="#555577"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Margin="0,0,24,16" />
            </Grid>
        </Border>
    </Grid>
</Window>
